// Mail-Ansicht dreispaltig (Prototyp #336). Daten folgen mit #345, #348, #352, #354.
// Aufbau nach quelltext/stamp/src/views/mail/stamp-mail-view.blp:4-193 (Briefing 1.1, 1.2).
using Gtk 4.0;
using Adw 1;

template $RevolutionMailView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #399: Strg+F öffnet die Suche in der Kopfleiste der Nachricht (HIG-SE „Ctrl+F“),
  // F9 schaltet die Seitenleiste wie GNOME Calendar (gcal-window.blp:181-188).
  // Scope local wie calendar-view.blp:14-72: wirkt nur auf der Mail-Seite. Aktionen in mail-view.c.
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(mail.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(mail.sidebar)";
    }

    // #400 Punkt 3/8: Kürzel der Menüeinträge (HIG Keyboard, Standardkürzel
    // Strg+N, Strg+P, Strg+Komma, Strg+?), im Menü rechts angezeigt (accel-Attribut).
    Shortcut {
      trigger: "<primary>n";
      action: "action(list.compose)";
    }

    Shortcut {
      trigger: "<primary>p";
      action: "action(message.print)";
    }

    Shortcut {
      trigger: "<primary>comma";
      action: "action(mail.preferences)";
    }

    Shortcut {
      trigger: "<primary>question";
      action: "action(mail.shortcuts)";
    }
  }

  // Briefing 1.2: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“ (stamp-mail-view.blp:8-26).
  // Es gilt nur der zuletzt passende Breakpoint, daher setzt „mobile“ show-sidebar erneut.
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      // #400 Punkt 6: Neu bleibt in der Kopfleiste der Nachricht (Arnd). Damit alle
      // Knöpfe bei 900 px neben die Liste passen: ohne Abstandhalter, Liste mind. 280.
      compose_spacer.visible: false;
      list_pane.width-request: 280;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      mail_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Es gilt nur der zuletzt passende Breakpoint (s. o.): Neu bleibt in der Liste.
      list_compose_button.visible: true;
      compose_button.visible: false;
      compose_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView mail_layout {
    // Seitenleiste: Ordnerbaum als GtkListView + GtkTreeListModel (CR #397),
    // Vorlage stamp-folder-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Umschalter Mail | Kalender | Kontakte oben in der Kopfleiste der Seitenleiste
        // (Arnd 22.10.2026, #340, Vorbild 22/24): Segment-Umschalter, Standard-libadwaita
        // (AdwInlineViewSwitcher = AdwToggleGroup am ViewStack, nur Symbole);
        // Seitentitel als Tooltip setzt libadwaita (geprüft headless).
        title-widget: Adw.InlineViewSwitcher {
          stack: bind template.stack;
          display-mode: icons;
        };

        // #399 Punkt 3: Primärmenü in der Seitenleisten-Kopfleiste wie Nautilus (Briefing N).
        // HIG Menus: „The button for primary menus should use the open-menu-symbolic icon“.
        // primary: F10 öffnet das Menü (GtkMenuButton:primary).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";

          // #401 Punkt 2: kompaktes Menü ohne Einzug (style.css .primary-menu).
          styles [
            "primary-menu",
          ]

          tooltip-text: _("Hauptmenü");
          menu-model: primary_menu;

          accessibility {
            label: _("Hauptmenü");
          }
        }
      }

      // #345: Konten aus der ESourceRegistry (mail-view.c). Ohne Konten Leerzustand
      // wie Stamp (stamp-window.blp:50-80, Seite „welcome“), hier in der Seitenleiste.
      content: Stack sidebar_stack {
        // Erste Seite „list“ ist sichtbar, bis die Registry geladen ist (leere Liste).
        StackPage {
          name: "list";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            // Viewport: sonst blendet GtkListView beim Start den ersten
            // Abschnittskopf („Favoriten“) aus, erst Hochscrollen zeigt ihn.
            // Ursache klären in #350, Virtualisierung geht verloren.
            child: Viewport {
              child: ListView folder_list {
                tab-behavior: item;

                styles [
                  "navigation-sidebar",
                ]

                accessibility {
                  label: _("Ordner");
                }

                // Modell (mail-view.c): je Konto ein GtkTreeListModel über seinen Ordnern,
                // zusammengefügt als Abschnitte (GtkFlattenListModel), #348.
                model: SingleSelection folder_selection {};

                // Konten als nicht auswählbare Abschnittsköpfe wie der abgenommene Prototyp
                // (Tag m2-prototyp, mail-view.blp:137-154, Design/Prototyp/mail-hell.png
                // „Privat“, „Arbeit“). Kopf = Konto des ersten Ordners im Abschnitt.
                header-factory: BuilderListItemFactory {
                  template ListHeader {
                    child: Label {
                      label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.account as <$RevolutionMailAccount>.display-name;
                      xalign: 0;
                      margin-start: 14;
                      margin-end: 14;
                      margin-top: 4;
                      margin-bottom: 2;
                      ellipsize: end;

                      styles [
                        "caption-heading",
                        "dimmed",
                      ]
                    };
                  }
                };

                // Ordnerzeile wie der Prototyp (mail-view.blp:156-193) ohne Ungelesen-Zähler
                // (#348: nicht im Umfang); Unterordner mit Ausklapp-Pfeil.
                factory: BuilderListItemFactory {
                  template ListItem {
                    // Zugänglicher Name der Zeile = Ordnername (Architektur 8).
                    accessible-label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.display-name;

                    child: TreeExpander {
                      list-row: bind template.item as <TreeListRow>;

                      child: Box {
                        spacing: 12;

                        Image {
                          icon-name: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.icon-name;
                          accessible-role: presentation;
                        }

                        Label {
                          label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.display-name;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }
                      };
                    };
                  }
                };
              };
            };
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "mail-unread-symbolic";
            title: _("Keine Konten");
            description: _("E-Mail-Konten aus den Online-Konten oder aus Evolution erscheinen hier.");

            styles [
              "compact",
            ]
          };
        }
      };
    }

    // Nachrichtenliste, Zeile nach stamp-conversation-row.blp:72-224.
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // #399 Punkt 4: Knopf immer sichtbar wie GNOME Calendar
        // (quelltext/gnome-calendar/src/gui/gcal-window.blp:176-189); F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Seitenleiste ein-/ausblenden");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Seitenleiste ein-/ausblenden");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste der Nachricht.
        [start]
        Button list_compose_button {
          visible: false;
          icon-name: "mail-message-new-symbolic";
          tooltip-text: _("Neue E-Mail");
          action-name: "list.compose";

          accessibility {
            label: _("Neue E-Mail");
          }
        }

        // #399 Punkt 7: Titel linksbündig wie Apple (Briefing V7). Adw.WindowTitle
        // zentriert, daher zwei Labels mit den Stilklassen aus HIG-TY.
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          Label {
            // Name des gewählten Ordners folgt mit #352.
            label: _("Mail");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          // Anzahl folgt mit #352.
          Label {
            visible: false;
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };

        [end]
        MenuButton {
          icon-name: "sort-order-symbolic";
          tooltip-text: _("Filter");
          menu-model: filter_menu;

          accessibility {
            label: _("Filter");
          }
        }
      }

      // #343/#345: Fehler als AdwBanner (CLAUDE.md Architektur-Festlegung 3) im Inhaltsbereich
      // unter der Kopfleiste, nicht über die volle Fensterbreite (HIG Banners: „strip along
      // the top of a view“); die Kopfleisten bleiben auf einer Linie (Dokument #5). Kurzer
      // Titel, Einzelheiten im Tooltip; beides setzt revolution_mail_view_show_error.
      // Ohne Markup, weil Fehlertexte <, & enthalten können.
      [top]
      Adw.Banner banner {
        use-markup: false;
      }

      // Ohne Ordner: Leerzustand wie Stamp (stamp-conversation-list.blp:252-259).
      // Liste füllt #352.
      content: Stack list_stack {
        // Erste Seite „empty“ ist sichtbar (Gtk.Stack zeigt das erste Kind).
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "inbox-symbolic";
            title: _("Keine Nachrichten");
          };
        }

        StackPage {
          name: "list";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            // #400 Punkt 4: Auswahl als abgerundete Akzentfläche mit Abstand zum Rand,
            // ohne Trennlinien (Vorbild 04/05, style.css).
            child: ListView message_list {
              tab-behavior: item;

              styles [
                "message-list",
              ]

              accessibility {
                label: _("Nachrichten");
              }

              model: SingleSelection message_selection {};

              factory: BuilderListItemFactory {
                template ListItem {
                  child: Box {
                    spacing: 6;

                    // Platz für den Ungelesen-Punkt bleibt auch ohne Punkt frei.
                    Box {
                      width-request: 10;
                      valign: start;
                      margin-top: 4;

                      Image {
                        icon-name: "media-record-symbolic";
                        pixel-size: 10;
                        visible: bind template.item as <$RevolutionSampleMessage>.unread;
                        tooltip-text: _("Ungelesen");

                        accessibility {
                          label: _("Ungelesen");
                        }

                        styles [
                          "accent",
                        ]
                      }
                    }

                    Adw.Avatar {
                      size: 40;
                      valign: start;
                      show-initials: true;
                      text: bind template.item as <$RevolutionSampleMessage>.sender;
                      margin-end: 6;
                    }

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      spacing: 2;

                      Box {
                        spacing: 6;

                        Label sender_unread {
                          label: bind template.item as <$RevolutionSampleMessage>.sender;
                          visible: bind template.item as <$RevolutionSampleMessage>.unread;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "heading",
                          ]
                        }

                        Label {
                          label: bind template.item as <$RevolutionSampleMessage>.sender;
                          visible: bind sender_unread.visible inverted;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        Label {
                          label: bind template.item as <$RevolutionSampleMessage>.date;

                          styles [
                            "caption",
                            "numeric",
                            "dimmed",
                          ]
                        }
                      }

                      Box {
                        spacing: 6;

                        Label {
                          label: bind template.item as <$RevolutionSampleMessage>.subject;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        // #401: Symbole dezent wie Apple Mail (Vorbild 17): 12px, grau (style.css).
                        Image {
                          icon-name: "mail-attachment-symbolic";
                          pixel-size: 12;
                          visible: bind template.item as <$RevolutionSampleMessage>.attachment;
                          tooltip-text: _("Mit Anhang");

                          accessibility {
                            label: _("Mit Anhang");
                          }

                          styles [
                            "dimmed",
                            "list-icon",
                          ]
                        }

                        Image {
                          icon-name: "starred-symbolic";
                          pixel-size: 12;
                          visible: bind template.item as <$RevolutionSampleMessage>.starred;
                          tooltip-text: _("Markiert");

                          accessibility {
                            label: _("Markiert");
                          }

                          styles [
                            "accent",
                            "list-icon",
                          ]
                        }
                      }

                      Label {
                        label: bind template.item as <$RevolutionSampleMessage>.preview;
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        lines: 2;
                        ellipsize: end;
                        width-chars: 10;

                        styles [
                          "dimmed",
                        ]
                      }
                    }
                  };
                }
              };
            };
          };
        }
      };
    }

    // Nachricht: Kopfleiste mit Aktionen (Briefing 1.1), Banner, Kopf, Inhalt.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // #399 Punkt 5/6: Neu an erster Stelle, Suche rechts neben den Fensterknöpfen.
      // „Lights off“: Gtk.Stack wechselt von den Aktionen zum Suchfeld, das dann die
      // ganze Breite bis zum Suchknopf einnimmt. Umschalten in mail-view.c.
      // Abweichung HIG-SE („a search bar which slides down from beneath the header bar“):
      // Suchfeld in der Kopfleiste statt Gtk.SearchBar darunter (Vorgabe Arnd, #399).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        // Alles im Titel: AdwHeaderBar zentriert den Titel, ein Titel mit hexpand füllt
        // nur den Platz, der neben gleich breiten Rändern bleibt; [start]-Kinder erhalten
        // nur ihre natürliche Breite (Messung Verifier #399). Ohne Kinder links/rechts
        // reicht der Titel über die ganze Breite; die Fensterknöpfe stehen daher als
        // Gtk.WindowControls im Titel.
        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button compose_button {
                  icon-name: "mail-message-new-symbolic";
                  tooltip-text: _("Neue E-Mail");
                  action-name: "list.compose";

                  accessibility {
                    label: _("Neue E-Mail");
                  }
                }

                Separator compose_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Button {
                  icon-name: "mail-reply-sender-symbolic";
                  action-name: "message.reply";
                  tooltip-text: _("Antworten");

                  accessibility {
                    label: _("Antworten");
                  }
                }

                Button {
                  icon-name: "mail-reply-all-symbolic";
                  action-name: "message.reply-all";
                  tooltip-text: _("Allen antworten");

                  accessibility {
                    label: _("Allen antworten");
                  }
                }

                Button {
                  icon-name: "mail-forward-symbolic";
                  action-name: "message.forward";
                  tooltip-text: _("Weiterleiten");

                  accessibility {
                    label: _("Weiterleiten");
                  }
                }

                Box {
                  hexpand: true;
                }

                Button {
                  icon-name: "archive-symbolic";
                  action-name: "message.archive";
                  tooltip-text: _("Archivieren");

                  accessibility {
                    label: _("Archivieren");
                  }
                }

                Button {
                  icon-name: "user-trash-symbolic";
                  action-name: "message.delete";
                  tooltip-text: _("Löschen");

                  accessibility {
                    label: _("Löschen");
                  }
                }

                Button {
                  icon-name: "mail-mark-junk-symbolic";
                  action-name: "message.junk";
                  tooltip-text: _("Als Spam markieren");

                  accessibility {
                    label: _("Als Spam markieren");
                  }
                }

                MenuButton {
                  icon-name: "folder-symbolic";
                  always-show-arrow: true;
                  // Ziele (Ordner) folgen mit #363.
                  sensitive: false;
                  tooltip-text: _("Verschieben");

                  accessibility {
                    label: _("Verschieben");
                  }
                }

                ToggleButton {
                  icon-name: "starred-symbolic";
                  action-name: "message.star";
                  tooltip-text: _("Markieren");

                  accessibility {
                    label: _("Markieren");
                  }
                }

                // #400 Punkt 8: Sekundärmenü der Nachricht als Mail-Symbol mit Pfeil
                // wie der Ordner-Knopf daneben (statt view-more, Arnd: verwirrend).
                MenuButton {
                  icon-name: "mail-unread-symbolic";
                  always-show-arrow: true;
                  tooltip-text: _("Weitere Aktionen");
                  menu-model: message_menu;

                  accessibility {
                    label: _("Weitere Aktionen");
                  }
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("E-Mails durchsuchen");
                // Tippen in der Liste startet die Suche (HIG-SE „type to search“, wie main).
                key-capture-widget: list_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("E-Mails durchsuchen");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      // #400 Punkt 7: Kopf frei auf dem Hintergrund, darunter der Mailtext als große
      // abgerundete Karte bis zum unteren Rand (Vorbild 03). Nur der Inhalt scrollt.
      // Ohne Auswahl: Leerzustand wie Stamp (stamp-message-list.blp:119-135).
      // Nachrichtenkopf und Inhalt füllt #354.
      content: Stack message_stack {
        // Erste Seite „empty“ ist sichtbar (Gtk.Stack zeigt das erste Kind).
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "mail-unread-symbolic";
            title: _("Keine Nachricht ausgewählt");
          };
        }

        StackPage {
          name: "content";

          child: Box {
            orientation: vertical;

            // #401 Punkt 4: Hinweis im Apple-Stil (Vorbild 12) statt Adw.Banner über die
            // volle Breite: abgerundete Pille mit Abstand, Symbol links, Knopf in Akzentfarbe.
            // Sichtbar erst mit #355 (Remote-Bilder-Sperre).
            Box {
              visible: false;
              spacing: 12;
              margin-start: 12;
              margin-end: 12;
              // #340: 13px, Oberkante auf der Linie 63px (style.css „Eine Linie“).
              margin-top: 13;

              styles [
                "mail-notice",
              ]

              Image {
                icon-name: "preferences-system-privacy-symbolic";
                accessible-role: presentation;
              }

              Label {
                label: _("Entfernte Inhalte gesperrt");
                hexpand: true;
                xalign: 0;
                ellipsize: end;
              }

              Button {
                label: _("Laden");
                tooltip-text: _("Entfernte Inhalte dieser E-Mail laden");
                valign: center;

                styles [
                  "mail-notice-button",
                ]
              }
            }

            // Nachrichtenkopf, Vorlage stamp-message-header.blp:4-150.
            // #401 Punkt 5: graziler (Vorbild 13): nur der Absender halbfett, Betreff gleich groß.
            Grid {
              column-spacing: 12;
              row-spacing: 2;
              margin-start: 24;
              margin-end: 18;
              margin-top: 14;
              margin-bottom: 14;

              Adw.Avatar {
                size: 48;
                valign: start;
                show-initials: true;
                text: "";

                layout {
                  column: 0;
                  row: 0;
                  row-span: 3;
                }
              }

              Box {
                spacing: 6;

                layout {
                  column: 1;
                  row: 0;
                }

                Label {
                  label: "";
                  hexpand: true;
                  xalign: 0;
                  ellipsize: end;
                  selectable: true;

                  styles [
                    "mail-sender",
                  ]
                }

                Image {
                  icon-name: "inbox-symbolic";
                  tooltip-text: _("Ordner");

                  accessibility {
                    label: _("Ordner");
                  }

                  styles [
                    "dimmed",
                  ]
                }

                Label {
                  label: "";

                  styles [
                    "dimmed",
                  ]
                }

                Label {
                  label: "";
                  margin-start: 6;

                  styles [
                    "numeric",
                    "dimmed",
                  ]
                }
              }

              Label {
                label: "";
                xalign: 0;
                wrap: true;
                selectable: true;

                layout {
                  column: 1;
                  row: 1;
                }

                styles [
                  "mail-subject",
                ]
              }

              Box {
                spacing: 6;

                layout {
                  column: 1;
                  row: 2;
                }

                Label {
                  label: _("An:");

                  styles [
                    "dimmed",
                  ]
                }

                Label {
                  label: "";
                  hexpand: true;
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "dimmed",
                  ]
                }

                Button {
                  label: _("Details");
                  tooltip-text: _("Alle Kopfzeilen anzeigen");
                  valign: center;

                  styles [
                    "flat",
                    "mail-details",
                  ]
                }
              }
            }

            // HTML-Mail: eigener weißer Hintergrund auch im Dunkelmodus (style.css .html-mail).
            // Inhalt folgt mit WebKitGTK (#354).
            Adw.Bin {
              vexpand: true;
              overflow: hidden;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;

              styles [
                "html-mail",
              ]
            }
          };
        }
      };
    }


    // Breit: Seitenleiste | Liste | Nachricht, Listenbreite ziehbar (stamp-mail-view.blp:57-96).
    // Schmal (≤ 1000 sp): dieselbe Ansicht, Seitenleiste eingeklappt als Überlagerung
    // (stamp-mail-view.blp:98-137), Werte per Breakpoint oben.
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 236;
        max-sidebar-width: 296;

        styles [
          "mail-split",
        ]

        // #400 Punkt 1: Seitenleiste als schwebende, abgerundete Fläche mit Abstand
        // zum Fensterrand rundum (Vorbild 06/07, style.css .floating-sidebar).
        sidebar: Adw.Bin {
          overflow: hidden;
          margin-start: 8;
          margin-end: 8;
          margin-top: 8;
          margin-bottom: 8;

          styles [
            "floating-sidebar",
          ]

          child: Adw.LayoutSlot {
            id: "sidebar";
          };
        };

        content: Paned {
          position: 380;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Nachricht (stamp-mail-view.blp:139-185).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Mail");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.LayoutSlot {
              id: "list";
            };
          };
        }

        Adw.NavigationPage {
          title: _("Nachricht");
          tag: "message";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

// #400 Punkt 3/5/8: Menüs wie GNOME Dateien (Vorbild 08): Gruppen als Abschnitte,
// die GtkPopoverMenu mit Trennlinien zeichnet; Tastenkürzel rechts über das
// accel-Attribut (nur Anzeige, ausgelöst durch den ShortcutController oben).
menu filter_menu {
  section {
    item {
      label: _("Alle");
      action: "list.filter";
      target: "all";
    }
  }

  section {
    item {
      label: _("Ungelesen");
      action: "list.filter";
      target: "unread";
    }

    item {
      label: _("Markiert");
      action: "list.filter";
      target: "starred";
    }

    item {
      label: _("Mit Anhang");
      action: "list.filter";
      target: "attachment";
    }
  }
}

menu message_menu {
  section {
    item {
      label: _("Als ungelesen markieren");
      action: "message.mark-unread";
    }
  }

  section {
    item {
      label: _("Drucken…");
      action: "message.print";
      accel: "<primary>p";
    }
  }
}

// Einstellungen, Tastenkürzel, Info: Aktionen folgen in eigenen Tasks, bis dahin ausgegraut.
menu primary_menu {
  section {
    item {
      label: _("_Neue E-Mail");
      action: "list.compose";
      accel: "<primary>n";
    }

    item {
      label: _("_Suchen");
      action: "mail.search";
      accel: "<primary>f";
    }
  }

  // #401 Punkt 2: ohne Haken (eine Haken-Spalte rückt alle Einträge ein),
  // daher die zustandslose Aktion mail.toggle-sidebar statt mail.sidebar.
  section {
    item {
      label: _("Seiten_leiste ein-/ausblenden");
      action: "mail.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Darstellung");

    item {
      label: _("_Hell");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dunkel _mit hellem Inhalt");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dunkel");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Einstellungen");
      action: "mail.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Tastenkürzel");
      action: "mail.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_Info zu Revolution");
      action: "mail.about";
    }
  }
}
