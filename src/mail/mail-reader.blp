// Lesebereich (#354): Kopf frei oben, darunter der Inhalt als große abgerundete Karte bis unten
// (Dokument #5 „Nachricht“, Design/Prototyp/mail-hell.png, #400 Punkt 7). Aus mail-view.blp
// (Seite „content“ von message_stack) hierher verschoben; Daten und WebView in mail-reader.c.
using Gtk 4.0;
using Adw 1;

template $RevolutionMailReader: Adw.Bin {
  // #355: Strg+I wie Evolution „Bilder laden“ (e-mail-reader.c:3116-3121). Scope managed: das
  // Fenster wertet das Kürzel aus, auch wenn die Nachrichtenliste den Fokus hat; die Aktion ist nur
  // bei sichtbarem Hinweis aktiv (mail-reader.c set_notice).
  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "<primary>i";
      action: "action(reader.load-remote)";
    }
  }

  child: Box {
    orientation: vertical;

    // #401 Punkt 4: Hinweis im Apple-Stil (Vorbild 12) statt Adw.Banner über die
    // volle Breite: abgerundete Pille mit Abstand, Symbol links, Knopf in Akzentfarbe.
    // #355: sichtbar, sobald die Web-Process-Extension entfernte Inhalte gesperrt hat
    // (mail-reader.c on_user_message). Knopf wie Evolution „Load remote content“ mit Menü
    // für Absender und Domain (e-mail-remote-content-popover.c:225-240, 309-335).
    Box notice {
      visible: false;
      spacing: 12;
      margin-start: 12;
      margin-end: 12;
      // #340: 13px, Oberkante auf der Linie 63px (style.css „Eine Linie“).
      margin-top: 13;

      styles [
        "mail-notice",
      ]

      Image {
        icon-name: "preferences-system-privacy-symbolic";
        accessible-role: presentation;
      }

      Label {
        label: _("Remote Content Blocked");
        hexpand: true;
        xalign: 0;
        ellipsize: end;
      }

      // Tooltip mit Kürzel setzt mail-reader.c (revolution_mail_reader_init).
      Adw.SplitButton notice_button {
        label: _("Load");
        action-name: "reader.load-remote";
        dropdown-tooltip: _("Always Load Remote Content");
        menu-model: notice_menu;
        valign: center;

        accessibility {
          description: _("Load Remote Content of This Message");
        }

        styles [
          "mail-notice-button",
        ]
      }
    }

    // Nachrichtenkopf, Vorlage stamp-message-header.blp:4-150.
    // #401 Punkt 5: graziler (Vorbild 13): nur der Absender halbfett, Betreff gleich groß.
    // #422: in der Konversation ohne Rand oben (revolution_mail_reader_set_compact).
    Grid header_grid {
      column-spacing: 12;
      row-spacing: 2;
      margin-start: 24;
      margin-end: 18;
      margin-top: 14;
      margin-bottom: 14;

      Adw.Avatar avatar {
        size: 48;
        valign: start;
        show-initials: true;

        layout {
          column: 0;
          row: 0;
          row-span: 3;
        }
      }

      // #357: in der Konversation ausgeblendet (revolution_mail_reader_set_compact).
      Box sender_row {
        spacing: 6;

        layout {
          column: 1;
          row: 0;
        }

        Label sender_label {
          hexpand: true;
          xalign: 0;
          ellipsize: end;
          selectable: true;

          styles [
            "mail-sender",
          ]
        }

        Image folder_icon {
          accessible-role: presentation;

          styles [
            "dimmed",
          ]
        }

        // „Eingang — Privat“ wie der Prototyp: Ordner und Konto.
        Label folder_label {
          ellipsize: end;

          styles [
            "dimmed",
          ]
        }

        Label date_label {
          margin-start: 6;

          styles [
            "numeric",
            "dimmed",
          ]
        }
      }

      Label subject_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        selectable: true;

        layout {
          column: 1;
          row: 1;
        }

        styles [
          "mail-subject",
        ]
      }

      Box {
        spacing: 6;

        layout {
          column: 1;
          row: 2;
        }

        Label to_caption {
          label: _("To:");

          styles [
            "dimmed",
          ]
        }

        Label to_label {
          hexpand: true;
          xalign: 0;
          ellipsize: end;

          accessibility {
            labelled-by: to_caption;
          }

          styles [
            "dimmed",
          ]
        }

        // Details aufklappbar (Dokument #10 „#354“): Von, An, Kopie, Datum vollständig.
        ToggleButton details_button {
          label: _("Details");
          tooltip-text: _("Show All Headers");
          valign: center;

          accessibility {
            description: _("Show All Headers");
          }

          styles [
            "flat",
            "mail-details",
          ]
        }
      }
    }

    Revealer details_revealer {
      reveal-child: bind details_button.active;
      transition-type: slide_down;

      // Werte an der Spalte des Absenders (24 + 48 Avatar + 12 Abstand).
      child: Grid {
        column-spacing: 12;
        row-spacing: 4;
        margin-start: 84;
        margin-end: 18;
        margin-bottom: 14;

        Label from_caption {
          label: _("From:");
          xalign: 1;
          yalign: 0;

          layout {
            column: 0;
            row: 0;
          }

          styles [
            "dimmed",
          ]
        }

        Label from_full {
          xalign: 0;
          hexpand: true;
          wrap: true;
          wrap-mode: word_char;
          selectable: true;

          accessibility {
            labelled-by: from_caption;
          }

          layout {
            column: 1;
            row: 0;
          }
        }

        Label to_full_caption {
          label: _("To:");
          xalign: 1;
          yalign: 0;

          layout {
            column: 0;
            row: 1;
          }

          styles [
            "dimmed",
          ]
        }

        Label to_full {
          xalign: 0;
          wrap: true;
          wrap-mode: word_char;
          selectable: true;

          accessibility {
            labelled-by: to_full_caption;
          }

          layout {
            column: 1;
            row: 1;
          }
        }

        Label cc_caption {
          label: _("Cc:");
          xalign: 1;
          yalign: 0;
          visible: bind cc_full.visible;

          layout {
            column: 0;
            row: 2;
          }

          styles [
            "dimmed",
          ]
        }

        Label cc_full {
          xalign: 0;
          wrap: true;
          wrap-mode: word_char;
          selectable: true;

          accessibility {
            labelled-by: cc_caption;
          }

          layout {
            column: 1;
            row: 2;
          }
        }

        Label date_caption {
          label: _("Date:");
          xalign: 1;
          yalign: 0;

          layout {
            column: 0;
            row: 3;
          }

          styles [
            "dimmed",
          ]
        }

        Label date_full {
          xalign: 0;
          wrap: true;
          selectable: true;

          accessibility {
            labelled-by: date_caption;
          }

          layout {
            column: 1;
            row: 3;
          }
        }
      };
    }

    // #356: Anhangleiste unter dem Kopf (mail-attachment.blp), nur mit Anhängen sichtbar.
    $RevolutionMailAttachmentBar attachments {}

    // HTML-Mail: eigener Hintergrund (style.css .html-mail, Themes #340). Die WebView setzt
    // mail-reader.c als Kind des Overlays ein; der Kreisel zeigt das Laden aus dem Worker.
    // #357: in der Konversation nicht ausgedehnt, Höhe nach dem Inhalt (mail-reader.c fit_content).
    Adw.Bin content_card {
      vexpand: true;
      overflow: hidden;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 12;

      styles [
        "html-mail",
      ]

      child: Overlay content_overlay {
        [overlay]
        Adw.Spinner spinner {
          visible: false;
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        }
      };
    }
  };
}

// #355: Einträge setzt mail-reader.c fill_notice_menu (Absender, Domain).
menu notice_menu {}
