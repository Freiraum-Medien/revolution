// Mail-Ansicht dreispaltig (Prototyp #336). Daten folgen mit #345, #348, #352, #354.
// Aufbau nach quelltext/stamp/src/views/mail/stamp-mail-view.blp:4-193 (Briefing 1.1, 1.2).
using Gtk 4.0;
using Adw 1;

template $RevolutionMailView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #399: Strg+F öffnet die Suche in der Kopfleiste der Nachricht (HIG-SE „Ctrl+F“),
  // F9 schaltet die Seitenleiste wie GNOME Calendar (gcal-window.blp:181-188).
  // Scope local wie calendar-view.blp:14-72: wirkt nur auf der Mail-Seite. Aktionen in mail-view.c.
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(mail.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(mail.sidebar)";
    }

    // #400 Punkt 3/8: Kürzel der Menüeinträge (HIG Keyboard, Standardkürzel
    // Strg+N, Strg+P, Strg+Komma, Strg+?), im Menü rechts angezeigt (accel-Attribut).
    Shortcut {
      trigger: "<primary>n";
      action: "action(list.compose)";
    }

    // #359: Antworten, Allen antworten wie Evolution (e-mail-reader.c:3354-3387).
    Shortcut {
      trigger: "<primary>r";
      action: "action(message.reply)";
    }

    Shortcut {
      trigger: "<primary><shift>r";
      action: "action(message.reply-all)";
    }

    // #360: Weiterleiten, Öffnen (Entwurf) wie Evolution (e-mail-reader.c:3044-3049, 3249-3254).
    Shortcut {
      trigger: "<primary><alt>f";
      action: "action(message.forward)";
    }

    Shortcut {
      trigger: "<primary>o";
      action: "action(message.open)";
    }

    Shortcut {
      trigger: "<primary>p";
      action: "action(message.print)";
    }

    Shortcut {
      trigger: "<primary>comma";
      action: "action(mail.preferences)";
    }

    Shortcut {
      trigger: "<primary>question";
      action: "action(mail.shortcuts)";
    }

    // #353: Gelesen/Ungelesen wie Evolution (e-mail-reader.c:3179-3226: Strg+K, Umschalt+Strg+K),
    // Markieren umschalten mit Umschalt+Strg+L wie Apple Mail ⇧⌘L (Entscheidung PM 23.10.2026;
    // Evolution hat für „Wichtig“ kein Kürzel, e-mail-reader.c:3137-3149, Strg+S ist dort
    // „Speichern unter“, 3389-3394; auf der Apple-Seite „Tastaturkurzbefehle in Mail auf dem Mac“
    // nicht aufgeführt), Aktualisieren F5 wie Evolution (e-mail-shell-view-actions.c:1721-1726).
    Shortcut {
      trigger: "<primary>k";
      action: "action(message.mark-read)";
    }

    Shortcut {
      trigger: "<primary><shift>k";
      action: "action(message.mark-unread)";
    }

    Shortcut {
      trigger: "<primary><shift>l";
      action: "action(message.star)";
    }

    Shortcut {
      trigger: "F5";
      action: "action(list.refresh)";
    }

    // #357: Konversation/flach umschalten, Strg+T wie Evolution „Nach Threads gruppieren“
    // (e-mail-shell-view-actions.c:1922-1927); Aktion aus GSettings „conversations“ (mail-view.c).
    Shortcut {
      trigger: "<primary>t";
      action: "action(list.conversations)";
    }

    // #363: Löschen mit Entf wie Evolution (e-mail-reader.c:3574-3575), dazu ⌫ (Entscheidung PM, #363), Archivieren
    // Strg+Alt+A wie Evolution (e-mail-reader.c:2911-2916). Spam Umschalt+Strg+J wie Apple Mail ⇧⌘J („Move the
    // selected emails to the Junk mailbox“, support.apple.com/guide/mail/mlhlb94f262b) und Dokument #12
    // („Strg+Umschalt+J“); Konflikt: in Evolution ist Umschalt+Strg+J „Kein Spam“ (e-mail-reader.c:3165-3168), Spam
    // dort Strg+J (3151-3156). Verschieben Umschalt+Strg+M (Entscheidung PM; Evolution Umschalt+Strg+V,
    // 3256-3261, Apple Mail ⌃⌘M „predicted mailbox“). Rückgängig Strg+Z (HIG Keyboard, Standardkürzel).
    Shortcut {
      trigger: "Delete|KP_Delete|BackSpace";
      action: "action(message.delete)";
    }

    Shortcut {
      trigger: "<primary><alt>a";
      action: "action(message.archive)";
    }

    Shortcut {
      trigger: "<primary><shift>j";
      action: "action(message.junk)";
    }

    Shortcut {
      trigger: "<primary><shift>m";
      action: "action(message.move)";
    }

    Shortcut {
      trigger: "<primary>z";
      action: "action(message.undo)";
    }
  }

  // Briefing 1.2: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“ (stamp-mail-view.blp:8-26).
  // Es gilt nur der zuletzt passende Breakpoint, daher setzt „mobile“ show-sidebar erneut.
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      // #400 Punkt 6: Neu bleibt in der Kopfleiste der Nachricht (Arnd). Damit alle
      // Knöpfe bei 900 px neben die Liste passen: ohne Abstandhalter, Liste mind. 280.
      compose_spacer.visible: false;
      list_pane.width-request: 280;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      mail_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Es gilt nur der zuletzt passende Breakpoint (s. o.): Neu bleibt in der Liste.
      list_compose_button.visible: true;
      compose_button.visible: false;
      compose_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView mail_layout {
    // Seitenleiste: Ordnerbaum als GtkListView + GtkTreeListModel (CR #397),
    // Vorlage stamp-folder-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Umschalter Mail | Kalender | Kontakte oben in der Kopfleiste der Seitenleiste
        // (Arnd 22.10.2026, #340, Vorbild 22/24): Segment-Umschalter, Standard-libadwaita
        // (AdwInlineViewSwitcher = AdwToggleGroup am ViewStack, nur Symbole);
        // Seitentitel als Tooltip setzt libadwaita (geprüft headless).
        title-widget: Adw.InlineViewSwitcher {
          stack: bind template.stack;
          display-mode: icons;
        };

        // #399 Punkt 3: Primärmenü in der Seitenleisten-Kopfleiste wie Nautilus (Briefing N).
        // HIG Menus: „The button for primary menus should use the open-menu-symbolic icon“.
        // primary: F10 öffnet das Menü (GtkMenuButton:primary).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";

          // #401 Punkt 2: kompaktes Menü ohne Einzug (style.css .primary-menu).
          styles [
            "primary-menu",
          ]

          tooltip-text: _("Hauptmenü");
          menu-model: primary_menu;

          accessibility {
            label: _("Hauptmenü");
          }
        }
      }

      // #345: Konten aus der ESourceRegistry (mail-view.c). Ohne Konten Leerzustand
      // wie Stamp (stamp-window.blp:50-80, Seite „welcome“), hier in der Seitenleiste.
      content: Stack sidebar_stack {
        // Erste Seite „list“ ist sichtbar, bis die Registry geladen ist (leere Liste).
        StackPage {
          name: "list";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            // Viewport: sonst blendet GtkListView beim Start den ersten
            // Abschnittskopf („Favoriten“) aus, erst Hochscrollen zeigt ihn.
            // Ursache klären in #350, Virtualisierung geht verloren.
            child: Viewport {
              child: ListView folder_list {
                tab-behavior: item;

                // #364: Kürzel wie GNOME Dateien, nur im Ordnerbaum; Entf/⌫: on_folder_delete_key (mail-view.c).
                ShortcutController {
                  Shortcut {
                    trigger: "Menu|<shift>F10";
                    action: "action(list.context-menu)";
                  }

                  Shortcut {
                    trigger: "F2";
                    action: "action(folder.rename)";
                  }

                  Shortcut {
                    trigger: "<primary><shift>n";
                    action: "action(folder.new)";
                  }
                }

                styles [
                  "navigation-sidebar",
                ]

                accessibility {
                  label: _("Ordner");
                }

                // Modell (mail-view.c): je Konto ein GtkTreeListModel über seinen Ordnern,
                // zusammengefügt als Abschnitte (GtkFlattenListModel), #348.
                // #350: keine automatische Auswahl, die Erstauswahl trifft mail-view.c
                // (select_initial_folder), sonst würde der erste geladene Ordner geladen.
                model: SingleSelection folder_selection {
                  autoselect: false;
                };

                // Konten als nicht auswählbare Abschnittsköpfe wie der abgenommene Prototyp
                // (Tag m2-prototyp, mail-view.blp:137-154, Design/Prototyp/mail-hell.png
                // „Privat“, „Arbeit“). Kopf = Konto des ersten Ordners im Abschnitt.
                header-factory: BuilderListItemFactory {
                  template ListHeader {
                    child: Label {
                      label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.account as <$RevolutionMailAccount>.display-name;
                      xalign: 0;
                      margin-start: 14;
                      margin-end: 14;
                      margin-top: 4;
                      margin-bottom: 2;
                      ellipsize: end;

                      styles [
                        "caption-heading",
                        "dimmed",
                      ]
                    };
                  }
                };

                // Ordnerzeile wie der Prototyp (mail-view.blp:156-193), Unterordner mit
                // Ausklapp-Pfeil, #350 mit Ungelesen-Zähler.
                factory: BuilderListItemFactory {
                  template ListItem {
                    // Zugänglicher Name der Zeile = Ordnername, #350 mit Zahl der ungelesenen
                    // (Architektur 8).
                    accessible-label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.accessible-label;

                    child: TreeExpander {
                      list-row: bind template.item as <TreeListRow>;

                      // #364: Rechtsklick auf die ganze Zeile öffnet folder_menu.
                      GestureClick {
                        button: 3;
                        pressed => $on_folder_secondary_click(template);
                      }

                      // #363: Nachricht hierher ziehen = verschieben (mail-view.c, on_folder_drop).
                      DropTarget {
                        actions: move;
                        formats: "gchararray";
                        drop => $on_folder_drop(template);
                      }

                      child: Box {
                        spacing: 12;

                        Image {
                          icon-name: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.icon-name;
                          accessible-role: presentation;
                        }

                        Label {
                          label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.display-name;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        // #350: Ungelesen-Zähler wie der Prototyp (Tag m2-prototyp,
                        // mail-view.blp:176-189), leer bei 0.
                        Label {
                          label: bind template.item as <TreeListRow>.item as <$RevolutionMailFolder>.unread-label;
                          tooltip-text: _("Ungelesene Nachrichten");
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                            "numeric",
                          ]
                        }
                      };
                    };
                  }
                };
              };
            };
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "mail-unread-symbolic";
            title: _("Keine Konten");
            description: _("E-Mail-Konten aus den Online-Konten oder aus Evolution erscheinen hier.");

            styles [
              "compact",
            ]
          };
        }
      };
    }

    // Nachrichtenliste, Zeile nach stamp-conversation-row.blp:72-224.
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // #399 Punkt 4: Knopf immer sichtbar wie GNOME Calendar
        // (quelltext/gnome-calendar/src/gui/gcal-window.blp:176-189); F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Seitenleiste ein-/ausblenden");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Seitenleiste ein-/ausblenden");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste der Nachricht.
        [start]
        Button list_compose_button {
          visible: false;
          icon-name: "mail-message-new-symbolic";
          tooltip-text: _("Neue E-Mail");
          action-name: "list.compose";

          accessibility {
            label: _("Neue E-Mail");
          }
        }

        // #399 Punkt 7: Titel linksbündig wie Apple (Briefing V7). Adw.WindowTitle
        // zentriert, daher zwei Labels mit den Stilklassen aus HIG-TY.
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          // #352: Name des gewählten Ordners (mail-view.c, on_folder_selected).
          Label list_title {
            label: _("Mail");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          // #352: Anzahl wie der Prototyp „10 E-Mails, 4 ungelesen“ (set_list_subtitle).
          Label list_subtitle {
            visible: false;
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };

        [end]
        MenuButton {
          icon-name: "sort-order-symbolic";
          tooltip-text: _("Filter");
          menu-model: filter_menu;

          accessibility {
            label: _("Filter");
          }
        }
      }

      // #343/#345: Fehler als AdwBanner (CLAUDE.md Architektur-Festlegung 3) im Inhaltsbereich
      // unter der Kopfleiste, nicht über die volle Fensterbreite (HIG Banners: „strip along
      // the top of a view“); die Kopfleisten bleiben auf einer Linie (Dokument #5). Kurzer
      // Titel, Einzelheiten im Tooltip; beides setzt revolution_mail_view_show_error.
      // Ohne Markup, weil Fehlertexte <, & enthalten können.
      [top]
      Adw.Banner banner {
        use-markup: false;
      }

      // #408: Offline als Hinweis-Pille (Dokument #5: Hinweise als Pille statt Leiste, wie
      // mail-reader.blp „notice“, #355) statt Adw.Banner; sichtbar, solange die Session nach dem
      // Netzmonitor offline ist (revolution_mail_view_set_offline). Ohne Knopf: online geht es
      // von selbst, sobald das Netz zurück ist (main.c).
      [top]
      Box offline_notice {
        visible: false;
        spacing: 12;
        margin-start: 12;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 6;
        accessible-role: status;
        tooltip-text: _("Keine Netzwerkverbindung. Angezeigt wird der Stand auf diesem Gerät; online geht es von selbst, sobald das Netz zurück ist.");

        accessibility {
          label: _("Offline");
          description: _("Keine Netzwerkverbindung. Angezeigt wird der Stand auf diesem Gerät.");
        }

        styles [
          "mail-notice",
          "offline-notice",
        ]

        Image {
          icon-name: "network-offline-symbolic";
          accessible-role: presentation;
        }

        Label {
          label: _("Offline");
          hexpand: true;
          xalign: 0;
          ellipsize: end;
        }
      }

      // Ohne Ordner und bei leerem Ordner: Leerzustand wie Stamp (stamp-conversation-list.blp:252-259).
      // #352: Seite „list“ während des Ladens und mit Nachrichten (mail-view.c).
      content: Stack list_stack {
        // Erste Seite „empty“ ist sichtbar (Gtk.Stack zeigt das erste Kind).
        StackPage {
          name: "empty";

          // #365: Titel je nach Suche (mail-view.c, set_empty_page).
          child: Adw.StatusPage empty_page {
            icon-name: "inbox-symbolic";
            title: _("Keine Nachrichten");
          };
        }

        StackPage {
          name: "list";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            // #400 Punkt 4: Auswahl als abgerundete Akzentfläche mit Abstand zum Rand,
            // ohne Trennlinien (Vorbild 04/05, style.css).
            child: ListView message_list {
              tab-behavior: item;
              // #360: Doppelklick/Eingabe = message.open (Entwurf weiter bearbeiten).
              activate => $on_message_activate() swapped;

              // #353: Kontextmenü der Zeile per Tastatur (HIG Keyboard: Menü, Umschalt+F10).
              ShortcutController {
                Shortcut {
                  trigger: "Menu|<shift>F10";
                  action: "action(list.context-menu)";
                }
              }

              styles [
                "message-list",
              ]

              accessibility {
                label: _("Nachrichten");
              }

              // Keine Vorauswahl: die Auswahl öffnet die Nachricht (#354), Erstauswahl #350.
              model: SingleSelection message_selection {
                autoselect: false;
                can-unselect: true;
              };

              factory: BuilderListItemFactory {
                template ListItem {
                  // #352: Zugänglicher Name der Zeile: Absender, Betreff, Datum, ungelesen (Architektur 8).
                  accessible-label: bind template.item as <$RevolutionMailMessage>.accessible-label;

                  child: Box {
                    spacing: 6;

                    // #353: Rechtsklick öffnet das Kontextmenü (row_menu), Wischen wie Apple Mail
                    // (mail-view.c, on_row_swipe).
                    GestureClick {
                      button: 3;
                      pressed => $on_row_secondary_click(template);
                    }

                    GestureSwipe {
                      swipe => $on_row_swipe(template);
                    }

                    // #363: Ziehen auf einen Ordner der Seitenleiste verschiebt (on_row_drag_prepare).
                    DragSource {
                      actions: move;
                      prepare => $on_row_drag_prepare(template);
                    }

                    // Platz für den Ungelesen-Punkt bleibt auch ohne Punkt frei.
                    Box {
                      width-request: 10;
                      valign: start;
                      margin-top: 4;

                      Image {
                        icon-name: "media-record-symbolic";
                        pixel-size: 10;
                        visible: bind template.item as <$RevolutionMailMessage>.unread;
                        tooltip-text: _("Ungelesen");

                        accessibility {
                          label: _("Ungelesen");
                        }

                        styles [
                          "accent",
                        ]
                      }
                    }

                    // #357: in Konversationen der Absender der neuesten Nachricht (Eigenschaft avatar).
                    Adw.Avatar {
                      size: 40;
                      valign: start;
                      show-initials: true;
                      text: bind template.item as <$RevolutionMailMessage>.avatar;
                      margin-end: 6;
                    }

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      spacing: 2;

                      Box {
                        spacing: 6;

                        Label sender_unread {
                          label: bind template.item as <$RevolutionMailMessage>.sender;
                          visible: bind template.item as <$RevolutionMailMessage>.unread;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "heading",
                          ]
                        }

                        Label {
                          label: bind template.item as <$RevolutionMailMessage>.sender;
                          visible: bind sender_unread.visible inverted;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        // #357: Zahl der Nachrichten einer Konversation (ab zwei), klein und gedimmt.
                        Label {
                          label: bind template.item as <$RevolutionMailMessage>.count-label;
                          visible: bind template.item as <$RevolutionMailMessage>.show-count;
                          tooltip-text: _("Nachrichten in der Konversation");

                          styles [
                            "caption",
                            "numeric",
                            "conversation-count",
                          ]
                        }

                        // #351: Konto der Nachricht in den Favoriten (mail-message.c), Kurzform, klein
                        // und gedimmt wie das Datum (Dokument #5: Beschriftungen gedimmt), voller
                        // Name im Tooltip.
                        Label {
                          label: bind template.item as <$RevolutionMailMessage>.account-label;
                          visible: bind template.item as <$RevolutionMailMessage>.show-account;
                          tooltip-text: bind template.item as <$RevolutionMailMessage>.account;
                          max-width-chars: 14;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Label {
                          label: bind template.item as <$RevolutionMailMessage>.date;

                          styles [
                            "caption",
                            "numeric",
                            "dimmed",
                          ]
                        }
                      }

                      Box {
                        spacing: 6;

                        Label {
                          label: bind template.item as <$RevolutionMailMessage>.subject;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        // #401: Symbole dezent wie Apple Mail (Vorbild 17): 12px, grau (style.css).
                        Image {
                          icon-name: "mail-attachment-symbolic";
                          pixel-size: 12;
                          visible: bind template.item as <$RevolutionMailMessage>.attachment;
                          tooltip-text: _("Mit Anhang");

                          accessibility {
                            label: _("Mit Anhang");
                          }

                          styles [
                            "dimmed",
                            "list-icon",
                          ]
                        }

                        Image {
                          icon-name: "starred-symbolic";
                          pixel-size: 12;
                          visible: bind template.item as <$RevolutionMailMessage>.starred;
                          tooltip-text: _("Markiert");

                          accessibility {
                            label: _("Markiert");
                          }

                          styles [
                            "accent",
                            "list-icon",
                          ]
                        }
                      }

                      // #352: Inscription wie Stamp (stamp-conversation-row.blp:170-180) mit fest
                      // zwei Zeilen, damit Zeilen ohne Vorschau (z. B. Gmail) gleich hoch bleiben.
                      Inscription {
                        text: bind template.item as <$RevolutionMailMessage>.preview;
                        xalign: 0;
                        yalign: 0;
                        min-lines: 2;
                        nat-lines: 2;
                        wrap-mode: word_char;
                        text-overflow: ellipsize_end;

                        styles [
                          "dimmed",
                        ]
                      }
                    }
                  };
                }
              };
            };
          };
        }
      };
    }

    // Nachricht: Kopfleiste mit Aktionen (Briefing 1.1), Banner, Kopf, Inhalt.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // #399 Punkt 5/6: Neu an erster Stelle, Suche rechts neben den Fensterknöpfen.
      // „Lights off“: Gtk.Stack wechselt von den Aktionen zum Suchfeld, das dann die
      // ganze Breite bis zum Suchknopf einnimmt. Umschalten in mail-view.c.
      // Abweichung HIG-SE („a search bar which slides down from beneath the header bar“):
      // Suchfeld in der Kopfleiste statt Gtk.SearchBar darunter (Vorgabe Arnd, #399).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        // Alles im Titel: AdwHeaderBar zentriert den Titel, ein Titel mit hexpand füllt
        // nur den Platz, der neben gleich breiten Rändern bleibt; [start]-Kinder erhalten
        // nur ihre natürliche Breite (Messung Verifier #399). Ohne Kinder links/rechts
        // reicht der Titel über die ganze Breite; die Fensterknöpfe stehen daher als
        // Gtk.WindowControls im Titel.
        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button compose_button {
                  icon-name: "mail-message-new-symbolic";
                  tooltip-text: _("Neue E-Mail");
                  action-name: "list.compose";

                  accessibility {
                    label: _("Neue E-Mail");
                  }
                }

                Separator compose_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Button {
                  icon-name: "mail-reply-sender-symbolic";
                  action-name: "message.reply";
                  tooltip-text: _("Antworten");

                  accessibility {
                    label: _("Antworten");
                  }
                }

                Button {
                  icon-name: "mail-reply-all-symbolic";
                  action-name: "message.reply-all";
                  tooltip-text: _("Allen antworten");

                  accessibility {
                    label: _("Allen antworten");
                  }
                }

                Button {
                  icon-name: "mail-forward-symbolic";
                  action-name: "message.forward";
                  tooltip-text: _("Weiterleiten");

                  accessibility {
                    label: _("Weiterleiten");
                  }
                }

                Box {
                  hexpand: true;
                }

                Button {
                  icon-name: "archive-symbolic";
                  action-name: "message.archive";
                  tooltip-text: _("Archivieren");

                  accessibility {
                    label: _("Archivieren");
                  }
                }

                Button {
                  icon-name: "user-trash-symbolic";
                  action-name: "message.delete";
                  tooltip-text: _("Löschen");

                  accessibility {
                    label: _("Löschen");
                  }
                }

                Button {
                  icon-name: "mail-mark-junk-symbolic";
                  action-name: "message.junk";
                  tooltip-text: _("Als Spam markieren");

                  accessibility {
                    label: _("Als Spam markieren");
                  }
                }

                // #363: Ziele aus dem Ordnerbaum des Kontos (mail-view.c, fill_move_menu).
                MenuButton move_button {
                  icon-name: "folder-symbolic";
                  always-show-arrow: true;
                  menu-model: move_menu;
                  tooltip-text: _("Verschieben");

                  accessibility {
                    label: _("Verschieben");
                  }
                }

                ToggleButton {
                  icon-name: "starred-symbolic";
                  action-name: "message.star";
                  tooltip-text: _("Markieren");

                  accessibility {
                    label: _("Markieren");
                  }
                }

                // #400 Punkt 8: Sekundärmenü der Nachricht als Mail-Symbol mit Pfeil
                // wie der Ordner-Knopf daneben (statt view-more, Arnd: verwirrend).
                MenuButton {
                  icon-name: "mail-unread-symbolic";
                  always-show-arrow: true;
                  tooltip-text: _("Weitere Aktionen");
                  menu-model: message_menu;

                  accessibility {
                    label: _("Weitere Aktionen");
                  }
                }
              };
            }

            StackPage {
              name: "search";

              child: Box {
                spacing: 6;

                // Escape (GtkSearchEntry::stop-search) schließt die Suche.
                SearchEntry search_entry {
                  hexpand: true;
                  placeholder-text: _("E-Mails durchsuchen");
                  // Tippen in der Liste startet die Suche (HIG-SE „type to search“, wie main).
                  key-capture-widget: list_pane;
                  // #365: Suche nach Tipp-Pause wie Stamp (stamp-conversation-list.blp:146-147), nicht je Taste
                  // am Server (mail-search.c).
                  search-delay: 500;
                  search-started => $on_search_started() swapped;
                  stop-search => $on_search_stop() swapped;
                  search-changed => $on_search_changed() swapped;

                  accessibility {
                    label: _("E-Mails durchsuchen");
                  }
                }

                // #365: Suchbereich wie Evolutions „Aktueller Ordner | Alle Konten“
                // (e-mail-shell-view.c:1297-1309), nur sichtbar während der Suche; Alt+O / Alt+A.
                Adw.ToggleGroup search_scope {
                  valign: center;
                  notify::active-name => $on_search_changed() swapped;

                  Adw.Toggle {
                    name: "folder";
                    label: _("Dieser _Ordner");
                    use-underline: true;
                    tooltip: _("Im gewählten Ordner suchen");
                  }

                  Adw.Toggle {
                    name: "all";
                    label: _("_Alle Ordner");
                    use-underline: true;
                    tooltip: _("In allen Ordnern aller Konten suchen");
                  }

                  accessibility {
                    label: _("Suchbereich");
                  }
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      // #400 Punkt 7: Kopf frei auf dem Hintergrund, darunter der Mailtext als große
      // abgerundete Karte bis zum unteren Rand (Vorbild 03). Nur der Inhalt scrollt.
      // Ohne Auswahl: Leerzustand wie Stamp (stamp-message-list.blp:119-135).
      content: Stack message_stack {
        // Erste Seite „empty“ ist sichtbar (Gtk.Stack zeigt das erste Kind).
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "mail-unread-symbolic";
            title: _("Keine Nachricht ausgewählt");
          };
        }

        // #354: Lesebereich (Kopf und Inhalt) in eigenen Dateien mail-reader.{blp,c}.
        StackPage {
          name: "content";
          child: $RevolutionMailReader reader {};
        }

        // #357: Konversation: alle Nachrichten untereinander (mail-conversation.{blp,c}).
        StackPage {
          name: "conversation";
          child: $RevolutionMailConversation conversation_view {};
        }
      };
    }


    // Breit: Seitenleiste | Liste | Nachricht, Listenbreite ziehbar (stamp-mail-view.blp:57-96).
    // Schmal (≤ 1000 sp): dieselbe Ansicht, Seitenleiste eingeklappt als Überlagerung
    // (stamp-mail-view.blp:98-137), Werte per Breakpoint oben.
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 236;
        max-sidebar-width: 296;

        styles [
          "mail-split",
        ]

        // #400 Punkt 1: Seitenleiste als schwebende, abgerundete Fläche mit Abstand
        // zum Fensterrand rundum (Vorbild 06/07, style.css .floating-sidebar).
        sidebar: Adw.Bin {
          overflow: hidden;
          margin-start: 8;
          margin-end: 8;
          margin-top: 8;
          margin-bottom: 8;

          styles [
            "floating-sidebar",
          ]

          child: Adw.LayoutSlot {
            id: "sidebar";
          };
        };

        content: Paned {
          position: 380;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Nachricht (stamp-mail-view.blp:139-185).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Mail");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.LayoutSlot {
              id: "list";
            };
          };
        }

        Adw.NavigationPage {
          title: _("Nachricht");
          tag: "message";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

// #400 Punkt 3/5/8: Menüs wie GNOME Dateien (Vorbild 08): Gruppen als Abschnitte,
// die GtkPopoverMenu mit Trennlinien zeichnet; Tastenkürzel rechts über das
// accel-Attribut (nur Anzeige, ausgelöst durch den ShortcutController oben).
menu filter_menu {
  section {
    item {
      label: _("Alle");
      action: "list.filter";
      target: "all";
    }
  }

  section {
    item {
      label: _("Ungelesen");
      action: "list.filter";
      target: "unread";
    }

    item {
      label: _("Markiert");
      action: "list.filter";
      target: "starred";
    }

    item {
      label: _("Mit Anhang");
      action: "list.filter";
      target: "attachment";
    }
  }

  // #357: Umschalter Konversation/flach (Haken aus GSettings „conversations“).
  section {
    item {
      label: _("Nach _Konversationen");
      action: "list.conversations";
      accel: "<primary>t";
    }
  }
}

menu message_menu {
  section {
    item {
      label: _("Als gelesen markieren");
      action: "message.mark-read";
      accel: "<primary>k";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Als ungelesen markieren");
      action: "message.mark-unread";
      accel: "<primary><shift>k";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("Drucken…");
      action: "message.print";
      accel: "<primary>p";
    }
  }
}

// #353: Kontextmenü einer Zeile der Nachrichtenliste (mail-view.c, show_row_menu). Nur die
// passenden Einträge sind sichtbar (hidden-when), wie Apple Mail („Als gelesen“ oder „Als ungelesen“).
menu row_menu {
  section {
    item {
      label: _("Als _gelesen markieren");
      action: "message.mark-read";
      accel: "<primary>k";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Als _ungelesen markieren");
      action: "message.mark-unread";
      accel: "<primary><shift>k";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Markieren");
      action: "message.star-on";
      accel: "<primary><shift>l";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Markierung _entfernen");
      action: "message.star-off";
      accel: "<primary><shift>l";
      hidden-when: "action-disabled";
    }
  }

  // #363
  section {
    item {
      label: _("_Archivieren");
      action: "message.archive";
      accel: "<primary><alt>a";
    }

    item {
      label: _("_Löschen");
      action: "message.delete";
      accel: "Delete";
    }

    item {
      label: _("Als _Spam markieren");
      action: "message.junk";
      accel: "<primary><shift>j";
    }

    submenu move_menu {
      label: _("_Verschieben nach");
    }
  }
}

// #364: Kontextmenü des Ordnerbaums (mail-view.c, show_row_menu); Umbenennen und Löschen nur, wo erlaubt.
menu folder_menu {
  section {
    item {
      label: _("_Neuer Ordner…");
      action: "folder.new";
      accel: "<primary><shift>n";
    }

    item {
      label: _("_Umbenennen…");
      action: "folder.rename";
      accel: "F2";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Löschen…");
      action: "folder.delete";
      accel: "Delete";
      hidden-when: "action-disabled";
    }
  }
}

// Einstellungen, Tastenkürzel, Info: Aktionen folgen in eigenen Tasks, bis dahin ausgegraut.
menu primary_menu {
  section {
    item {
      label: _("_Neue E-Mail");
      action: "list.compose";
      accel: "<primary>n";
    }

    item {
      label: _("_Suchen");
      action: "mail.search";
      accel: "<primary>f";
    }

    // #353
    item {
      label: _("_Aktualisieren");
      action: "list.refresh";
      accel: "F5";
    }
  }

  // #401 Punkt 2: ohne Haken (eine Haken-Spalte rückt alle Einträge ein),
  // daher die zustandslose Aktion mail.toggle-sidebar statt mail.sidebar.
  section {
    item {
      label: _("Seiten_leiste ein-/ausblenden");
      action: "mail.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Darstellung");

    item {
      label: _("_Hell");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dunkel _mit hellem Inhalt");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dunkel");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Einstellungen");
      action: "mail.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Tastenkürzel");
      action: "mail.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_Info zu Revolution");
      action: "mail.about";
    }
  }
}
