using Gtk 4.0;
using Adw 1;

// Composer (Prototyp #337, Briefing 1.3). Vorlage
// quelltext/stamp/src/views/mail/composer/stamp-composer.blp, Apple V5.
// Nur Oberfläche mit fiktiven Beispieldaten, keine Logik.
template $RevolutionComposer: Adw.ApplicationWindow {
  styles [
    "composer",
  ]

  title: _("Neue E-Mail");
  default-width: 960;
  default-height: 720;
  width-request: 360;
  height-request: 294;
  focus-widget: body_view;

  // Kürzel wie Stamp (stamp-composer.c:2376-2389): Strg+Enter Senden,
  // Escape schließt; Fangphase, damit das Textfeld sie nicht verschluckt.
  // Strg+B/I/U für die Formatierungsleiste.
  ShortcutController {
    propagation-phase: capture;

    Shortcut {
      trigger: "<primary>Return";
      action: "action(composer.send)";
    }

    Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }

    Shortcut {
      trigger: "<primary>b";
      action: "action(composer.bold)";
    }

    Shortcut {
      trigger: "<primary>i";
      action: "action(composer.italic)";
    }

    Shortcut {
      trigger: "<primary>u";
      action: "action(composer.underline)";
    }
  }

  content: Adw.ToolbarView {
    // #402: Formatierungsleiste flach auf dem Fensterhintergrund wie die Mail-Ansicht.
    bottom-bar-style: flat;
    reveal-bottom-bars: bind format_button.active;

    [top]
    Adw.HeaderBar {
      // Briefing 1.3: Titel = Betreff bzw. „Neue E-Mail“ (stamp-composer.blp:17-19).
      title-widget: Adw.WindowTitle {
        title: _("Neue E-Mail");
      };

      // #402 (Arnd 22.10.): Hauptmenü oben links, ausdrücklich abweichend von HIG
      // („Ende“). Klasse primary-menu: Nautilus-Optik aus style.css (#401 Punkt 2).
      [start]
      MenuButton {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Hauptmenü");
        menu-model: composer_menu;
        primary: true;

        accessibility {
          label: _("Hauptmenü");
        }

        styles [
          "primary-menu",
        ]
      }

      // Briefing 1.3 (Vorschlag): Anhang und Formatierung ein/aus am Anfang.
      [start]
      Button {
        icon-name: "mail-attachment-symbolic";
        tooltip-text: _("Anhang hinzufügen");
        action-name: "composer.attach";

        accessibility {
          label: _("Anhang hinzufügen");
        }
      }

      [start]
      ToggleButton format_button {
        icon-name: "format-text-rich-symbolic";
        tooltip-text: _("Formatierung anzeigen");
        active: true;

        accessibility {
          label: _("Formatierung anzeigen");
        }
      }

      // Senden mit suggested-action (stamp-composer.blp:37-49).
      [end]
      // #402: Symbolknopf auf Akzentfläche statt Textknopf (Arnd 22.10.).
      Button {
        icon-name: "sent-symbolic";
        tooltip-text: _("Senden (Strg+Enter)");
        action-name: "composer.send";

        accessibility {
          label: _("Senden");
        }

        styles [
          "suggested-action",
        ]
      }
    }

    // #402: Designsprache der Mail-Ansicht (mail-view.blp): Felder frei auf dem
    // Fensterhintergrund wie der Mailkopf, darunter der Text als große abgerundete Karte.
    content: Box {
      orientation: vertical;

      // Felder untereinander mit Trennlinien (stamp-composer.blp:61-285),
      // Reihenfolge wie Apple V5: An, Kopie, Betreff, Von + Signatur.
      Grid {
        column-spacing: 12;
        row-spacing: 3;
        margin-start: 12;
        margin-end: 12;

        styles [
          "composer-fields",
        ]

        Label to_label {
          label: _("An");
          halign: start;
          xalign: 0;
          margin-start: 12;

          styles [
            "dimmed",
          ]

          layout {
            column: 0;
            row: 0;
          }
        }

        Entry to_entry {
          hexpand: true;
          text: _("Jonas Weber <jonas.weber@example.org>");

          accessibility {
            labelled-by: to_label;
          }

          styles [
            "flat",
          ]

          layout {
            column: 1;
            column-span: 2;
            row: 0;
          }
        }

        // #402: Kopie und Blindkopie getrennt über das Hauptmenü (composer.show-cc,
        // composer.show-bcc schalten die Sichtbarkeit der Felder, composer.c).
        Separator {
          visible: bind cc_entry.visible;

          layout {
            column: 0;
            column-span: 3;
            row: 1;
          }
        }

        Label cc_label {
          label: _("Kopie");
          halign: start;
          xalign: 0;
          margin-start: 12;
          visible: bind cc_entry.visible;

          styles [
            "dimmed",
          ]

          layout {
            column: 0;
            row: 2;
          }
        }

        Entry cc_entry {
          text: _("Mara Schulz <mara.schulz@example.net>");

          accessibility {
            labelled-by: cc_label;
          }

          styles [
            "flat",
          ]

          layout {
            column: 1;
            column-span: 2;
            row: 2;
          }
        }

        Separator {
          visible: bind bcc_entry.visible;

          layout {
            column: 0;
            column-span: 3;
            row: 3;
          }
        }

        Label bcc_label {
          label: _("Blindkopie");
          halign: start;
          xalign: 0;
          margin-start: 12;
          visible: bind bcc_entry.visible;

          styles [
            "dimmed",
          ]

          layout {
            column: 0;
            row: 4;
          }
        }

        Entry bcc_entry {
          accessibility {
            labelled-by: bcc_label;
          }

          styles [
            "flat",
          ]

          layout {
            column: 1;
            column-span: 2;
            row: 4;
          }
        }

        Separator {
          layout {
            column: 0;
            column-span: 3;
            row: 5;
          }
        }

        Label subject_label {
          label: _("Betreff");
          halign: start;
          xalign: 0;
          margin-start: 12;

          styles [
            "dimmed",
          ]

          layout {
            column: 0;
            row: 6;
          }
        }

        Entry subject_entry {
          text: _("Hoffest am Samstag – Planung");

          accessibility {
            labelled-by: subject_label;
          }

          styles [
            "flat",
          ]

          layout {
            column: 1;
            column-span: 2;
            row: 6;
          }
        }

        Separator {
          layout {
            column: 0;
            column-span: 3;
            row: 7;
          }
        }

        Label from_label {
          label: _("Von");
          halign: start;
          xalign: 0;
          margin-start: 12;

          styles [
            "dimmed",
          ]

          layout {
            column: 0;
            row: 8;
          }
        }

        // Identität wählbar (stamp-composer.blp:80, DropDown from).
        DropDown from_dropdown {
          halign: start;
          valign: center;

          styles [
            "composer-dropdown",
          ]

          model: StringList {
            strings [
              _("Lena Hoffmann – lena@hofladen-hoffmann.example"),
              _("Lena Hoffmann – lena.hoffmann@example.org"),
            ]
          };

          accessibility {
            labelled-by: from_label;
          }

          layout {
            column: 1;
            row: 8;
          }
        }

        // Signatur rechts in der Von-Zeile wie Apple V5 („Signatur: Ohne“).
        Box {
          spacing: 6;
          halign: end;
          valign: center;
          margin-end: 6;

          Label signature_label {
            label: _("Signatur");

            styles [
              "dimmed",
            ]
          }

          DropDown {
            styles [
              "composer-dropdown",
            ]

            model: StringList {
              strings [
                _("Ohne"),
                _("Geschäftlich"),
                _("Privat"),
              ]
            };

            selected: 1;

            accessibility {
              labelled-by: signature_label;
            }
          }

          layout {
            column: 2;
            row: 8;
          }
        }

        Separator {
          layout {
            column: 0;
            column-span: 3;
            row: 9;
          }
        }
      }

      // Anhangbereich als WrapBox (stamp-composer.blp:270-284), Anhang-Knopf
      // wie Stamp stamp-attachment-button.blp (Symbol, Name, Größe gedimmt).
      // #402: Anhänge als ruhige, abgerundete Pillen wie der Hinweis in der Mail-Ansicht
      // (style.css .mail-notice); kleines gedimmtes Symbol, Name, Größe gedimmt.
      Adw.WrapBox {
        child-spacing: 8;
        line-spacing: 8;
        margin-top: 10;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        Box {
          styles [
            "composer-attachment",
          ]

          Button {
            action-name: "composer.open-attachment";
            action-target: "'lageplan'";
            tooltip-text: _("Anhang öffnen");

            accessibility {
              label: _("Lageplan-Hoffest.pdf, 1,2 MB");
            }

            styles [
              "flat",
            ]

            child: Box {
              spacing: 8;

              Image {
                icon-name: "x-office-document-symbolic";
                accessible-role: presentation;

                styles [
                  "dimmed",
                ]
              }

              Box {
                spacing: 8;
                valign: center;

                Label {
                  label: _("Lageplan-Hoffest.pdf");
                  halign: start;
                  ellipsize: middle;
                }

                Label {
                  label: _("1,2 MB");
                  halign: start;

                  styles [
                    "dimmed",
                    "numeric",
                  ]
                }
              }
            };
          }

          Button {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Anhang entfernen");
            valign: center;

            styles [
              "flat",
              "circular",
            ]

            action-name: "composer.remove-attachment";
            action-target: "'lageplan'";

            accessibility {
              label: _("Lageplan-Hoffest.pdf entfernen");
            }
          }
        }

        Box {
          styles [
            "composer-attachment",
          ]

          Button {
            action-name: "composer.open-attachment";
            action-target: "'stand'";
            tooltip-text: _("Anhang öffnen");

            accessibility {
              label: _("Marktstand.jpg, 3,4 MB");
            }

            styles [
              "flat",
            ]

            child: Box {
              spacing: 8;

              Image {
                icon-name: "image-x-generic-symbolic";
                accessible-role: presentation;

                styles [
                  "dimmed",
                ]
              }

              Box {
                spacing: 8;
                valign: center;

                Label {
                  label: _("Marktstand.jpg");
                  halign: start;
                  ellipsize: middle;
                }

                Label {
                  label: _("3,4 MB");
                  halign: start;

                  styles [
                    "dimmed",
                    "numeric",
                  ]
                }
              }
            };
          }

          Button {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Anhang entfernen");
            valign: center;

            styles [
              "flat",
              "circular",
            ]

            action-name: "composer.remove-attachment";
            action-target: "'stand'";

            accessibility {
              label: _("Marktstand.jpg entfernen");
            }
          }
        }
      }

      // Nachrichtentext: Platzhalter (Stamp: WebView, stamp-composer.blp:287-297).
      // #402: große abgerundete Karte mit Abstand wie die Mail-Karte (style.css .html-mail).
      Adw.Bin {
        vexpand: true;
        overflow: hidden;
        margin-start: 12;
        margin-end: 12;
        margin-bottom: 12;

        styles [
          "composer-card",
        ]

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: TextView body_view {
            wrap-mode: word_char;
            top-margin: 24;
            bottom-margin: 24;
            left-margin: 28;
            right-margin: 28;

            accessibility {
              label: _("Nachrichtentext");
            }

            buffer: TextBuffer {
              text: _("Hallo Jonas,\n\nfür das Hoffest am Samstag habe ich den Lageplan angehängt. Der Marktstand steht wie im letzten Jahr neben der Scheune, Aufbau ab 8 Uhr.\n\nKannst du bis Donnerstag Bescheid geben, ob ihr die Bänke mitbringt?\n\nViele Grüße\nLena\n\n-- \nLena Hoffmann\nHofladen Hoffmann · Lindenweg 4 · 12345 Musterstadt");
            };
          };
        };
      }
    };

    // Formatierungsleiste unten wie Stamp ([bottom] Adw.WrapBox button_bar,
    // stamp-composer.blp:300-420); Auswahl laut Briefing 1.3.
    [bottom]
    Adw.WrapBox format_bar {
      child-spacing: 6;
      line-spacing: 6;
      margin-top: 0;
      margin-bottom: 6;
      margin-start: 12;
      margin-end: 12;

      // #402: Absatzformat (Arnd 22.10.), Auswahlliste in Nautilus-Optik wie Von/Signatur;
      // Platzhalter-Aktion composer.heading (composer.c).
      DropDown heading_dropdown {
        tooltip-text: _("Absatzformat");
        valign: center;

        styles [
          "composer-dropdown",
        ]

        model: StringList {
          strings [
            _("Text"),
            _("Überschrift 1"),
            _("Überschrift 2"),
            _("Überschrift 3"),
          ]
        };

        accessibility {
          label: _("Absatzformat");
        }
      }

      Separator {
        orientation: vertical;
        margin-top: 6;
        margin-bottom: 6;
      }

      ToggleButton {
        icon-name: "format-text-bold-symbolic";
        tooltip-text: _("Fett (Strg+B)");
        action-name: "composer.bold";

        accessibility {
          label: _("Fett");
        }

        styles [
          "flat",
        ]
      }

      ToggleButton {
        icon-name: "format-text-italic-symbolic";
        tooltip-text: _("Kursiv (Strg+I)");
        action-name: "composer.italic";

        accessibility {
          label: _("Kursiv");
        }

        styles [
          "flat",
        ]
      }

      ToggleButton {
        icon-name: "format-text-underline-symbolic";
        tooltip-text: _("Unterstrichen (Strg+U)");
        action-name: "composer.underline";

        accessibility {
          label: _("Unterstrichen");
        }

        styles [
          "flat",
        ]
      }

      ToggleButton {
        icon-name: "format-text-strikethrough-symbolic";
        tooltip-text: _("Durchgestrichen");
        action-name: "composer.strikethrough";

        accessibility {
          label: _("Durchgestrichen");
        }

        styles [
          "flat",
        ]
      }

      Separator {
        orientation: vertical;
        margin-top: 6;
        margin-bottom: 6;
      }

      ToggleButton {
        icon-name: "view-list-bullet-symbolic";
        tooltip-text: _("Aufzählung");
        action-name: "composer.bullet-list";

        accessibility {
          label: _("Aufzählung");
        }

        styles [
          "flat",
        ]
      }

      ToggleButton {
        icon-name: "view-list-ordered-symbolic";
        tooltip-text: _("Nummerierung");
        action-name: "composer.numbered-list";

        accessibility {
          label: _("Nummerierung");
        }

        styles [
          "flat",
        ]
      }

      Separator {
        orientation: vertical;
        margin-top: 6;
        margin-bottom: 6;
      }

      Button {
        icon-name: "insert-link-symbolic";
        tooltip-text: _("Link einfügen");
        action-name: "composer.insert-link";

        accessibility {
          label: _("Link einfügen");
        }

        styles [
          "flat",
        ]
      }
    }
  };
}

// Einheitliche Zeilenhöhe der Felder wie Stamp (stamp-composer.blp:579-589).
SizeGroup {
  mode: vertical;

  widgets [
    to_entry,
    cc_entry,
    bcc_entry,
    subject_entry,
    from_dropdown,
  ]
}

// #402: Hauptmenü des Composers (Arnd 22.10.). Emoji-Kürzel Strg+. ist die
// eingebaute Belegung von GtkTextView::insert-emoji (Gtk-4.0.gir).
menu composer_menu {
  section {
    item {
      label: _("_Kopie anzeigen");
      action: "composer.show-cc";
    }

    item {
      label: _("_Blindkopie anzeigen");
      action: "composer.show-bcc";
    }
  }

  section {
    item {
      label: _("_Text-Mail");
      action: "composer.mail-format";
      target: "text";
    }

    item {
      label: _("_HTML-Mail");
      action: "composer.mail-format";
      target: "html";
    }
  }

  section {
    item {
      label: _("_Emoji einfügen…");
      action: "composer.insert-emoji";
      accel: "<primary>period";
    }
  }
}

// #402: Beschriftungsspalte bleibt gleich breit, auch wenn Kopie/Blindkopie
// ausgeblendet sind (sonst springen die Werte nach links).
SizeGroup {
  mode: horizontal;

  widgets [
    to_label,
    cc_label,
    bcc_label,
    subject_label,
    from_label,
  ]
}
