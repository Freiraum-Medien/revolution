using Gtk 4.0;
using Adw 1;

// Composer (Prototyp #337, Briefing 1.3). Vorlage
// quelltext/stamp/src/views/mail/composer/stamp-composer.blp, Apple V5.
// #359: Logik in composer.c (Neu, Antworten, Allen antworten, Editor). #360: Absender, Signatur, Anhänge, Entwurf.
template $RevolutionComposer: Adw.ApplicationWindow {
  styles [
    "composer",
  ]

  title: _("New Message");
  default-width: 960;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  // Kürzel wie Stamp (stamp-composer.c:2376-2389): Strg+Enter Senden;
  // Fangphase, damit das Textfeld sie nicht verschluckt.
  // Strg+B/I/U für die Formatierungsleiste.
  ShortcutController {
    propagation-phase: capture;

    Shortcut {
      trigger: "<primary>Return";
      action: "action(composer.send)";
    }

    Shortcut {
      trigger: "<primary>b";
      action: "action(composer.bold)";
    }

    Shortcut {
      trigger: "<primary>i";
      action: "action(composer.italic)";
    }

    Shortcut {
      trigger: "<primary>u";
      action: "action(composer.underline)";
    }

    // #360: Entwurf speichern (Strg+S) und Anhang (Strg+M) wie Evolution (e-composer-actions.c:369-374, 448-454).
    Shortcut {
      trigger: "<primary>s";
      action: "action(composer.save-draft)";
    }

    Shortcut {
      trigger: "<primary>m";
      action: "action(composer.attach)";
    }

    // #359: Emoji an der Schreibmarke im Editor wie Stamp (stamp-composer.c:2382-2383).
    Shortcut {
      trigger: "<primary>period";
      action: "action(composer.insert-emoji)";
    }
  }

  // Escape schließt den Composer, in der Standardphase (bubble): Ein offenes
  // Popover (Von, Signatur) verbraucht Escape zuerst und schließt nur sich.
  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }
  }

  // #359: Fehler als AdwToast (Architektur 3).
  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      // #402: Formatierungsleiste flach auf dem Fensterhintergrund wie die Mail-Ansicht.
      bottom-bar-style: flat;
      reveal-bottom-bars: bind format_button.active;

      [top]
      Adw.HeaderBar {
        // Briefing 1.3: Titel = Betreff bzw. „Neue E-Mail“ (stamp-composer.blp:17-19).
        title-widget: Adw.WindowTitle window_title {
          title: _("New Message");
        };

        // #402 (Arnd 22.10.): Hauptmenü oben links, ausdrücklich abweichend von HIG
        // („Ende“). Klasse primary-menu: Nautilus-Optik aus style.css (#401 Punkt 2).
        [start]
        MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: composer_menu;
          primary: true;

          accessibility {
            label: _("Main Menu");
          }

          styles [
            "primary-menu",
          ]
        }

        // Briefing 1.3 (Vorschlag): Anhang und Formatierung ein/aus am Anfang.
        [start]
        Button {
          icon-name: "mail-attachment-symbolic";
          tooltip-text: _("Add Attachment (Ctrl+M)");
          action-name: "composer.attach";

          accessibility {
            label: _("Add Attachment");
          }
        }

        [start]
        ToggleButton format_button {
          icon-name: "format-text-rich-symbolic";
          tooltip-text: _("Show Formatting");
          active: true;

          accessibility {
            label: _("Show Formatting");
          }
        }

        // Senden mit suggested-action (stamp-composer.blp:37-49).
        [end]
        // #402: Symbolknopf auf Akzentfläche statt Textknopf (Arnd 22.10.).
        Button {
          icon-name: "sent-symbolic";
          tooltip-text: _("Send (Ctrl+Enter)");
          action-name: "composer.send";

          accessibility {
            label: _("Send");
          }

          styles [
            "suggested-action",
          ]
        }
      }

      // #402: Designsprache der Mail-Ansicht (mail-view.blp): Felder frei auf dem
      // Fensterhintergrund wie der Mailkopf, darunter der Text als große abgerundete Karte.
      content: Box {
        orientation: vertical;

        // Felder untereinander mit Trennlinien (stamp-composer.blp:61-285),
        // Reihenfolge wie Apple V5: An, Kopie, Betreff, Von + Signatur.
        Grid {
          column-spacing: 12;
          row-spacing: 3;
          margin-start: 12;
          margin-end: 12;

          styles [
            "composer-fields",
          ]

          Label to_label {
            label: _("To");
            halign: start;
            xalign: 0;
            margin-start: 12;

            styles [
              "dimmed",
            ]

            layout {
              column: 0;
              row: 0;
            }
          }

          Entry to_entry {
            hexpand: true;

            accessibility {
              labelled-by: to_label;
            }

            styles [
              "flat",
            ]

            layout {
              column: 1;
              column-span: 2;
              row: 0;
            }
          }

          // #402: Kopie und Blindkopie getrennt über das Hauptmenü (composer.show-cc,
          // composer.show-bcc schalten die Sichtbarkeit der Felder, composer.c).
          Separator {
            visible: bind cc_entry.visible;

            layout {
              column: 0;
              column-span: 3;
              row: 1;
            }
          }

          Label cc_label {
            label: _("Cc");
            halign: start;
            xalign: 0;
            margin-start: 12;
            visible: bind cc_entry.visible;

            styles [
              "dimmed",
            ]

            layout {
              column: 0;
              row: 2;
            }
          }

          Entry cc_entry {

            accessibility {
              labelled-by: cc_label;
            }

            styles [
              "flat",
            ]

            layout {
              column: 1;
              column-span: 2;
              row: 2;
            }
          }

          Separator {
            visible: bind bcc_entry.visible;

            layout {
              column: 0;
              column-span: 3;
              row: 3;
            }
          }

          Label bcc_label {
            label: _("Bcc");
            halign: start;
            xalign: 0;
            margin-start: 12;
            visible: bind bcc_entry.visible;

            styles [
              "dimmed",
            ]

            layout {
              column: 0;
              row: 4;
            }
          }

          Entry bcc_entry {
            accessibility {
              labelled-by: bcc_label;
            }

            styles [
              "flat",
            ]

            layout {
              column: 1;
              column-span: 2;
              row: 4;
            }
          }

          Separator {
            layout {
              column: 0;
              column-span: 3;
              row: 5;
            }
          }

          Label subject_label {
            label: _("Subject");
            halign: start;
            xalign: 0;
            margin-start: 12;

            styles [
              "dimmed",
            ]

            layout {
              column: 0;
              row: 6;
            }
          }

          Entry subject_entry {

            accessibility {
              labelled-by: subject_label;
            }

            styles [
              "flat",
            ]

            layout {
              column: 1;
              column-span: 2;
              row: 6;
            }
          }

          Separator {
            layout {
              column: 0;
              column-span: 3;
              row: 7;
            }
          }

          Label from_label {
            label: _("From");
            halign: start;
            xalign: 0;
            margin-start: 12;

            styles [
              "dimmed",
            ]

            layout {
              column: 0;
              row: 8;
            }
          }

          // Identität wählbar (stamp-composer.blp:80, DropDown from); #360: Einträge aus composer.c
          // (list_identities).
          DropDown from_dropdown {
            halign: start;
            valign: center;

            styles [
              "composer-dropdown",
            ]

            model: StringList from_list {};

            accessibility {
              labelled-by: from_label;
            }

            layout {
              column: 1;
              row: 8;
            }
          }

          // Signatur rechts in der Von-Zeile wie Apple V5 („Signatur: Ohne“).
          Box {
            spacing: 6;
            halign: end;
            valign: center;
            margin-end: 6;

            Label signature_label {
              label: _("Signature");

              styles [
                "dimmed",
              ]
            }

            // #360: weitere Einträge aus ESourceMailSignature (composer.c, list_signatures).
            DropDown signature_dropdown {
              styles [
                "composer-dropdown",
              ]

              model: StringList signature_list {
                strings [
                  _("None"),
                ]
              };

              accessibility {
                labelled-by: signature_label;
              }
            }

            layout {
              column: 2;
              row: 8;
            }
          }

          Separator {
            layout {
              column: 0;
              column-span: 3;
              row: 9;
            }
          }
        }

        // #360: Anhänge als Pillen wie Prototyp composer-hell.png und der Lesebereich (mail-attachment.blp),
        // waagrechte ListView (Architektur 2) statt Stamps WrapBox (stamp-composer.blp:270-284), mit Entfernen.
        ScrolledWindow attachment_bar {
          visible: false;
          vscrollbar-policy: never;
          propagate-natural-height: true;
          margin-start: 12;
          margin-end: 12;
          margin-top: 6;
          margin-bottom: 8;

          child: ListView attachment_list {
            orientation: horizontal;
            tab-behavior: item;

            styles [
              "mail-attachments",
            ]

            accessibility {
              label: _("Attachments");
            }

            factory: BuilderListItemFactory {
              template ListItem {
                activatable: false;
                accessible-label: bind template.item as <$RevolutionMailAttachment>.accessible-label;

                child: Box {
                  spacing: 8;
                  tooltip-text: bind template.item as <$RevolutionMailAttachment>.name;

                  styles [
                    "mail-attachment",
                    "composer-attachment",
                  ]

                  Image {
                    gicon: bind template.item as <$RevolutionMailAttachment>.icon;
                    accessible-role: presentation;
                  }

                  Label {
                    label: bind template.item as <$RevolutionMailAttachment>.short-name;
                  }

                  Label {
                    label: bind template.item as <$RevolutionMailAttachment>.size-text;

                    styles [
                      "numeric",
                      "dimmed",
                    ]
                  }

                  Button {
                    icon-name: "window-close-symbolic";
                    tooltip-text: _("Remove Attachment");
                    valign: center;
                    clicked => $on_remove_attachment(template);

                    accessibility {
                      label: _("Remove Attachment");
                    }

                    styles [
                      "flat",
                      "circular",
                    ]
                  }
                };
              }
            };
          };
        }

        // Nachrichtentext: WebView als Editor (Stamp stamp-composer.blp:287-297), eingesetzt in
        // composer.c (create_editor, a11y-Label „Nachrichtentext“).
        // #402: große abgerundete Karte mit Abstand wie die Mail-Karte (style.css .html-mail).
        Adw.Bin editor_bin {
          vexpand: true;
          overflow: hidden;
          margin-start: 12;
          margin-end: 12;
          margin-bottom: 12;

          styles [
            "composer-card",
          ]
        }
      };

      // Formatierungsleiste unten wie Stamp ([bottom] Adw.WrapBox button_bar,
      // stamp-composer.blp:300-420); Auswahl laut Briefing 1.3.
      [bottom]
      Adw.WrapBox format_bar {
        child-spacing: 6;
        line-spacing: 6;
        margin-top: 0;
        margin-bottom: 6;
        margin-start: 12;
        margin-end: 12;

        // #402: Absatzformat (Arnd 22.10.), Auswahlliste in Nautilus-Optik wie Von/Signatur;
        // #359: FormatBlock p/h1/h2/h3 (composer.c BLOCKS).
        // a11y: GtkDropDown nennt sich sonst nach dem gewählten Eintrag („Text“, gemessen über AT-SPI,
        // build/m5-359); labelled-by geht vor wie bei Signatur.
        Label paragraph_label {
          label: _("Paragraph Style");
          visible: false;
        }

        DropDown paragraph_dropdown {
          tooltip-text: _("Paragraph Style");
          valign: center;

          styles [
            "composer-dropdown",
          ]

          model: StringList {
            strings [
              _("Normal"),
              _("Heading 1"),
              _("Heading 2"),
              _("Heading 3"),
            ]
          };

          accessibility {
            labelled-by: paragraph_label;
          }
        }

        Separator {
          orientation: vertical;
          margin-top: 6;
          margin-bottom: 6;
        }

        ToggleButton {
          icon-name: "format-text-bold-symbolic";
          tooltip-text: _("Bold (Ctrl+B)");
          action-name: "composer.bold";

          accessibility {
            label: _("Bold");
          }

          styles [
            "flat",
          ]
        }

        ToggleButton {
          icon-name: "format-text-italic-symbolic";
          tooltip-text: _("Italic (Ctrl+I)");
          action-name: "composer.italic";

          accessibility {
            label: _("Italic");
          }

          styles [
            "flat",
          ]
        }

        ToggleButton {
          icon-name: "format-text-underline-symbolic";
          tooltip-text: _("Underline (Ctrl+U)");
          action-name: "composer.underline";

          accessibility {
            label: _("Underline");
          }

          styles [
            "flat",
          ]
        }

        ToggleButton {
          icon-name: "format-text-strikethrough-symbolic";
          tooltip-text: _("Strikethrough");
          action-name: "composer.strikethrough";

          accessibility {
            label: _("Strikethrough");
          }

          styles [
            "flat",
          ]
        }

        Separator {
          orientation: vertical;
          margin-top: 6;
          margin-bottom: 6;
        }

        ToggleButton {
          icon-name: "view-list-bullet-symbolic";
          tooltip-text: _("Bulleted List");
          action-name: "composer.bullet-list";

          accessibility {
            label: _("Bulleted List");
          }

          styles [
            "flat",
          ]
        }

        ToggleButton {
          icon-name: "view-list-ordered-symbolic";
          tooltip-text: _("Numbered List");
          action-name: "composer.numbered-list";

          accessibility {
            label: _("Numbered List");
          }

          styles [
            "flat",
          ]
        }

        Separator {
          orientation: vertical;
          margin-top: 6;
          margin-bottom: 6;
        }

        Button {
          icon-name: "insert-link-symbolic";
          tooltip-text: _("Insert Link");
          action-name: "composer.insert-link";

          accessibility {
            label: _("Insert Link");
          }

          styles [
            "flat",
          ]
        }
      }
    };
  };
}

// Einheitliche Zeilenhöhe der Felder wie Stamp (stamp-composer.blp:579-589).
SizeGroup {
  mode: vertical;

  widgets [
    to_entry,
    cc_entry,
    bcc_entry,
    subject_entry,
    from_dropdown,
  ]
}

// #402: Hauptmenü des Composers (Arnd 22.10.). Emoji-Kürzel Strg+. oben im ShortcutController (#359).
menu composer_menu {
  section {
    item {
      label: _("Show _Cc");
      action: "composer.show-cc";
    }

    item {
      label: _("Show _Bcc");
      action: "composer.show-bcc";
    }
  }

  section {
    item {
      label: _("Plain _Text");
      action: "composer.mail-format";
      target: "text";
    }

    item {
      label: _("_HTML");
      action: "composer.mail-format";
      target: "html";
    }
  }

  section {
    item {
      label: _("Save as _Draft");
      action: "composer.save-draft";
      accel: "<primary>s";
    }

    item {
      label: _("_Add Attachment…");
      action: "composer.attach";
      accel: "<primary>m";
    }
  }

  section {
    item {
      label: _("Insert _Emoji…");
      action: "composer.insert-emoji";
      accel: "<primary>period";
    }
  }
}

// #402: Beschriftungsspalte bleibt gleich breit, auch wenn Kopie/Blindkopie
// ausgeblendet sind (sonst springen die Werte nach links).
SizeGroup {
  mode: horizontal;

  widgets [
    to_label,
    cc_label,
    bcc_label,
    subject_label,
    from_label,
  ]
}
