                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Jour fixe Nordlicht");
                            xalign: 0;
                            ellipsize: end;
                          }

                          Label {
                            label: _("Montag, 19. Oktober, 10:00 – 11:00 · Besprechungsraum 3");
                            xalign: 0;
