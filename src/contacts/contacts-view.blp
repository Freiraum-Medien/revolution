// Kontakte-Ansicht, Prototyp #338. Ohne Logik, Beispieldaten aus contacts-sample.c.
// Aufbau nach quelltext/stamp/src/views/contact/stamp-contact-view.blp:4-185 und
// mail-view.blp (Briefing 1.4); Design-Referenz GNOME Contacts 49.0.
// #402: Designsprache der Mail-Ansicht (#399–#401) übernommen, Muster jeweils
// aus mail-view.blp, CSS-Klassen aus style.css wiederverwendet.
using Gtk 4.0;
using Adw 1;

template $RevolutionContactsView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #402 wie mail-view.blp: Strg+F öffnet die Suche in der Kopfleiste des Kontakts,
  // F9 schaltet die Seitenleiste. Scope local: wirkt nur auf der Kontakte-Seite.
  // Strg+N wie GNOME Contacts (contacts-main-window.ui: <Control>n → win.new-contact).
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(contacts.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(contacts.sidebar)";
    }

    Shortcut {
      trigger: "<primary>n";
      action: "action(contact.new)";
    }

    Shortcut {
      trigger: "<primary>comma";
      action: "action(contacts.preferences)";
    }

    Shortcut {
      trigger: "<primary>question";
      action: "action(contacts.shortcuts)";
    }
  }

  // Wie mail-view.blp: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“
  // (stamp-contact-view.blp:8-26). Werte wie mail-view.blp (schwebende Seitenleiste).
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      new_spacer.visible: false;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      contacts_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Wie mail-view.blp: Neu wandert schmal in die Kopfleiste der Liste.
      list_new_button.visible: true;
      new_button.visible: false;
      new_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView contacts_layout {
    // Seitenleiste: Adressbücher je Konto als GtkListView mit navigation-sidebar,
    // gleich wie die Ordnerliste in mail-view.blp (CR #397) und Stamp
    // stamp-book-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle {
          title: _("Revolution");
        };

        // #402: Primärmenü wie mail-view.blp (Nautilus-Optik, style.css .primary-menu).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";

          styles [
            "primary-menu",
          ]

          tooltip-text: _("Hauptmenü");
          menu-model: primary_menu;

          accessibility {
            label: _("Hauptmenü");
          }
        }
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // Viewport wie mail-view.blp: sonst fehlt beim Start der erste Abschnittskopf.
        // Scrollen zum Fokus übernimmt contacts-view.c (Umschalter liegt darüber).
        child: Viewport book_viewport {
          scroll-to-focus: false;

          child: ListView book_list {
            tab-behavior: item;

            // folder-list: unterer Innenabstand = Höhe des Umschalters (style.css).
            styles [
              "navigation-sidebar",
              "folder-list",
            ]

            accessibility {
              label: _("Adressbücher");
            }

            model: SingleSelection book_selection {};

            header-factory: BuilderListItemFactory {
              template ListHeader {
                child: Label {
                  label: bind template.item as <$RevolutionContactsSampleEntry>.group;
                  xalign: 0;
                  margin-start: 14;
                  margin-end: 14;
                  margin-top: 12;
                  margin-bottom: 6;
                  ellipsize: end;

                  styles [
                    "caption-heading",
                    "dimmed",
                  ]
                };
              }
            };

            factory: BuilderListItemFactory {
              template ListItem {
                child: Box {
                  spacing: 12;

                  Image {
                    icon-name: "x-office-address-book-symbolic";
                    accessible-role: presentation;
                  }

                  Label {
                    label: bind template.item as <$RevolutionContactsSampleEntry>.title;
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                };
              }
            };
          };
        };
      };
    }

    // Kontaktliste: Avatar + Name (stamp-contact-row.blp:15-18), Abschnitte je
    // Anfangsbuchstabe (Briefing 1.4).
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // Wie mail-view.blp: Knopf immer sichtbar, F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Seitenleiste ein-/ausblenden");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Seitenleiste ein-/ausblenden");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste des Kontakts.
        // GNOME Contacts: „Add New Contact“, list-add-symbolic (contacts-main-window.ui).
        [start]
        Button list_new_button {
          visible: false;
          icon-name: "list-add-symbolic";
          tooltip-text: _("Neuer Kontakt");
          action-name: "contact.new";

          accessibility {
            label: _("Neuer Kontakt");
          }
        }

        // Titel linksbündig wie mail-view.blp (zwei Labels, Stilklassen aus HIG-TY).
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          Label {
            label: _("Persönlich");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          Label {
            label: _("12 Kontakte");
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // Viewport: ohne ihn fehlt beim Start der Abschnittskopf „A“ (headless
        // geprüft). Ursache klären in #350, Virtualisierung geht verloren.
        // #402: Auswahl als abgerundete Akzentfläche wie die Nachrichtenliste
        // (style.css .contact-list), ohne Trennlinien.
        child: Viewport {
          child: ListView contact_list {
            tab-behavior: item;

            styles [
              "contact-list",
            ]

            accessibility {
              label: _("Kontakte");
            }

            model: SingleSelection contact_selection {};

            header-factory: BuilderListItemFactory {
              template ListHeader {
                child: Label {
                  label: bind template.item as <$RevolutionContactsSampleEntry>.group;
                  xalign: 0;
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 6;
                  margin-bottom: 3;

                  styles [
                    "caption-heading",
                    "dimmed",
                  ]
                };
              }
            };

            factory: BuilderListItemFactory {
              template ListItem {
                child: Box {
                  spacing: 12;

                  // 32 px statt 48 (stamp-contact-row.blp:15-18): Platz bei 1280×800.
                  // presentation: der Name steht im Label daneben, sonst doppelt vorgelesen.
                  Adw.Avatar {
                    size: 32;
                    show-initials: true;
                    accessible-role: presentation;
                    text: bind template.item as <$RevolutionContactsSampleEntry>.title;
                  }

                  Label {
                    label: bind template.item as <$RevolutionContactsSampleEntry>.title;
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                };
              }
            };
          };
        };
      };
    }

    // Kontakt: Kopfleiste mit Aktionen und Suche wie mail-view.blp, Kopf frei auf dem
    // Hintergrund, Inhalt als große abgerundete Karte bis zum unteren Rand (wie die
    // Nachricht, Vorbild 03). Felder nach stamp-contact-details.blp:40-112.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // „Lights off“ wie mail-view.blp: Gtk.Stack wechselt von den Aktionen zum
      // Suchfeld, Umschalten in contacts-view.c. Fensterknöpfe als Gtk.WindowControls
      // im Titel (Begründung in mail-view.blp).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button new_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("Neuer Kontakt");
                  action-name: "contact.new";

                  accessibility {
                    label: _("Neuer Kontakt");
                  }
                }

                Separator new_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Box {
                  hexpand: true;
                }

                Button {
                  icon-name: "document-edit-symbolic";
                  tooltip-text: _("Kontakt bearbeiten");
                  action-name: "contact.edit";

                  accessibility {
                    label: _("Kontakt bearbeiten");
                  }
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Kontakte durchsuchen");
                key-capture-widget: list_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("Kontakte durchsuchen");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      content: Box {
        orientation: vertical;

        // Kopf wie der Nachrichtenkopf in mail-view.blp: nur der Name halbfett
        // (style.css .mail-sender), Adressbuch klein und grau wie dort der Ordner.
        Box {
          spacing: 12;
          margin-start: 24;
          margin-end: 18;
          margin-top: 14;
          margin-bottom: 14;

          Adw.Avatar {
            size: 48;
            valign: center;
            show-initials: true;
            text: _("Anna Behrens");
          }

          Box {
            orientation: vertical;
            valign: center;
            hexpand: true;
            spacing: 2;

            Label {
              label: _("Anna Behrens");
              xalign: 0;
              ellipsize: end;
              selectable: true;

              styles [
                "mail-sender",
              ]
            }

            Box {
              spacing: 6;

              Image {
                icon-name: "x-office-address-book-symbolic";
                tooltip-text: _("Adressbuch");

                accessibility {
                  label: _("Adressbuch");
                }

                styles [
                  "dimmed",
                ]
              }

              Label {
                label: _("Persönlich");
                xalign: 0;
                ellipsize: end;

                styles [
                  "dimmed",
                ]
              }
            }
          }

          // Aktion „Mail schreiben“ (OP #338, öffnet später den Composer, OP #369).
          // Pille wie „Laden“ im Hinweis der Mail-Ansicht (style.css .mail-notice-button).
          Button {
            valign: center;
            action-name: "contact.write-mail";
            tooltip-text: _("Mail an Anna Behrens schreiben");

            child: Adw.ButtonContent {
              icon-name: "mail-message-new-symbolic";
              label: _("Mail schreiben");
            };

            styles [
              "mail-notice-button",
            ]
          }
        }

        // Karte wie .html-mail in mail-view.blp (Radius, Kontur, Schatten, Abstände),
        // Fläche in der Kartenfarbe des Designs (style.css .contact-card).
        Adw.Bin {
          vexpand: true;
          overflow: hidden;
          margin-start: 12;
          margin-end: 12;
          margin-bottom: 12;

          styles [
            "contact-card",
          ]

          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 620;
              tightening-threshold: 480;
              margin-start: 28;
              margin-end: 28;
              margin-top: 28;
              margin-bottom: 36;

              // Je Feld: kleines graues Symbol, Art klein und grau, Wert normal.
              child: Box {
                orientation: vertical;
                spacing: 18;

                Box {
                  spacing: 12;

                  Image {
                    icon-name: "mail-unread-symbolic";
                    valign: start;
                    margin-top: 2;
                    tooltip-text: _("E-Mail");

                    accessibility {
                      label: _("E-Mail");
                    }

                    styles [
                      "dimmed",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    spacing: 12;

                    Box {
                      orientation: vertical;

                      Label {
                        label: _("Privat");
                        xalign: 0;

                        styles [
                          "caption",
                          "dimmed",
                        ]
                      }

                      Label {
                        label: "anna.behrens@example.org";
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        selectable: true;
                      }
                    }

                    Box {
                      orientation: vertical;

                      Label {
                        label: _("Arbeit");
                        xalign: 0;

                        styles [
                          "caption",
                          "dimmed",
                        ]
                      }

                      Label {
                        label: "behrens@albrecht-partner.example";
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        selectable: true;
                      }
                    }
                  }
                }

                Box {
                  spacing: 12;

                  Image {
                    icon-name: "phone-symbolic";
                    valign: start;
                    margin-top: 2;
                    tooltip-text: _("Telefon");

                    accessibility {
                      label: _("Telefon");
                    }

                    styles [
                      "dimmed",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    hexpand: true;

                    Label {
                      label: _("Mobil");
                      xalign: 0;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }

                    Label {
                      label: "+49 170 0000123";
                      xalign: 0;
                      selectable: true;

                      styles [
                        "numeric",
                      ]
                    }
                  }
                }

                Box {
                  spacing: 12;

                  Image {
                    icon-name: "mark-location-symbolic";
                    valign: start;
                    margin-top: 2;
                    tooltip-text: _("Adresse");

                    accessibility {
                      label: _("Adresse");
                    }

                    styles [
                      "dimmed",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    hexpand: true;

                    Label {
                      label: _("Privat");
                      xalign: 0;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }

                    Label {
                      label: _("Am Mühlbach 7\n12345 Musterstadt");
                      xalign: 0;
                      wrap: true;
                      selectable: true;
                    }
                  }
                }

                Box {
                  spacing: 12;

                  Image {
                    icon-name: "system-users-symbolic";
                    valign: start;
                    margin-top: 2;
                    tooltip-text: _("Organisation");

                    accessibility {
                      label: _("Organisation");
                    }

                    styles [
                      "dimmed",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    hexpand: true;

                    Label {
                      label: _("Projektleiterin");
                      xalign: 0;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }

                    Label {
                      label: _("Albrecht und Partner Architekten");
                      xalign: 0;
                      wrap: true;
                      selectable: true;
                    }
                  }
                }
              };
            };
          };
        }
      };
    }

    // Ansichtsumschalter wie mail-view.blp (#400/#401): schwebt über der
    // Adressbuchliste, nur Symbole, Seitentitel als Tooltip (contacts-view.c).
    // valign end auf dem Slot: sonst deckt der Slot die ganze Liste ab und schluckt Klicks.
    [switcher]
    Adw.Bin switcher {
      valign: end;
      margin-start: 8;
      margin-end: 8;
      margin-top: 8;
      margin-bottom: 8;

      styles [
        "floating-switcher",
      ]

      child: Adw.ViewSwitcher {
        policy: narrow;
        stack: bind template.stack;
        has-tooltip: true;
        query-tooltip => $on_switcher_query_tooltip() swapped;
      };
    }

    // Breit: Seitenleiste | Liste | Kontakt (stamp-contact-view.blp:57-96).
    // Schmal (≤ 1000 sp): Seitenleiste als Überlagerung, Werte per Breakpoint oben.
    // Klasse mail-split und schwebende Seitenleiste wie mail-view.blp (style.css).
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 236;
        max-sidebar-width: 296;

        styles [
          "mail-split",
        ]

        sidebar: Overlay {
          overflow: hidden;
          margin-start: 8;
          margin-end: 8;
          margin-top: 8;
          margin-bottom: 8;

          styles [
            "floating-sidebar",
          ]

          child: Adw.LayoutSlot {
            id: "sidebar";
          };

          [overlay]
          Adw.LayoutSlot {
            id: "switcher";
            valign: end;
          }
        };

        content: Paned {
          position: 320;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Kontakt (stamp-contact-view.blp:139-178).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Kontakte");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.ToolbarView {
              content: Adw.LayoutSlot {
                id: "list";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "switcher";
              }
            };
          };
        }

        Adw.NavigationPage {
          title: _("Kontakt");
          tag: "contact";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

// #402: Primärmenü wie mail-view.blp (Gruppen als Abschnitte, Kürzel rechts über
// das accel-Attribut). Erster Eintrag Neuer Kontakt statt Neue E-Mail, da Strg+N
// hier einen Kontakt anlegt (GNOME Contacts).
menu primary_menu {
  section {
    item {
      label: _("_Neuer Kontakt");
      action: "contact.new";
      accel: "<primary>n";
    }

    item {
      label: _("_Suchen");
      action: "contacts.search";
      accel: "<primary>f";
    }
  }

  // Ohne Haken wie mail-view.blp: zustandslose Aktion contacts.toggle-sidebar.
  section {
    item {
      label: _("Seiten_leiste ein-/ausblenden");
      action: "contacts.toggle-sidebar";
      accel: "F9";
    }
  }

  section {
    item {
      label: _("_Einstellungen");
      action: "contacts.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Tastenkürzel");
      action: "contacts.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_Info zu Revolution");
      action: "contacts.about";
    }
  }
}
