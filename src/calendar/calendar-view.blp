// Kalender-Ansicht (Prototyp #339, #373). Aufbau nach quelltext/gnome-calendar/src/gui/gcal-window.blp:135-348
// (GNOME Calendar 50.0, Briefing 1.5); Seitenleiste und Umschalter wie mail/mail-view.blp.
// #373: Monat = GcalMonthView aus gnome-calendar 50.0 (src/calendar/gcal). #374: Woche = GcalWeekView,
// Tag = GcalWeekView mit 1 Spalte (n-days, gnome-calendar 50.0 hat keine Tagesansicht).
using Gtk 4.0;
using Adw 1;

template $RevolutionCalendarView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;
  // Kürzel wie GNOME Calendar (gcal-window.blp:11-75, F9 :181-188), Aktionen in
  // calendar-view.c. Scope local: wirken nur auf der Kalender-Seite.
  ShortcutController {
    Shortcut {
      trigger: "<Control>t";
      action: "action(calendar.today)";
    }

    Shortcut {
      trigger: "Home";
      action: "action(calendar.today)";
    }

    // #373: wie gcal-window.blp:17-20.
    Shortcut {
      trigger: "<Alt>Down";
      action: "action(calendar.today)";
    }

    Shortcut {
      trigger: "<Alt>Left";
      action: "action(calendar.previous)";
    }

    Shortcut {
      trigger: "Page_Up";
      action: "action(calendar.previous)";
    }

    Shortcut {
      trigger: "<Alt>Right";
      action: "action(calendar.next)";
    }

    Shortcut {
      trigger: "Page_Down";
      action: "action(calendar.next)";
    }

    Shortcut {
      trigger: "<Alt>1";
      action: "action(calendar.view)";
      arguments: "'month'";
    }

    Shortcut {
      trigger: "<Alt>2";
      action: "action(calendar.view)";
      arguments: "'week'";
    }

    // #374: Alt+3 in gnome-calendar die dritte Ansicht (gcal-window.blp:71-75), hier der Tag;
    // Strg+Bild ab/auf nächste/vorige Ansicht wie gcal-window.blp:47-57.
    Shortcut {
      trigger: "<Alt>3";
      action: "action(calendar.view)";
      arguments: "'day'";
    }

    Shortcut {
      trigger: "<Control>Page_Down";
      action: "action(calendar.switch-view)";
      arguments: "1";
    }

    Shortcut {
      trigger: "<Control>Page_Up";
      action: "action(calendar.switch-view)";
      arguments: "-1";
    }

    Shortcut {
      trigger: "<Control>n";
      action: "action(calendar.new-event)";
      arguments: "''";
    }

    // #375: Entf löscht den Termin mit offenem Popover bzw. Fokus (calendar-view.c on_delete_event).
    Shortcut {
      trigger: "Delete";
      action: "action(calendar.delete-event)";
    }

    Shortcut {
      trigger: "<Control>f";
      action: "action(calendar.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(calendar.sidebar)";
    }

    // #402: Kürzel der Hauptmenü-Einträge wie Mail (mail-view.blp:26-43).
    Shortcut {
      trigger: "<Control>comma";
      action: "action(calendar.preferences)";
    }

    Shortcut {
      trigger: "<Control>question";
      action: "action(calendar.shortcuts)";
    }
  }

  // Wie Mail (mail-view.blp:10-23) und GNOME Calendar (gcal-window.blp:323-330):
  // ≤ 1000 sp Seitenleiste als Überlagerung.
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      // #402: Breiten wie Mail (mail-view.blp:53-57).
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      view_switcher.policy: narrow;
    }
  }

  // #454: Sehr schmal ist kein Platz für den Ausgleich links vom Umschalter (Kopfleiste). Es gilt nur der
  // zuletzt passende Breakpoint (mail-view.blp), daher die Werte von oben noch einmal.
  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      view_switcher.policy: narrow;
      header_spacer.visible: false;
    }
  }

  // #402: Breiten und Klasse mail-split wie Mail (mail-view.blp:1033-1040, style.css).
  child: Adw.OverlaySplitView split {
    sidebar-width-fraction: 0.22;
    min-sidebar-width: 236;
    max-sidebar-width: 296;

    styles [
      "mail-split",
    ]

    // #402: Seitenleiste als schwebende, abgerundete Fläche mit Abstand zum Fensterrand
    // (wie mail-view.blp).
    sidebar: Adw.Bin {
      overflow: hidden;
      margin-start: 8;
      margin-end: 8;
      margin-top: 8;
      margin-bottom: 8;

      styles [
        "floating-sidebar",
      ]

      // Seitenleiste: Monatsauswahl + Kalenderliste (gcal-window.blp:150-166).
      child: Overlay {
        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Box {
            orientation: vertical;

            // #454: Griff nur im leeren Kopfbereich (mail-view.blp), darüber das Hauptmenü.
            WindowHandle {
              styles [
                "sidebar-grip",
              ]
            }

            // GcalDateChooser ist ein eigenes C-Widget; hier Gtk.Calendar.
            // #340: oben 2px statt 6px, Monatsname auf der Linie (style.css „Eine Linie“).
            // #402: ohne eigenen Rahmen auf der Seitenleisten-Fläche (style.css .date-chooser).
            // Ohne year/month/day zeigt Gtk.Calendar den heutigen Tag.
            Calendar date_chooser {
              // #373: Auswahl eines Tages blättert die Monatsansicht dorthin (gcal-window.blp:161).
              day-selected => $on_day_selected() swapped;
              margin-start: 12;
              margin-end: 12;
              margin-top: 2;
              margin-bottom: 6;

              accessibility {
                label: _("Select Date");
              }

              styles [
                "date-chooser",
              ]
            }

            // Kalenderliste (gcal-calendar-list.blp:14-23), je Konto ein Abschnitt wie die
            // Adressbücher in contacts-view.blp (lokal zuerst, calendar_section in calendar-view.c),
            // darin nach Name. Farbe und Ein/Aus im Ankreuzfeld. #373: Kalender des GcalManager.
            ListView calendar_list {
              tab-behavior: item;

              // calendar-list: Abstand Ankreuzfeld–Name wie Symbol–Name der Ordnerliste (style.css).
              styles [
                "navigation-sidebar",
                "calendar-list",
              ]

              accessibility {
                label: _("Calendar");
              }

              model: NoSelection {
                model: SortListModel calendar_sorted {
                  section-sorter: StringSorter {
                    expression: expr $calendar_section(item as <$GcalCalendar>.parent-source) as <string>;
                  };

                  sorter: StringSorter {
                    expression: expr item as <$GcalCalendar>.name;
                  };
                };
              };

              header-factory: BuilderListItemFactory {
                template ListHeader {
                  child: Label {
                    label: bind template.item as <$GcalCalendar>.parent-source as <$ESource>.display-name;
                    xalign: 0;
                    margin-start: 14;
                    margin-end: 14;
                    margin-top: 4;
                    margin-bottom: 2;
                    ellipsize: end;

                    styles [
                      "caption-heading",
                      "dimmed",
                    ]
                  };
                }
              };

              factory: BuilderListItemFactory {
                template ListItem {
                  activatable: false;
                  accessible-label: bind template.item as <$GcalCalendar>.name;

                  // #373: Ein/Aus setzt GcalCalendar:visible (on_calendar_toggled), gespeichert in den
                  // Einstellungen der App (gcal-manager.c), nie in der ESource. Farbe über den
                  // Widget-Namen (calendar_color_name, CSS in calendar-view.c).
                  child: CheckButton {
                    label: bind template.item as <$GcalCalendar>.name;
                    active: bind template.item as <$GcalCalendar>.visible;
                    name: bind $calendar_color_name(template.item as <$GcalCalendar>.color) as <string>;
                    toggled => $on_calendar_toggled(template);
                    tooltip-text: _("Show or Hide Calendar");
                  };
                }
              };
            }
          };
        };

        // #454: Hauptmenü schwebt auf der Karte wie mail-view.blp (style.css .primary-menu).
        [overlay]
        MenuButton {
          halign: end;
          valign: start;
          margin-top: 6;
          margin-end: 6;
          primary: true;
          icon-name: "open-menu-symbolic";

          styles [
            "primary-menu",
            "flat",
            "circular",
          ]

          tooltip-text: _("Main Menu");
          menu-model: primary_menu;

          accessibility {
            label: _("Main Menu");
          }
        }
      };

    };

    // #402: Hauptbereich ohne Klasse .view auf dem Fensterhintergrund wie Mail (.mail-split).
    content: Adw.ToolbarView content_pane {
      // calendar-main: dunkle Trennlinien im Dunkelmodus (style.css).
      styles [
        "calendar-main",
      ]

      // Kopfleiste (gcal-window.blp:174-211). Titel = Monat und Jahr
      // (gcal-calendar-navigation-button.c:106, „%B %Y“).

      // #402: Aufbau wie die Kopfleiste der Mail-Nachricht: alles im Titel, damit der Titel
      // linksbündig direkt neben dem Seitenleisten-Knopf steht; Fensterknöpfe als
      // Gtk.WindowControls. #454: CenterBox: Umschalter mittig (mail-view.blp, title-widget der Liste).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Box {
          hexpand: true;
          spacing: 6;

          // #402 Runde 2: Suche wie Mail: „Lights off“, Gtk.Stack wechselt vom Knopf mit Titel
          // zum Suchfeld über die ganze Breite bis zur Lupe. Umschalten in calendar-view.c.
          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              // #454: Umschalter mittig wie die Liste in mail-view.blp. Die Seite endet vor Lupe und
              // Fensterknöpfen; header_spacer (SizeGroup unten, gleich breit) rückt ihn in die
              // Mitte der ganzen Kopfleiste.
              child: CenterBox {
                [start]
                Box {
                  spacing: 6;

                  // #402: Knopf immer sichtbar wie Mail; F9 oben im Controller.
                  ToggleButton sidebar_button {
                    icon-name: "sidebar-show-symbolic";
                    tooltip-text: _("Toggle Sidebar");
                    active: bind split.show-sidebar bidirectional;

                    styles [
                      "sidebar-toggle",
                    ]

                    accessibility {
                      label: _("Toggle Sidebar");
                    }
                  }

                  // Monat und Jahr setzt calendar-view.c (heute).
                  Label month_title {
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;

                    styles [
                      "heading",
                    ]
                  }
                }

                [center]
                Box {
                  spacing: 6;

                  Box header_spacer {}

                  Adw.InlineViewSwitcher {
                    valign: center;
                    stack: bind template.stack;
                    display-mode: icons;

                    styles [
                      "app-switcher",
                    ]
                  }
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Search Events");
                // Tippen im Hauptbereich startet die Suche (wie Mail, HIG-SE „type to search“).
                key-capture-widget: content_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("Search Events");
                }
              };
            }
          }

          Box header_end {
            spacing: 6;

            ToggleButton search_button {
              icon-name: "edit-find-symbolic";
              tooltip-text: _("Search");
              notify::active => $on_search_toggled() swapped;

              accessibility {
                label: _("Search");
              }
            }

            WindowControls {
              side: end;
            }
          }
        };
      }

      // #375: Fehler beim Verbinden eines Kalenders oder beim Schreiben als AdwBanner wie contacts-view.blp
      // (Architektur 3), kurzer Titel, Einzelheiten im Tooltip (calendar-view.c on_manager_error).
      [top]
      Adw.Banner banner {
        use-markup: false;
        // #375 (PM): Schließen blendet aus (wie contacts-view.c adw_banner_set_revealed FALSE).
        button-label: _("_Close");
        button-clicked => $on_banner_close() swapped;
      }

      // Monat, Woche und Tag (gcal-window.blp:213-247).
      content: Adw.ViewStack views {
        hexpand: true;
        vexpand: true;

        Adw.ViewStackPage {
          name: "month";
          title: _("_Month");
          use-underline: true;
          icon-name: "calendar-month-symbolic";

          // #373: GcalMonthView (gnome-calendar 50.0) mit Wochentagen, flüssigem Scrollen und
          // „+N“-Popover; Kontext und Timeline setzt calendar-view.c.
          child: $GcalMonthView month_view {
            // #375: Klick öffnet das Popover, Doppelklick/Ziehen legt an (calendar-view.c).
            event-activated => $on_event_activated();
            create-event => $on_create_event_at();
            create-event-detailed => $on_create_event();

            hexpand: true;
            vexpand: true;

            accessibility {
              label: _("Month");
            }
          };
        }

        Adw.ViewStackPage {
          name: "week";
          title: _("_Week");
          use-underline: true;
          icon-name: "calendar-week-symbolic";

          // #374: GcalWeekView (gnome-calendar 50.0) mit Zeitraster, Ganztagsleiste, Überlappungen
          // nebeneinander und Heute-Linie; Kontext und Timeline setzt calendar-view.c.
          child: $GcalWeekView week_view {
            // #375: Klick öffnet das Popover, Doppelklick/Ziehen legt an (calendar-view.c).
            event-activated => $on_event_activated();
            create-event => $on_create_event_at();
            create-event-detailed => $on_create_event();

            accessibility {
              label: _("Week");
            }
          };
        }

        // #374: Tag = GcalWeekView mit 1 Spalte; Verhalten wie Evolution e-day-view (ein Tag, Zeitraster,
        // ganztägige Termine oben).
        Adw.ViewStackPage {
          name: "day";
          title: _("_Day");
          use-underline: true;
          icon-name: "calendar-today-symbolic";

          child: $GcalWeekView day_view {
            // #375: Klick öffnet das Popover, Doppelklick/Ziehen legt an (calendar-view.c).
            event-activated => $on_event_activated();
            create-event => $on_create_event_at();
            create-event-detailed => $on_create_event();

            n-days: 1;

            accessibility {
              label: _("Day");
            }
          };
        }
      };

      // Untere Leiste (gcal-window.blp:265-315).

      [bottom]
      ActionBar {
        [start]
        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Previous");
          action-name: "calendar.previous";

          accessibility {
            label: _("Previous");
          }
        }

        [start]
        Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next");
          action-name: "calendar.next";

          accessibility {
            label: _("Next");
          }
        }

        [start]
        Button {
          action-name: "calendar.today";
          tooltip-text: _("Go to Today");
          child: Adw.ButtonContent {
            label: _("_Today");
            use-underline: true;
            icon-name: "calendar-today-symbolic";
            can-shrink: true;
          };
        }

        [center]
        Adw.ViewSwitcher view_switcher {
          stack: views;
          policy: wide;
        }

        [end]
        Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Add Event");
          action-name: "calendar.new-event";
          action-target: "''";

          accessibility {
            label: _("Add Event");
          }
        }
      }
    };
  };
}

SizeGroup {
  mode: horizontal;

  widgets [
    header_spacer,
    header_end,
  ]
}

// #402: Hauptmenü mit Inhalt wie Mail (mail-view.blp:1199-1243); erster Eintrag Neuer Termin
// statt Neue E-Mail, weil Strg+N hier calendar.new-event auslöst. Aktionen in calendar-view.c.
menu primary_menu {
  section {
    item {
      label: _("_New Event");
      action: "calendar.new-event";
      target: "";
      accel: "<primary>n";
    }

    item {
      label: _("_Search");
      action: "calendar.search";
      accel: "<primary>f";
    }
  }

  // Ohne Haken wie Mail: zustandslose Aktion calendar.toggle-sidebar statt calendar.sidebar.
  section {
    item {
      label: _("Toggle S_idebar");
      action: "calendar.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Appearance");

    item {
      label: _("_Light");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dark with Light _Content");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dark");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "calendar.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "calendar.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_About Revolution");
      action: "calendar.about";
    }
  }
}
