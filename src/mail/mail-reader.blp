// Lesebereich (#354): Kopf frei oben, darunter der Inhalt als große abgerundete Karte bis unten
// (Dokument #5 „Nachricht“, Design/Prototyp/mail-hell.png, #400 Punkt 7). Aus mail-view.blp
// (Seite „content“ von message_stack) hierher verschoben; Daten und WebView in mail-reader.c.
using Gtk 4.0;
using Adw 1;

template $RevolutionMailReader: Adw.Bin {
  // #355: Strg+I wie Evolution „Bilder laden“ (e-mail-reader.c:3116-3121). Scope managed: das
  // Fenster wertet das Kürzel aus, auch wenn die Nachrichtenliste den Fokus hat; die Aktion ist nur
  // bei sichtbarem Hinweis aktiv (mail-reader.c set_notice).
  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "<primary>i";
      action: "action(reader.load-remote)";
    }
  }

  child: Box {
    orientation: vertical;

    // #401 Punkt 4: Hinweis im Apple-Stil (Vorbild 12) statt Adw.Banner über die
    // volle Breite: abgerundete Pille mit Abstand, Symbol links, Knopf in Akzentfarbe.
    // #355: sichtbar, sobald die Web-Process-Extension entfernte Inhalte gesperrt hat
    // (mail-reader.c on_user_message). Knopf wie Evolution „Load remote content“ mit Menü
    // für Absender und Domain (e-mail-remote-content-popover.c:225-240, 309-335).
    Box notice {
      visible: false;
      spacing: 12;
      margin-start: 12;
      margin-end: 12;
      // #340: 13px unter der Kopfleiste.
      margin-top: 13;

      styles [
        "mail-notice",
      ]

      Image {
        icon-name: "preferences-system-privacy-symbolic";
        accessible-role: presentation;
      }

      Label {
        label: _("Remote Content Blocked");
        hexpand: true;
        xalign: 0;
        ellipsize: end;
      }

      // Tooltip mit Kürzel setzt mail-reader.c (revolution_mail_reader_init).
      Adw.SplitButton notice_button {
        label: _("Load");
        action-name: "reader.load-remote";
        dropdown-tooltip: _("Always Load Remote Content");
        menu-model: notice_menu;
        valign: center;

        accessibility {
          description: _("Load Remote Content of This Message");
        }

        styles [
          "mail-notice-button",
        ]
      }
    }

    // Nachrichtenkopf (#455, mail-header.blp). In der Konversation ausgeblendet, der Kopf steht dort
    // am Eintrag (revolution_mail_reader_set_compact).
    $RevolutionMailHeader header {}

    // #356: Anhangleiste unter dem Kopf (mail-attachment.blp), nur mit Anhängen sichtbar.
    $RevolutionMailAttachmentBar attachments {}

    // #376: Einladungskarte (mail-invitation.blp), nur mit Kalenderteil sichtbar.
    $RevolutionMailInvitation invitation {}

    // HTML-Mail: eigener Hintergrund (style.css .html-mail, Themes #340). Die WebView setzt
    // mail-reader.c als Kind des Overlays ein; der Kreisel zeigt das Laden aus dem Worker.
    // #357: in der Konversation nicht ausgedehnt, Höhe nach dem Inhalt (mail-reader.c fit_content).
    Adw.Bin content_card {
      vexpand: true;
      // #454: Sonst bleibt bei niedrigem Fenster unter großem Kopf nichts vom Mailtext übrig.
      height-request: 150;
      overflow: hidden;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 12;

      styles [
        "html-mail",
      ]

      child: Overlay content_overlay {
        [overlay]
        Adw.Spinner spinner {
          visible: false;
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        }
      };
    }
  };
}

// #355: Einträge setzt mail-reader.c fill_notice_menu (Absender, Domain).
menu notice_menu {}
