// Kontakte-Ansicht, Prototyp #338. Ohne Logik, Beispieldaten aus contacts-sample.c.
// Aufbau nach quelltext/stamp/src/views/contact/stamp-contact-view.blp:4-185 und
// mail-view.blp (Briefing 1.4); Design-Referenz GNOME Contacts 49.0.
// #402: Designsprache der Mail-Ansicht (#399–#401) übernommen, Muster jeweils
// aus mail-view.blp, CSS-Klassen aus style.css wiederverwendet.
using Gtk 4.0;
using Adw 1;

template $RevolutionContactsView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #402 wie mail-view.blp: Strg+F öffnet die Suche in der Kopfleiste des Kontakts,
  // F9 schaltet die Seitenleiste. Scope local: wirkt nur auf der Kontakte-Seite.
  // Strg+N wie GNOME Contacts (contacts-main-window.ui: <Control>n → win.new-contact).
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(contacts.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(contacts.sidebar)";
    }

    Shortcut {
      trigger: "<primary>n";
      action: "action(contact.new)";
    }

    Shortcut {
      trigger: "<primary>comma";
      action: "action(contacts.preferences)";
    }

    Shortcut {
      trigger: "<primary>question";
      action: "action(contacts.shortcuts)";
    }
  }

  // Wie mail-view.blp: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“
  // (stamp-contact-view.blp:8-26). Werte wie mail-view.blp (schwebende Seitenleiste).
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      new_spacer.visible: false;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      contacts_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Wie mail-view.blp: Neu wandert schmal in die Kopfleiste der Liste.
      list_new_button.visible: true;
      new_button.visible: false;
      new_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView contacts_layout {
    // Seitenleiste: Adressbücher je Konto als GtkListView mit navigation-sidebar,
    // gleich wie die Ordnerliste in mail-view.blp (CR #397) und Stamp
    // stamp-book-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Umschalter Mail | Kalender | Kontakte oben in der Kopfleiste der Seitenleiste
        // (Arnd 22.10.2026, #340, Vorbild 22/23): Standard-libadwaita, flache Symbolknöpfe;
        // AdwInlineViewSwitcher setzt den Seitentitel als Tooltip (geprüft headless).
        title-widget: Adw.InlineViewSwitcher {
          stack: bind template.stack;
          display-mode: icons;

          styles [
            "flat",
          ]
        };

        // #402: Primärmenü wie mail-view.blp (Nautilus-Optik, style.css .primary-menu).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";

          styles [
            "primary-menu",
          ]

          tooltip-text: _("Hauptmenü");
          menu-model: primary_menu;

          accessibility {
            label: _("Hauptmenü");
          }
        }
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // Viewport wie mail-view.blp: sonst fehlt beim Start der erste Abschnittskopf.
        child: Viewport {
          child: ListView book_list {
            tab-behavior: item;

            styles [
              "navigation-sidebar",
            ]

            accessibility {
              label: _("Adressbücher");
            }

            model: SingleSelection book_selection {};

            header-factory: BuilderListItemFactory {
              template ListHeader {
                child: Label {
                  label: bind template.item as <$RevolutionContactsSampleEntry>.group;
                  xalign: 0;
                  margin-start: 14;
                  margin-end: 14;
                  margin-top: 4;
                  margin-bottom: 2;
                  ellipsize: end;

                  styles [
                    "caption-heading",
                    "dimmed",
                  ]
                };
              }
            };

            factory: BuilderListItemFactory {
              template ListItem {
                child: Box {
                  spacing: 12;

                  Image {
                    icon-name: bind template.item as <$RevolutionContactsSampleEntry>.icon-name;
                    accessible-role: presentation;
                  }

                  Label {
                    label: bind template.item as <$RevolutionContactsSampleEntry>.title;
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                };
              }
            };
          };
        };
      };
    }

    // Kontaktliste: Avatar + Name (stamp-contact-row.blp:15-18), Abschnitte je
    // Anfangsbuchstabe (Briefing 1.4).
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // Wie mail-view.blp: Knopf immer sichtbar, F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Seitenleiste ein-/ausblenden");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Seitenleiste ein-/ausblenden");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste des Kontakts.
        // GNOME Contacts: „Add New Contact“, list-add-symbolic (contacts-main-window.ui).
        [start]
        Button list_new_button {
          visible: false;
          icon-name: "list-add-symbolic";
          tooltip-text: _("Neuer Kontakt");
          action-name: "contact.new";

          accessibility {
            label: _("Neuer Kontakt");
          }
        }

        // Titel linksbündig wie mail-view.blp (zwei Labels, Stilklassen aus HIG-TY).
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          Label {
            label: _("Persönlich");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          Label {
            label: _("12 Kontakte");
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };
      }

      // #402 Punkt 4: Buchstabenleiste A–Z rechts neben der Liste (Knöpfe in contacts-view.c).
      content: Box {
        ScrolledWindow {
          hexpand: true;
          hscrollbar-policy: never;

          // Viewport: ohne ihn fehlt beim Start der Abschnittskopf „A“ (headless
          // geprüft). Ursache klären in #350, Virtualisierung geht verloren.
          // #402: Auswahl als abgerundete Akzentfläche wie die Nachrichtenliste
          // (style.css .contact-list), ohne Trennlinien.
          child: Viewport {
            child: ListView contact_list {
              tab-behavior: item;

              styles [
                "contact-list",
              ]

              accessibility {
                label: _("Kontakte");
              }

              model: SingleSelection contact_selection {};

              header-factory: BuilderListItemFactory {
                template ListHeader {
                  child: Label {
                    label: bind template.item as <$RevolutionContactsSampleEntry>.group;
                    xalign: 0;
                    margin-start: 12;
                    margin-end: 12;
                    margin-top: 6;
                    margin-bottom: 3;

                    styles [
                      "caption-heading",
                      "dimmed",
                    ]
                  };
                }
              };

              factory: BuilderListItemFactory {
                template ListItem {
                  child: Box {
                    spacing: 12;

                    // 32 px statt 48 (stamp-contact-row.blp:15-18): Platz bei 1280×800.
                    // presentation: der Name steht im Label daneben, sonst doppelt vorgelesen.
                    Adw.Avatar {
                      size: 32;
                      show-initials: true;
                      accessible-role: presentation;
                      text: bind template.item as <$RevolutionContactsSampleEntry>.title;
                    }

                    Label {
                      label: bind template.item as <$RevolutionContactsSampleEntry>.title;
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }
                  };
                }
              };
            };
          };
        }

        Box letter_bar {
          orientation: vertical;
          valign: center;
          margin-end: 4;

          styles [
            "letter-bar",
          ]

          accessibility {
            label: _("Zu Anfangsbuchstabe springen");
          }
        }
      };
    }

    // Kontakt: Kopfleiste mit Aktionen und Suche wie mail-view.blp. #402 Runde 2:
    // Detailansicht nach GNOME Contacts (Kopf mittig, Angaben als Karten), dazu Reiter
    // Details | Verlauf | Firma. Felder nach stamp-contact-details.blp:40-112.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // „Lights off“ wie mail-view.blp: Gtk.Stack wechselt von den Aktionen zum
      // Suchfeld, Umschalten in contacts-view.c. Fensterknöpfe als Gtk.WindowControls
      // im Titel (Begründung in mail-view.blp).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button new_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("Neuer Kontakt");
                  action-name: "contact.new";

                  accessibility {
                    label: _("Neuer Kontakt");
                  }
                }

                Separator new_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Box {
                  hexpand: true;
                }

                Button {
                  icon-name: "document-edit-symbolic";
                  tooltip-text: _("Kontakt bearbeiten");
                  action-name: "contact.edit";

                  accessibility {
                    label: _("Kontakt bearbeiten");
                  }
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Kontakte durchsuchen");
                key-capture-widget: list_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("Kontakte durchsuchen");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      content: Box {
        orientation: vertical;

        // #402 Punkt 3: Verknüpfungsvorschlag als Pille wie der Hinweis der Mail-Ansicht
        // (style.css .mail-notice), Inhalt nach GNOME Contacts
        // (contacts-link-suggestion-grid.ui: Text, „Link Contacts“, Schließen-Knopf).
        Box link_notice {
          spacing: 12;
          margin-start: 12;
          margin-end: 12;
          margin-top: 6;

          styles [
            "mail-notice",
          ]

          // Avatar des vorgeschlagenen Eintrags wie avatar_bin in GNOME Contacts.
          Adw.Avatar {
            size: 24;
            show-initials: true;
            accessible-role: presentation;
            text: _("J. Albrecht");
          }

          Label {
            label: _("Ist dies dieselbe Person wie „J. Albrecht“ (Globale Adressliste)?");
            hexpand: true;
            xalign: 0;
            ellipsize: end;
          }

          Button {
            label: _("Kontakte verknüpfen");
            tooltip-text: _("Beide Einträge zu einem Kontakt verknüpfen");
            action-name: "contact.link";
            valign: center;

            styles [
              "mail-notice-button",
            ]
          }

          Button {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Vorschlag ausblenden");
            valign: center;
            clicked => $on_link_dismiss() swapped;

            accessibility {
              label: _("Vorschlag ausblenden");
            }

            styles [
              "flat",
              "circular",
            ]
          }
        }

        // Kopf, Reiter und Inhalt scrollen gemeinsam wie in GNOME Contacts
        // (contacts-contact-pane.ui: GtkScrolledWindow > AdwClamp).
        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 620;
            tightening-threshold: 480;
            margin-start: 12;
            margin-end: 12;
            margin-top: 18;
            margin-bottom: 24;

            child: Box {
              orientation: vertical;
              spacing: 18;

              // #402 Punkt 1: Kopf wie GNOME Contacts (großer Avatar mittig, Name groß
              // darunter); Name halbfett wie .mail-sender (style.css .contact-name).
              Box {
                orientation: vertical;
                spacing: 12;
                halign: center;

                Adw.Avatar {
                  size: 96;
                  show-initials: true;
                  text: _("Jana Albrecht");
                  halign: center;
                }

                Label {
                  label: _("Jana Albrecht");
                  wrap: true;
                  wrap-mode: word_char;
                  justify: center;
                  selectable: true;

                  styles [
                    "title-1",
                    "contact-name",
                  ]
                }

                // Runde Schnellaktionen (Platzhalter), Akzent-Tönung wie .mail-notice-button.
                Box {
                  spacing: 12;
                  halign: center;
                  margin-top: 6;

                  Button {
                    icon-name: "mail-message-new-symbolic";
                    tooltip-text: _("Mail schreiben");
                    action-name: "contact.write-mail";

                    accessibility {
                      label: _("Mail schreiben");
                    }

                    styles [
                      "contact-action",
                    ]
                  }

                  Button {
                    icon-name: "call-start-symbolic";
                    tooltip-text: _("Anrufen");
                    action-name: "contact.call";

                    accessibility {
                      label: _("Anrufen");
                    }

                    styles [
                      "contact-action",
                    ]
                  }

                  Button {
                    icon-name: "calendar-new-symbolic";
                    tooltip-text: _("Zu Termin einladen");
                    action-name: "contact.invite";

                    accessibility {
                      label: _("Zu Termin einladen");
                    }

                    styles [
                      "contact-action",
                    ]
                  }

                  // #402 Punkt 6: Teilen-Menü, Optik wie das Hauptmenü (primary-menu).
                  MenuButton {
                    icon-name: "share-nodes-symbolic";
                    tooltip-text: _("Teilen");
                    menu-model: share_menu;

                    accessibility {
                      label: _("Teilen");
                    }

                    styles [
                      "contact-action",
                      "primary-menu",
                    ]
                  }
                }
              }

              // #402 Punkt 2: Reiter unter dem Kopf. „Firma“ blendet contacts-view.c aus,
              // wenn keine Firma eingetragen ist.
              Adw.InlineViewSwitcher {
                stack: detail_stack;
                halign: center;
              }

              Adw.ViewStack detail_stack {
                vhomogeneous: false;

                Adw.ViewStackPage {
                  name: "details";
                  title: _("Details");

                  // Jede Angabe als eigene Karte (style.css .contact-card, .contact-field),
                  // Symbol klein und grau, Aktion direkt in der Zeile.
                  child: Box {
                    orientation: vertical;
                    spacing: 12;

                    // #402: gleiche Angaben in einer Karte wie GNOME Contacts, feiner Trenner (style.css).
                    Box {
                      orientation: vertical;

                      styles [
                        "contact-card",
                      ]

                      Box {
                        spacing: 12;

                        styles [
                          "contact-field",
                        ]

                        Image {
                          icon-name: "mail-unread-symbolic";
                          tooltip-text: _("E-Mail");

                          accessibility {
                            label: _("E-Mail");
                          }

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Arbeit");
                            xalign: 0;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }

                          Label {
                            label: "jana.albrecht@albrecht-partner.example";
                            xalign: 0;
                            wrap: true;
                            wrap-mode: word_char;
                            selectable: true;
                          }
                        }

                        Button {
                          icon-name: "sent-symbolic";
                          tooltip-text: _("E-Mail an diese Adresse schreiben");
                          action-name: "contact.write-mail";
                          valign: center;

                          accessibility {
                            label: _("E-Mail an diese Adresse schreiben");
                          }

                          styles [
                            "flat",
                            "circular",
                          ]
                        }
                      }

                      Separator {
                        styles [
                          "contact-separator",
                        ]
                      }

                      Box {
                        spacing: 12;

                        styles [
                          "contact-field",
                        ]

                        Image {
                          icon-name: "mail-unread-symbolic";
                          tooltip-text: _("E-Mail");

                          accessibility {
                            label: _("E-Mail");
                          }

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Privat");
                            xalign: 0;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }

                          Label {
                            label: "jana.albrecht@example.org";
                            xalign: 0;
                            wrap: true;
                            wrap-mode: word_char;
                            selectable: true;
                          }
                        }

                        Button {
                          icon-name: "sent-symbolic";
                          tooltip-text: _("E-Mail an diese Adresse schreiben");
                          action-name: "contact.write-mail";
                          valign: center;

                          accessibility {
                            label: _("E-Mail an diese Adresse schreiben");
                          }

                          styles [
                            "flat",
                            "circular",
                          ]
                        }
                      }
                    }

                    // Telefonnummern in einer Karte.
                    Box {
                      orientation: vertical;

                      styles [
                        "contact-card",
                      ]

                      Box {
                        spacing: 12;

                        styles [
                          "contact-field",
                        ]

                        Image {
                          icon-name: "phone-symbolic";
                          tooltip-text: _("Telefon");

                          accessibility {
                            label: _("Telefon");
                          }

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Mobil");
                            xalign: 0;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }

                          Label {
                            label: "+49 171 0000456";
                            xalign: 0;
                            selectable: true;

                            styles [
                              "numeric",
                            ]
                          }
                        }

                        Button {
                          icon-name: "call-start-symbolic";
                          tooltip-text: _("Diese Nummer anrufen");
                          action-name: "contact.call";
                          valign: center;

                          accessibility {
                            label: _("Diese Nummer anrufen");
                          }

                          styles [
                            "flat",
                            "circular",
                          ]
                        }
                      }

                      Separator {
                        styles [
                          "contact-separator",
                        ]
                      }

                      Box {
                        spacing: 12;

                        styles [
                          "contact-field",
                        ]

                        Image {
                          icon-name: "phone-symbolic";
                          tooltip-text: _("Telefon");

                          accessibility {
                            label: _("Telefon");
                          }

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Büro");
                            xalign: 0;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }

                          Label {
                            label: "+49 341 0000789";
                            xalign: 0;
                            selectable: true;

                            styles [
                              "numeric",
                            ]
                          }
                        }

                        Button {
                          icon-name: "call-start-symbolic";
                          tooltip-text: _("Diese Nummer anrufen");
                          action-name: "contact.call";
                          valign: center;

                          accessibility {
                            label: _("Diese Nummer anrufen");
                          }

                          styles [
                            "flat",
                            "circular",
                          ]
                        }
                      }
                    }

                    // Geburtstag wie im Kalender-Beispiel („Geburtstag Jana“, 24. Oktober).
                    Box {
                      spacing: 12;

                      styles [
                        "contact-card",
                        "contact-field",
                      ]

                      Image {
                        icon-name: "birthday-symbolic";
                        tooltip-text: _("Geburtstag");

                        accessibility {
                          label: _("Geburtstag");
                        }

                        styles [
                          "dimmed",
                        ]
                      }

                      Box {
                        orientation: vertical;
                        hexpand: true;

                        Label {
                          label: _("Geburtstag");
                          xalign: 0;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Label {
                          label: _("24. Oktober 1984");
                          xalign: 0;
                          selectable: true;
                        }
                      }
                    }

                    Box {
                      spacing: 12;

                      styles [
                        "contact-card",
                        "contact-field",
                      ]

                      Image {
                        icon-name: "mark-location-symbolic";
                        tooltip-text: _("Adresse");

                        accessibility {
                          label: _("Adresse");
                        }

                        styles [
                          "dimmed",
                        ]
                      }

                      Box {
                        orientation: vertical;
                        hexpand: true;

                        Label {
                          label: _("Arbeit");
                          xalign: 0;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Label {
                          label: _("Kanalstraße 12\n04179 Lindenau");
                          xalign: 0;
                          wrap: true;
                          selectable: true;
                        }
                      }
                    }

                    Box {
                      spacing: 12;

                      styles [
                        "contact-card",
                        "contact-field",
                      ]

                      Image {
                        icon-name: "x-office-document-symbolic";
                        tooltip-text: _("Notiz");

                        accessibility {
                          label: _("Notiz");
                        }

                        styles [
                          "dimmed",
                        ]
                      }

                      Box {
                        orientation: vertical;
                        hexpand: true;

                        Label {
                          label: _("Notiz");
                          xalign: 0;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Label {
                          label: _("Ansprechpartnerin für das Projekt Nordlicht. Pläne bitte immer als PDF schicken.");
                          xalign: 0;
                          wrap: true;
                          selectable: true;
                        }
                      }
                    }
                  };
                }

                // Verlauf: letzte E-Mails (mail-sample.c) und gemeinsame Termine
                // (calendar-sample.c) mit Jana Albrecht als ruhige Liste ohne Trennlinien.
                Adw.ViewStackPage {
                  name: "history";
                  title: _("Verlauf");

                  child: Box {
                    orientation: vertical;
                    spacing: 6;

                    Label {
                      label: _("E-Mails");
                      xalign: 0;
                      margin-start: 12;

                      styles [
                        "caption-heading",
                        "dimmed",
                      ]
                    }

                    Box {
                      orientation: vertical;
                      spacing: 14;

                      styles [
                        "contact-card",
                        "contact-history",
                      ]

                      Box {
                        spacing: 12;

                        Image {
                          icon-name: "mail-unread-symbolic";
                          valign: start;
                          margin-top: 2;
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Unterlagen für das Projekt Nordlicht");
                            xalign: 0;
