// Kontakte-Ansicht (Prototyp #338), echte Daten ab #368 (contacts-view.c).
// Aufbau nach quelltext/stamp/src/views/contact/stamp-contact-view.blp:4-185 und
// mail-view.blp (Briefing 1.4); Design-Referenz GNOME Contacts 49.0.
// #402: Designsprache der Mail-Ansicht (#399–#401) übernommen, Muster jeweils
// aus mail-view.blp, CSS-Klassen aus style.css wiederverwendet.
using Gtk 4.0;
using Adw 1;

template $RevolutionContactsView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #402 wie mail-view.blp: Strg+F öffnet die Suche in der Kopfleiste des Kontakts,
  // F9 schaltet die Seitenleiste. Scope local: wirkt nur auf der Kontakte-Seite.
  // Strg+N wie GNOME Contacts (contacts-main-window.ui: <Control>n → win.new-contact).
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(contacts.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(contacts.sidebar)";
    }

    Shortcut {
      trigger: "<primary>n";
      action: "action(contact.new)";
    }

    // #370: Escape bricht das Formular ab (GNOME Contacts contacts-main-window.vala „cancel“ bei
    // CREATING/UPDATING); ohne Formular ist die Aktion aus und Escape geht weiter (Suche, Composer).
    Shortcut {
      trigger: "Escape";
      action: "action(contact.cancel)";
    }

    Shortcut {
      trigger: "<primary>comma";
      action: "action(contacts.preferences)";
    }

    Shortcut {
      trigger: "<primary>question";
      action: "action(contacts.shortcuts)";
    }
  }

  // Wie mail-view.blp: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“
  // (stamp-contact-view.blp:8-26). Werte wie mail-view.blp (schwebende Seitenleiste).
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      new_spacer.visible: false;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      contacts_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Wie mail-view.blp: Neu wandert schmal in die Kopfleiste der Liste.
      list_new_button.visible: true;
      new_button.visible: false;
      new_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView contacts_layout {
    // Seitenleiste: Adressbücher je Konto als GtkListView mit navigation-sidebar,
    // gleich wie die Ordnerliste in mail-view.blp (CR #397) und Stamp
    // stamp-book-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Umschalter Mail | Kalender | Kontakte oben in der Kopfleiste der Seitenleiste
        // (Arnd 22.10.2026, #340, Vorbild 22/24): Segment-Umschalter, Standard-libadwaita
        // (AdwInlineViewSwitcher = AdwToggleGroup am ViewStack, nur Symbole);
        // Seitentitel als Tooltip setzt libadwaita (geprüft headless).
        title-widget: Adw.InlineViewSwitcher {
          stack: bind template.stack;
          display-mode: icons;
        };

        // #402: Primärmenü wie mail-view.blp (Nautilus-Optik, style.css .primary-menu).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";

          styles [
            "primary-menu",
          ]

          tooltip-text: _("Main Menu");
          menu-model: primary_menu;

          accessibility {
            label: _("Main Menu");
          }
        }
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // Viewport wie mail-view.blp: sonst fehlt beim Start der erste Abschnittskopf.
        child: Viewport {
          child: ListView book_list {
            tab-behavior: item;

            styles [
              "navigation-sidebar",
            ]

            accessibility {
              label: _("Address Books");
            }

            // #368: Abschnitt je Konto (contacts-book.c „section“: lokal zuerst), darin nach Name.
            model: SingleSelection book_selection {
              notify::selected-item => $on_book_selected() swapped;

              model: SortListModel book_sorted {
                section-sorter: StringSorter {
                  expression: expr item as <$RevolutionContactsBook>.section;
                };

                sorter: StringSorter {
                  expression: expr item as <$RevolutionContactsBook>.title;
                };
              };
            };

            header-factory: BuilderListItemFactory {
              template ListHeader {
                child: Label {
                  label: bind template.item as <$RevolutionContactsBook>.group;
                  xalign: 0;
                  margin-start: 14;
                  margin-end: 14;
                  margin-top: 4;
                  margin-bottom: 2;
                  ellipsize: end;

                  styles [
                    "caption-heading",
                    "dimmed",
                  ]
                };
              }
            };

            factory: BuilderListItemFactory {
              template ListItem {
                accessible-label: bind template.item as <$RevolutionContactsBook>.title;

                child: Box {
                  spacing: 12;

                  // Symbol wie im Prototyp (kontakte-hell.png), Adwaita x-office-address-book.
                  Image {
                    icon-name: "x-office-address-book-symbolic";
                    accessible-role: presentation;
                  }

                  Label {
                    label: bind template.item as <$RevolutionContactsBook>.title;
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }

                  // #368: Nur-lesend-Bücher (e_client_is_readonly) mit kleinem grauen Schloss
                  // (Dokument #5: Zusatz-Icons klein und grau), Tooltip erklärt es.
                  Image {
                    icon-name: "changes-prevent-symbolic";
                    pixel-size: 12;
                    visible: bind template.item as <$RevolutionContactsBook>.readonly;
                    tooltip-text: _("Read-Only");

                    styles [
                      "dimmed",
                    ]

                    accessibility {
                      label: _("Read-Only");
                    }
                  }
                };
              }
            };
          };
        };
      };
    }

    // Kontaktliste: Avatar + Name (stamp-contact-row.blp:15-18), Abschnitte je
    // Anfangsbuchstabe (Briefing 1.4).
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // Wie mail-view.blp: Knopf immer sichtbar, F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Toggle Sidebar");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Toggle Sidebar");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste des Kontakts.
        // GNOME Contacts: „Add New Contact“, list-add-symbolic (contacts-main-window.ui).
        [start]
        Button list_new_button {
          visible: false;
          icon-name: "list-add-symbolic";
          tooltip-text: _("New Contact");
          action-name: "contact.new";

          accessibility {
            label: _("New Contact");
          }
        }

        // Titel linksbündig wie mail-view.blp (zwei Labels, Stilklassen aus HIG-TY).
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          Label title_label {
            label: _("Contacts");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          // Anzahl der Kontakte (contacts-view.c update_state).
          Label subtitle_label {
            visible: false;
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };
      }

      // #368: Fehler des gewählten Buchs als AdwBanner wie mail-view.blp (Architektur 3),
      // kurzer Titel, Einzelheiten im Tooltip (contacts-view.c show_error).
      [top]
      Adw.Banner banner {
        use-markup: false;
      }

      // Ohne Adressbuch: Leerzustand wie Stamp (stamp-contact-list.blp:126-133).
      content: Stack contact_stack {
        // Erste Seite „empty“ ist sichtbar (Gtk.Stack zeigt das erste Kind).
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "system-users-symbolic";
            title: _("No Contacts");
          };
        }

        // #368: Laden, Suche ohne Treffer, Buch ohne Gesamtliste (Kontakte erst nach Suche).
        StackPage {
          name: "loading";

          child: Adw.Spinner {
            width-request: 32;
            height-request: 32;
            halign: center;
            valign: center;

            accessibility {
              label: _("Loading Contacts");
            }
          };
        }

        StackPage {
          name: "no-results";

          child: Adw.StatusPage {
            icon-name: "edit-find-symbolic";
            title: _("No Results");
          };
        }

        StackPage {
          name: "search-hint";

          child: Adw.StatusPage {
            icon-name: "edit-find-symbolic";
            title: _("Search to Show Contacts");
            description: _("This address book only shows contacts that match a search.");
          };
        }

        StackPage {
          name: "list";

          // #402 Punkt 4: Buchstabenleiste A–Z rechts neben der Liste (Knöpfe in contacts-view.c).
          child: Box {
            ScrolledWindow {
              hexpand: true;
              hscrollbar-policy: never;

              // #368: ohne Viewport (Prototyp hatte einen), damit die Liste virtualisiert
              // bleibt (info@: 578 Kontakte); erster Abschnittskopf headless geprüft.
              // #402: Auswahl als abgerundete Akzentfläche wie die Nachrichtenliste
              // (style.css .contact-list), ohne Trennlinien.
              child: ListView contact_list {
                  tab-behavior: item;

                  // #370: Entf löscht den gewählten Kontakt (Rückgängig im Toast, contacts-view.c).
                  ShortcutController {
                    Shortcut {
                      trigger: "Delete";
                      action: "action(contact.delete)";
                    }
                  }

                  styles [
                    "contact-list",
                  ]

                  accessibility {
                    label: _("Contacts");
                  }

                  // #368: Abschnitte je Anfangsbuchstabe (section-sorter), darin nach Name.
                  model: SingleSelection contact_selection {
                    autoselect: false;
                    notify::selected-item => $on_contact_selected() swapped;

                    model: SortListModel contact_sorted {
                      section-sorter: StringSorter {
                        expression: expr item as <$RevolutionContactsContact>.initial;
                      };

                      sorter: StringSorter {
                        expression: expr item as <$RevolutionContactsContact>.name;
                      };
                    };
                  };

                  header-factory: BuilderListItemFactory {
                    template ListHeader {
                      child: Label {
                        label: bind template.item as <$RevolutionContactsContact>.initial;
                        xalign: 0;
                        margin-start: 12;
                        margin-end: 12;
                        margin-top: 6;
                        margin-bottom: 3;

                        styles [
                          "caption-heading",
                          "dimmed",
                        ]
                      };
                    }
                  };

                  factory: BuilderListItemFactory {
                    template ListItem {
                      accessible-label: bind template.item as <$RevolutionContactsContact>.name;

                      child: Box {
                        spacing: 12;

                        // 32 px statt 48 (stamp-contact-row.blp:15-18): Platz bei 1280×800.
                        // presentation: der Name steht im Label daneben, sonst doppelt vorgelesen.
                        // #368: Foto aus E_CONTACT_PHOTO, sonst Initialen wie GNOME Contacts.
                        Adw.Avatar {
                          size: 32;
                          show-initials: true;
                          accessible-role: presentation;
                          text: bind template.item as <$RevolutionContactsContact>.name;
                          custom-image: bind template.item as <$RevolutionContactsContact>.photo;
                        }

                        // Name halbfett (Dokument #19 #368, Dokument #5: nur Namen halbfett).
                        Label {
                          label: bind template.item as <$RevolutionContactsContact>.name;
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "mail-sender",
                          ]
                        }
                      };
                    }
                  };
                };
            }

            Box letter_bar {
              orientation: vertical;
              valign: center;
              margin-end: 4;

              styles [
                "letter-bar",
              ]

              accessibility {
                label: _("Jump to Initial Letter");
              }
            }
          };
        }
      };
    }

    // Kontakt: Kopfleiste mit Aktionen und Suche wie mail-view.blp. #402 Runde 2:
    // Detailansicht nach GNOME Contacts (Kopf mittig, Angaben als Karten), dazu Reiter
    // Details | Verlauf | Firma. Felder nach stamp-contact-details.blp:40-112.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // „Lights off“ wie mail-view.blp: Gtk.Stack wechselt von den Aktionen zum
      // Suchfeld, Umschalten in contacts-view.c. Fensterknöpfe als Gtk.WindowControls
      // im Titel (Begründung in mail-view.blp).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button new_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New Contact");
                  action-name: "contact.new";

                  accessibility {
                    label: _("New Contact");
                  }
                }

                Separator new_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Box {
                  hexpand: true;
                }

                // #370: nur bei schreibbarem Buch sichtbar (contacts-view.c update_actions).
                Button delete_button {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Delete Contact");
                  action-name: "contact.delete";

                  accessibility {
                    label: _("Delete Contact");
                  }
                }

                Button edit_button {
                  icon-name: "document-edit-symbolic";
                  tooltip-text: _("Edit Contact");
                  action-name: "contact.edit";

                  accessibility {
                    label: _("Edit Contact");
                  }
                }
              };
            }

            // #370: Formular offen wie GNOME Contacts (Abbrechen links, Titel, Fertig bzw. Hinzufügen
            // als Akzentknopf rechts; contacts-main-window.ui, done_button).
            StackPage {
              name: "edit";

              child: CenterBox {
                start-widget: Button {
                  label: _("_Cancel");
                  use-underline: true;
                  action-name: "contact.cancel";
                };

                center-widget: Label edit_title {
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                };

                end-widget: Button done_button {
                  use-underline: true;
                  action-name: "contact.save";

                  styles [
                    "suggested-action",
                  ]
                };
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Search Contacts");
                key-capture-widget: list_pane;
                search-started => $on_search_started() swapped;
                search-changed => $on_search_changed() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("Search Contacts");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Search");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Search");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      // #369: Detail der Auswahl (contacts-detail.blp), ohne Auswahl Leerzustand. Reiter
      // Verlauf | Firma des Prototyps sind nicht in M6 (Dokument #19).
      // #370: Formular im Detailbereich wie GNOME Contacts (Bearbeiten im selben Bereich).
      content: Stack pane_stack {
        StackPage {
          name: "detail";
          child: $RevolutionContactsDetail detail {};
        }

        StackPage {
          name: "editor";
          child: $RevolutionContactsEditor editor {};
        }
      };
    }


    // Breit: Seitenleiste | Liste | Kontakt (stamp-contact-view.blp:57-96).
    // Schmal (≤ 1000 sp): Seitenleiste als Überlagerung, Werte per Breakpoint oben.
    // Klasse mail-split und schwebende Seitenleiste wie mail-view.blp (style.css).
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 236;
        max-sidebar-width: 296;

        styles [
          "mail-split",
        ]

        sidebar: Adw.Bin {
          overflow: hidden;
          margin-start: 8;
          margin-end: 8;
          margin-top: 8;
          margin-bottom: 8;

          styles [
            "floating-sidebar",
          ]

          child: Adw.LayoutSlot {
            id: "sidebar";
          };
        };

        content: Paned {
          position: 320;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Kontakt (stamp-contact-view.blp:139-178).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Contacts");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.LayoutSlot {
              id: "list";
            };
          };
        }

        Adw.NavigationPage {
          title: _("Contact");
          tag: "contact";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

// #402: Primärmenü wie mail-view.blp (Gruppen als Abschnitte, Kürzel rechts über
// das accel-Attribut). Erster Eintrag Neuer Kontakt statt Neue E-Mail, da Strg+N
// hier einen Kontakt anlegt (GNOME Contacts).
menu primary_menu {
  section {
    item {
      label: _("_New Contact");
      action: "contact.new";
      accel: "<primary>n";
    }

    item {
      label: _("_Search");
      action: "contacts.search";
      accel: "<primary>f";
    }
  }

  // Ohne Haken wie mail-view.blp: zustandslose Aktion contacts.toggle-sidebar.
  section {
    item {
      label: _("Toggle S_idebar");
      action: "contacts.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Appearance");

    item {
      label: _("_Light");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dark with Light _Content");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dark");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "contacts.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "contacts.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_About Revolution");
      action: "contacts.about";
    }
  }
}
