// Kalender-Ansicht, Prototyp #339. Ohne Logik, Beispieldaten aus calendar-sample.c.
// Aufbau nach quelltext/gnome-calendar/src/gui/gcal-window.blp:135-348 (GNOME Calendar 50.0,
// Briefing 1.5); Seitenleiste und Umschalter wie mail/mail-view.blp.
// Monatsraster, Wochenkopf und Wochenraster sind in GNOME Calendar eigene C-Widgets
// (GcalMonthView, GcalWeekHeader, GcalWeekGrid); hier leere Gtk.Grid, die calendar-view.c
// mit Standard-Widgets füllt.
using Gtk 4.0;
using Adw 1;

template $RevolutionCalendarView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;
  // Kürzel wie GNOME Calendar (gcal-window.blp:11-75, F9 :181-188), Aktionen in
  // calendar-view.c. Scope local: wirken nur auf der Kalender-Seite.
  ShortcutController {
    Shortcut {
      trigger: "<Control>t";
      action: "action(calendar.today)";
    }

    Shortcut {
      trigger: "Home";
      action: "action(calendar.today)";
    }

    Shortcut {
      trigger: "<Alt>Left";
      action: "action(calendar.previous)";
    }

    Shortcut {
      trigger: "Page_Up";
      action: "action(calendar.previous)";
    }

    Shortcut {
      trigger: "<Alt>Right";
      action: "action(calendar.next)";
    }

    Shortcut {
      trigger: "Page_Down";
      action: "action(calendar.next)";
    }

    Shortcut {
      trigger: "<Alt>1";
      action: "action(calendar.view)";
      arguments: "'month'";
    }

    Shortcut {
      trigger: "<Alt>2";
      action: "action(calendar.view)";
      arguments: "'week'";
    }

    Shortcut {
      trigger: "<Control>n";
      action: "action(calendar.new-event)";
    }

    Shortcut {
      trigger: "<Control>f";
      action: "action(calendar.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(calendar.sidebar)";
    }

    // #402: Kürzel der Hauptmenü-Einträge wie Mail (mail-view.blp:26-43).
    Shortcut {
      trigger: "<Control>comma";
      action: "action(calendar.preferences)";
    }

    Shortcut {
      trigger: "<Control>question";
      action: "action(calendar.shortcuts)";
    }
  }

  // Wie Mail (mail-view.blp:10-23) und GNOME Calendar (gcal-window.blp:323-330):
  // ≤ 1000 sp Seitenleiste als Überlagerung.
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      // #402: Breiten wie Mail (mail-view.blp:53-57).
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 276;
      split.max-sidebar-width: 336;
      view_switcher.policy: narrow;
    }
  }

  // #402: Breiten und Klasse mail-split wie Mail (mail-view.blp:1033-1040, style.css).
  child: Adw.OverlaySplitView split {
    sidebar-width-fraction: 0.22;
    min-sidebar-width: 236;
    max-sidebar-width: 296;

    styles [
      "mail-split",
    ]

    // #402: Seitenleiste als schwebende, abgerundete Fläche mit Abstand zum Fensterrand
    // (wie mail-view.blp).
    sidebar: Adw.Bin {
      overflow: hidden;
      margin-start: 8;
      margin-end: 8;
      margin-top: 8;
      margin-bottom: 8;

      styles [
        "floating-sidebar",
      ]

      // Seitenleiste: Monatsauswahl + Kalenderliste (gcal-window.blp:150-166).
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          // Umschalter Mail | Kalender | Kontakte oben in der Kopfleiste der Seitenleiste
          // (Arnd 22.10.2026, #340, Vorbild 22/23): Standard-libadwaita, flache Symbolknöpfe;
          // AdwInlineViewSwitcher setzt den Seitentitel als Tooltip (geprüft headless).
          title-widget: Adw.InlineViewSwitcher {
            stack: bind template.stack;
            display-mode: icons;

            styles [
              "flat",
            ]
          };

          // #402: Hauptmenü wie Mail (mail-view.blp:88-106), Nautilus-Optik über .primary-menu.
          [end]
          MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";

            styles [
              "primary-menu",
            ]

            tooltip-text: _("Hauptmenü");
            menu-model: primary_menu;

            accessibility {
              label: _("Hauptmenü");
            }
          }
        }

        content: ScrolledWindow {
          hscrollbar-policy: never;

          child: Box {
            orientation: vertical;

            // GcalDateChooser ist ein eigenes C-Widget; hier Gtk.Calendar.
            // #402: ohne eigenen Rahmen auf der Seitenleisten-Fläche (style.css .date-chooser).
            Calendar date_chooser {
              year: 2026;
              month: 9;
              day: 21;
              margin-start: 12;
              margin-end: 12;
              margin-top: 6;
              margin-bottom: 6;

              accessibility {
                label: _("Datum wählen");
              }

              styles [
                "date-chooser",
              ]
            }

            // Kalenderliste (gcal-calendar-list.blp:14-23), je Konto ein Abschnitt wie die
            // Ordnerliste in mail-view.blp. Farbe und Ein/Aus im Ankreuzfeld.
            ListView calendar_list {
              tab-behavior: item;

              // calendar-list: Abstand Ankreuzfeld–Name wie Symbol–Name der Ordnerliste (style.css).
              styles [
                "navigation-sidebar",
                "calendar-list",
              ]

              accessibility {
                label: _("Kalender");
              }

              model: NoSelection calendar_model {};

              header-factory: BuilderListItemFactory {
                template ListHeader {
                  child: Label {
                    label: bind template.item as <$RevolutionSampleCalendar>.group;
                    xalign: 0;
                    margin-start: 14;
                    margin-end: 14;
                    margin-top: 4;
                    margin-bottom: 2;
                    ellipsize: end;

                    styles [
                      "caption-heading",
                      "dimmed",
                    ]
                  };
                }
              };

              factory: BuilderListItemFactory {
                template ListItem {
                  activatable: false;

                  child: CheckButton {
                    label: bind template.item as <$RevolutionSampleCalendar>.title;
                    // Anfangszustand aus den Beispieldaten; Umschalten ändert nur das Ankreuzfeld.
                    active: bind template.item as <$RevolutionSampleCalendar>.visible;
                    css-classes: bind template.item as <$RevolutionSampleCalendar>.css-classes;
                    tooltip-text: _("Kalender ein- oder ausblenden");
                  };
                }
              };
            }
          };
        };
      };

    };

    // #402: Hauptbereich ohne Klasse .view auf dem Fensterhintergrund wie Mail (.mail-split).
    content: Adw.ToolbarView content_pane {
      // calendar-main: dunkle Trennlinien im Dunkelmodus (style.css).
      styles [
        "calendar-main",
      ]

      // Kopfleiste (gcal-window.blp:174-211). Titel = Monat und Jahr
      // (gcal-calendar-navigation-button.c:106, „%B %Y“).

      // #402: Aufbau wie die Kopfleiste der Mail-Nachricht (mail-view.blp:438-449): alles im
      // Titel, damit der Titel linksbündig direkt neben dem Seitenleisten-Knopf steht wie in
      // der Mail-Liste (mail-view.blp:233-262); Fensterknöpfe als Gtk.WindowControls.
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Box {
          hexpand: true;
          spacing: 6;

          // #402 Runde 2: Suche wie Mail (mail-view.blp:438-604): „Lights off“, Gtk.Stack
          // wechselt vom Knopf mit Titel zum Suchfeld über die ganze Breite bis zur Lupe.
          // Umschalten in calendar-view.c.
          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                // #402: Knopf immer sichtbar wie Mail (mail-view.blp:208-218); F9 oben im Controller.
                ToggleButton sidebar_button {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Seitenleiste ein-/ausblenden");
                  active: bind split.show-sidebar bidirectional;

                  accessibility {
                    label: _("Seitenleiste ein-/ausblenden");
                  }
                }

                Label {
                  label: _("Oktober 2026");
                  hexpand: true;
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Termine durchsuchen");
                // Tippen im Hauptbereich startet die Suche (wie Mail, HIG-SE „type to search“).
                key-capture-widget: content_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("Termine durchsuchen");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      // Monat und Woche (gcal-window.blp:213-247); Tag folgt in #374.
      content: Adw.ViewStack views {
        hexpand: true;
        vexpand: true;

        Adw.ViewStackPage {
          name: "month";
          title: _("_Monat");
          use-underline: true;
          icon-name: "calendar-month-symbolic";

          child: Box {
            orientation: vertical;
            // Wochentage (gcal-month-view.blp:40-92). #402: leicht wie die Abschnittsköpfe
            // der Mail-Ordnerliste (caption-heading, dimmed; mail-view.blp:144-147).
            Box {
              homogeneous: true;
              margin-top: 6;
              margin-bottom: 6;

              Label {
                label: _("MO");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("DI");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("MI");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("DO");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("FR");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("SA");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label {
                label: _("SO");
                xalign: 0;
                margin-start: 12;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }
            }

            Separator {}

            // 5 Wochen × 7 Tage (gcal-month-view.c:39), je Woche ein Gtk.Grid aus
            // calendar-view.c; homogeneous: alle Wochen gleich hoch. Bei wenig Platz
            // abgeschnitten statt Mindestgröße zu erzwingen (GcalMonthView: overflow hidden,
            // gcal-month-view.blp:4).
            ScrolledWindow {
              hscrollbar-policy: external;
              vscrollbar-policy: external;
              vexpand: true;

              child: Box month_weeks {
                orientation: vertical;
                homogeneous: true;
                accessible-role: group;

                accessibility {
                  label: _("Monat");
                }
              };
            }
          };
        }

        Adw.ViewStackPage {
          name: "week";
          title: _("_Woche");
          use-underline: true;
          icon-name: "calendar-week-symbolic";
          // Aufbau nach gcal-week-view.blp:3-108.
          child: Box {
            orientation: vertical;

            Box {
              Adw.Bin week_header_spacer {}

              // Wochentage und ganztägige Termine (GcalWeekHeader).
              Grid week_header {
                accessible-role: group;
                hexpand: true;
                column-homogeneous: true;
                margin-top: 4;

                accessibility {
                  label: _("Ganztägige Termine");
                }
              }
            }

            Separator {}

            // Fest 07–21 Uhr; bei wenig Platz abgeschnitten wie der Monat.
            ScrolledWindow {
              hscrollbar-policy: external;
              vscrollbar-policy: external;
              vexpand: true;

              child: Viewport {
                child: Box {
                  // Stundenleiste (GcalWeekHourBar).
                  Box hour_bar {
                    orientation: vertical;
                    homogeneous: true;
                  }

                  // Stundenraster mit Terminen (GcalWeekGrid), 07–21 Uhr in halben Stunden.
                  Grid week_grid {
                    accessible-role: group;
                    hexpand: true;
                    column-homogeneous: true;
                    row-homogeneous: true;

                    accessibility {
                      label: _("Woche");
                    }
                  }
                };
              };
            }
          };
        }
      };

      // Untere Leiste (gcal-window.blp:265-315).

      [bottom]
      ActionBar {
        [start]
        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Zurück");
          action-name: "calendar.previous";

          accessibility {
            label: _("Zurück");
          }
        }

        [start]
        Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Vor");
          action-name: "calendar.next";

          accessibility {
            label: _("Vor");
          }
        }

        [start]
        Button {
          action-name: "calendar.today";
          tooltip-text: _("Zu heute springen");

          child: Adw.ButtonContent {
            label: _("_Heute");
            use-underline: true;
            icon-name: "calendar-today-symbolic";
            can-shrink: true;
          };
        }

        [center]
        Adw.ViewSwitcher view_switcher {
          stack: views;
          policy: wide;
        }

        [end]
        Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Termin hinzufügen");
          action-name: "calendar.new-event";

          accessibility {
            label: _("Termin hinzufügen");
          }
        }
      }
    };
  };
}

SizeGroup {
  mode: horizontal;

  widgets [
    week_header_spacer,
    hour_bar,
  ]
}

// Termin-Detail (gcal-event-popover.blp:3-158), Inhalt setzt calendar-view.c.
// #402: Nautilus-Optik wie das Hauptmenü der Mail (style.css .event-popover).
Popover event_popover {
  default-widget: edit_button;
  position: top;
  width-request: 250;

  styles [
    "event-popover",
  ]

  child: Box {
    orientation: vertical;

    Box {
      spacing: 18;
      margin-top: 18;
      margin-bottom: 12;
      margin-start: 18;
      margin-end: 18;

      Box {
        hexpand: true;
        orientation: vertical;
        spacing: 6;
        // Nicht wählbar: sonst erhält der Titel beim Öffnen den Fokus und erscheint markiert.
        Label event_summary {
          wrap: true;
          wrap-mode: word_char;
          xalign: 0;
          max-width-chars: 23;
          lines: 6;
          ellipsize: end;
          // #402: halbfett wie der Absender im Mailkopf (.mail-sender, style.css).
          styles [
            "event-title",
          ]
        }

        Label event_when {
          xalign: 0;
          wrap: true;

          styles [
            "dimmed",
          ]
        }
      }

      // #402 Runde 2: Teilen-Knopf neben dem Stift (Arnd 22.10.), Menü in Nautilus-Optik
      // über die Klasse .primary-menu wie das Hauptmenü (style.css).
      Box {
        valign: start;
        spacing: 6;

        MenuButton {
          icon-name: "share-nodes-symbolic";
          tooltip-text: _("Teilen");
          menu-model: share_menu;

          accessibility {
            label: _("Teilen");
          }

          styles [
            "circular",
            "primary-menu",
          ]
        }

        Button edit_button {
          icon-name: "document-edit-symbolic";
          tooltip-text: _("Termin bearbeiten");
          action-name: "calendar.edit-event";

          accessibility {
            label: _("Termin bearbeiten");
          }

          styles [
            "circular",
          ]
        }
      }
    }

    Separator {}

    Label event_notes {
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
      max-width-chars: 35;
      selectable: true;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 18;
      margin-end: 18;
    }

    Box event_location_box {
      orientation: vertical;

      Separator {}

      Box {
        orientation: vertical;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 18;
        margin-end: 18;

        Label {
          halign: start;
          label: _("Ort");

          styles [
            "caption-heading",
            "dimmed",
          ]
        }

        Label event_location {
          halign: start;
          selectable: true;
          ellipsize: end;
          max-width-chars: 35;
        }
      }
    }
  };
}

// #402: Hauptmenü mit Inhalt wie Mail (mail-view.blp:1199-1243); erster Eintrag Neuer Termin
// statt Neue E-Mail, weil Strg+N hier calendar.new-event auslöst. Aktionen in calendar-view.c.
menu primary_menu {
  section {
    item {
      label: _("_Neuer Termin");
      action: "calendar.new-event";
      accel: "<primary>n";
    }

    item {
      label: _("_Suchen");
      action: "calendar.search";
      accel: "<primary>f";
    }
  }

  // Ohne Haken wie Mail: zustandslose Aktion calendar.toggle-sidebar statt calendar.sidebar.
  section {
    item {
      label: _("Seiten_leiste ein-/ausblenden");
      action: "calendar.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Darstellung");

    item {
      label: _("_Hell");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dunkel _mit hellem Inhalt");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dunkel");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Einstellungen");
      action: "calendar.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Tastenkürzel");
      action: "calendar.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_Info zu Revolution");
      action: "calendar.about";
    }
  }
}

// #402 Runde 2: Teilen-Menü des Termin-Details, Platzhalter-Aktionen in calendar-view.c.
menu share_menu {
  section {
    item {
      label: _("Per E-Mail _einladen…");
      action: "calendar.invite-email";
    }

    item {
      label: _("Als _Datei teilen (.ics)");
      action: "calendar.share-ics";
    }
  }
}
