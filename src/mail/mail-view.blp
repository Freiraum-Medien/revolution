// Mail-Ansicht dreispaltig, Prototyp #336. Ohne Logik, Beispieldaten aus mail-sample.c.
// Aufbau nach quelltext/stamp/src/views/mail/stamp-mail-view.blp:4-193 (Briefing 1.1, 1.2).
using Gtk 4.0;
using Adw 1;

template $RevolutionMailView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  // #399: Strg+F öffnet die Suche in der Kopfleiste der Nachricht (HIG-SE „Ctrl+F“),
  // F9 schaltet die Seitenleiste wie GNOME Calendar (gcal-window.blp:181-188).
  // Scope local wie calendar-view.blp:14-72: wirkt nur auf der Mail-Seite. Aktionen in mail-view.c.
  ShortcutController {
    Shortcut {
      trigger: "<primary>f";
      action: "action(mail.search)";
    }

    Shortcut {
      trigger: "F9";
      action: "action(mail.sidebar)";
    }
  }

  // Briefing 1.2: ≤ 1000 sp Seitenleiste eingeklappt, ≤ 600 sp „mobile“ (stamp-mail-view.blp:8-26).
  // Es gilt nur der zuletzt passende Breakpoint, daher setzt „mobile“ show-sidebar erneut.
  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      split.collapsed: true;
      split.show-sidebar: false;
      split.sidebar-width-fraction: 0.28;
      split.min-sidebar-width: 260;
      split.max-sidebar-width: 320;
      // Neu wandert in die Listenspalte: alle Knöpfe der Nachricht passen sonst
      // nicht neben die Liste (900 px, mail-schmal.png).
      list_compose_button.visible: true;
      compose_button.visible: false;
      compose_spacer.visible: false;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      mail_layout.layout-name: "mobile";
      split.show-sidebar: false;
      list_header.show-end-title-buttons: true;
      // Es gilt nur der zuletzt passende Breakpoint (s. o.): Neu bleibt in der Liste.
      list_compose_button.visible: true;
      compose_button.visible: false;
      compose_spacer.visible: false;
    }
  }

  child: Adw.MultiLayoutView mail_layout {
    // Seitenleiste: Ordnerbaum als GtkListView + GtkTreeListModel (CR #397),
    // Vorlage stamp-folder-list.blp:5-8.
    [sidebar]
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle {
          title: _("Revolution");
        };

        // #399 Punkt 3: Primärmenü in der Seitenleisten-Kopfleiste wie Nautilus (Briefing N).
        // HIG Menus: „The button for primary menus should use the open-menu-symbolic icon“.
        // primary: F10 öffnet das Menü (GtkMenuButton:primary).
        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Hauptmenü");
          menu-model: primary_menu;

          accessibility {
            label: _("Hauptmenü");
          }
        }
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // Viewport: sonst blendet GtkListView beim Start den ersten
        // Abschnittskopf („Favoriten“) aus, erst Hochscrollen zeigt ihn.
        // Ursache klären in #350, Virtualisierung geht verloren.
        child: Viewport {
          child: ListView folder_list {
            tab-behavior: item;

            styles [
              "navigation-sidebar",
            ]

            accessibility {
              label: _("Ordner");
            }

            model: SingleSelection folder_selection {};

            header-factory: BuilderListItemFactory {
              template ListHeader {
                child: Label {
                  label: bind template.item as <TreeListRow>.item as <$RevolutionSampleFolder>.group;
                  xalign: 0;
                  margin-start: 14;
                  margin-end: 14;
                  margin-top: 12;
                  margin-bottom: 6;
                  ellipsize: end;

                  styles [
                    "caption-heading",
                    "dimmed",
                  ]
                };
              }
            };

            factory: BuilderListItemFactory {
              template ListItem {
                child: TreeExpander {
                  list-row: bind template.item as <TreeListRow>;

                  child: Box {
                    spacing: 12;

                    Image {
                      icon-name: bind template.item as <TreeListRow>.item as <$RevolutionSampleFolder>.icon-name;
                      accessible-role: presentation;
                    }

                    Label {
                      label: bind template.item as <TreeListRow>.item as <$RevolutionSampleFolder>.title;
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }

                    Label {
                      label: bind template.item as <TreeListRow>.item as <$RevolutionSampleFolder>.unread;
                      tooltip-text: _("Ungelesene Nachrichten");

                      // Name = Zahl aus dem Text; Blueprint kann accessibility nicht binden.
                      accessibility {
                        description: _("ungelesen");
                      }

                      styles [
                        "dimmed",
                        "numeric",
                      ]
                    }
                  };
                };
              }
            };
          };
        };
      };
    }

    // Nachrichtenliste, Zeile nach stamp-conversation-row.blp:72-224.
    [list]
    Adw.ToolbarView list_pane {
      width-request: 300;

      [top]
      Adw.HeaderBar list_header {
        show-end-title-buttons: false;

        // #399 Punkt 4: Knopf immer sichtbar wie GNOME Calendar
        // (quelltext/gnome-calendar/src/gui/gcal-window.blp:176-189); F9 oben im Controller.
        [start]
        ToggleButton sidebar_button {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Seitenleiste ein-/ausblenden");
          active: bind split.show-sidebar bidirectional;

          accessibility {
            label: _("Seitenleiste ein-/ausblenden");
          }
        }

        // Nur schmal (Breakpoints oben); breit steht Neu in der Kopfleiste der Nachricht.
        [start]
        Button list_compose_button {
          visible: false;
          icon-name: "mail-message-new-symbolic";
          tooltip-text: _("Neue E-Mail");
          action-name: "list.compose";

          accessibility {
            label: _("Neue E-Mail");
          }
        }

        // #399 Punkt 7: Titel linksbündig wie Apple (Briefing V7). Adw.WindowTitle
        // zentriert, daher zwei Labels mit den Stilklassen aus HIG-TY.
        title-widget: Box {
          orientation: vertical;
          valign: center;
          hexpand: true;

          Label {
            label: _("Alle Eingänge");
            xalign: 0;
            ellipsize: end;

            styles [
              "heading",
            ]
          }

          Label {
            label: _("10 E-Mails, 4 ungelesen");
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dimmed",
            ]
          }
        };

        [end]
        MenuButton {
          icon-name: "sort-order-symbolic";
          tooltip-text: _("Filter");
          menu-model: filter_menu;

          accessibility {
            label: _("Filter");
          }
        }
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        child: ListView message_list {
          show-separators: true;
          tab-behavior: item;

          styles [
            "rich-list",
          ]

          accessibility {
            label: _("Nachrichten");
          }

          model: SingleSelection message_selection {};

          factory: BuilderListItemFactory {
            template ListItem {
              child: Box {
                spacing: 6;

                // Platz für den Ungelesen-Punkt bleibt auch ohne Punkt frei.
                Box {
                  width-request: 10;
                  valign: start;
                  margin-top: 4;

                  Image {
                    icon-name: "media-record-symbolic";
                    pixel-size: 10;
                    visible: bind template.item as <$RevolutionSampleMessage>.unread;
                    tooltip-text: _("Ungelesen");

                    accessibility {
                      label: _("Ungelesen");
                    }

                    styles [
                      "accent",
                    ]
                  }
                }

                Adw.Avatar {
                  size: 40;
                  valign: start;
                  show-initials: true;
                  text: bind template.item as <$RevolutionSampleMessage>.sender;
                  margin-end: 6;
                }

                Box {
                  orientation: vertical;
                  hexpand: true;
                  spacing: 2;

                  Box {
                    spacing: 6;

                    Label sender_unread {
                      label: bind template.item as <$RevolutionSampleMessage>.sender;
                      visible: bind template.item as <$RevolutionSampleMessage>.unread;
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;

                      styles [
                        "heading",
                      ]
                    }

                    Label {
                      label: bind template.item as <$RevolutionSampleMessage>.sender;
                      visible: bind sender_unread.visible inverted;
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }

                    Label {
                      label: bind template.item as <$RevolutionSampleMessage>.date;

                      styles [
                        "caption",
                        "numeric",
                        "dimmed",
                      ]
                    }
                  }

                  Box {
                    spacing: 6;

                    Label {
                      label: bind template.item as <$RevolutionSampleMessage>.subject;
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }

                    Image {
                      icon-name: "mail-attachment-symbolic";
                      visible: bind template.item as <$RevolutionSampleMessage>.attachment;
                      tooltip-text: _("Mit Anhang");

                      accessibility {
                        label: _("Mit Anhang");
                      }

                      styles [
                        "dimmed",
                      ]
                    }

                    Image {
                      icon-name: "starred-symbolic";
                      visible: bind template.item as <$RevolutionSampleMessage>.starred;
                      tooltip-text: _("Markiert");

                      accessibility {
                        label: _("Markiert");
                      }

                      styles [
                        "accent",
                      ]
                    }
                  }

                  Label {
                    label: bind template.item as <$RevolutionSampleMessage>.preview;
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                    lines: 2;
                    ellipsize: end;
                    width-chars: 10;

                    styles [
                      "dimmed",
                    ]
                  }
                }
              };
            }
          };
        };
      };
    }

    // Nachricht: Kopfleiste mit Aktionen (Briefing 1.1), Banner, Kopf, Inhalt.
    [content]
    Adw.ToolbarView {
      width-request: 360;

      // #399 Punkt 5/6: Neu an erster Stelle, Suche rechts neben den Fensterknöpfen.
      // „Lights off“: Gtk.Stack wechselt von den Aktionen zum Suchfeld, das dann die
      // ganze Breite bis zum Suchknopf einnimmt. Umschalten in mail-view.c.
      // Abweichung HIG-SE („a search bar which slides down from beneath the header bar“):
      // Suchfeld in der Kopfleiste statt Gtk.SearchBar darunter (Vorgabe Arnd, #399).
      [top]
      Adw.HeaderBar {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        // Alles im Titel: AdwHeaderBar zentriert den Titel, ein Titel mit hexpand füllt
        // nur den Platz, der neben gleich breiten Rändern bleibt; [start]-Kinder erhalten
        // nur ihre natürliche Breite (Messung Verifier #399). Ohne Kinder links/rechts
        // reicht der Titel über die ganze Breite; die Fensterknöpfe stehen daher als
        // Gtk.WindowControls im Titel.
        title-widget: Box {
          hexpand: true;
          spacing: 6;

          Stack header_stack {
            hexpand: true;
            transition-type: over_left_right;
            transition-duration: 250;

            StackPage {
              name: "actions";

              child: Box {
                spacing: 6;

                Button compose_button {
                  icon-name: "mail-message-new-symbolic";
                  tooltip-text: _("Neue E-Mail");
                  action-name: "list.compose";

                  accessibility {
                    label: _("Neue E-Mail");
                  }
                }

                Separator compose_spacer {
                  styles [
                    "spacer",
                  ]
                }

                Button {
                  icon-name: "mail-reply-sender-symbolic";
                  tooltip-text: _("Antworten");

                  accessibility {
                    label: _("Antworten");
                  }
                }

                Button {
                  icon-name: "mail-reply-all-symbolic";
                  tooltip-text: _("Allen antworten");

                  accessibility {
                    label: _("Allen antworten");
                  }
                }

                Button {
                  icon-name: "mail-forward-symbolic";
                  tooltip-text: _("Weiterleiten");

                  accessibility {
                    label: _("Weiterleiten");
                  }
                }

                Box {
                  hexpand: true;
                }

                Button {
                  icon-name: "archive-symbolic";
                  tooltip-text: _("Archivieren");

                  accessibility {
                    label: _("Archivieren");
                  }
                }

                Button {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Löschen");

                  accessibility {
                    label: _("Löschen");
                  }
                }

                Button {
                  icon-name: "mail-mark-junk-symbolic";
                  tooltip-text: _("Als Spam markieren");

                  accessibility {
                    label: _("Als Spam markieren");
                  }
                }

                MenuButton {
                  icon-name: "folder-symbolic";
                  always-show-arrow: true;
                  tooltip-text: _("Verschieben");
                  menu-model: move_menu;

                  accessibility {
                    label: _("Verschieben");
                  }
                }

                ToggleButton {
                  icon-name: "starred-symbolic";
                  active: true;
                  tooltip-text: _("Markieren");

                  accessibility {
                    label: _("Markieren");
                  }
                }

                // Sekundärmenü der Nachricht (HIG Menus), bleibt neben dem Primärmenü.
                MenuButton {
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("Weitere Aktionen");
                  menu-model: message_menu;

                  accessibility {
                    label: _("Weitere Aktionen");
                  }
                }
              };
            }

            StackPage {
              name: "search";

              // Escape (GtkSearchEntry::stop-search) schließt die Suche.
              child: SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("E-Mails durchsuchen");
                // Tippen in der Liste startet die Suche (HIG-SE „type to search“, wie main).
                key-capture-widget: list_pane;
                search-started => $on_search_started() swapped;
                stop-search => $on_search_stop() swapped;

                accessibility {
                  label: _("E-Mails durchsuchen");
                }
              };
            }
          }

          ToggleButton search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Suchen");
            notify::active => $on_search_toggled() swapped;

            accessibility {
              label: _("Suchen");
            }
          }

          WindowControls {
            side: end;
          }
        };
      }

      // HIG-BN: Banner für einen anhaltenden Zustand (adw-banner.h:31-42).
      [top]
      Adw.Banner {
        title: _("Entfernte Inhalte gesperrt");
        button-label: _("Laden");
        revealed: true;
      }

      content: ScrolledWindow {
        hscrollbar-policy: never;

        // #399 Punkt 1: die Mail als Karte mit runden Ecken und Abstand zum Rand
        // (Stilklasse .card, libadwaita-Stylesheet).
        child: Box {
          orientation: vertical;
          valign: start;
          margin-start: 18;
          margin-end: 18;
          margin-top: 18;
          margin-bottom: 18;

          styles [
            "card",
          ]

          // Nachrichtenkopf, Vorlage stamp-message-header.blp:4-150.
          Grid {
            column-spacing: 12;
            row-spacing: 2;
            margin-start: 18;
            margin-end: 18;
            margin-top: 18;
            margin-bottom: 12;

            Adw.Avatar {
              size: 48;
              valign: start;
              show-initials: true;
              text: _("Jana Albrecht");

              layout {
                column: 0;
                row: 0;
                row-span: 3;
              }
            }

            Box {
              spacing: 6;

              layout {
                column: 1;
                row: 0;
              }

              Label {
                label: _("Jana Albrecht");
                hexpand: true;
                xalign: 0;
                ellipsize: end;
                selectable: true;

                styles [
                  "heading",
                ]
              }

              Image {
                icon-name: "inbox-symbolic";
                tooltip-text: _("Ordner");

                accessibility {
                  label: _("Ordner");
                }

                styles [
                  "dimmed",
                ]
              }

              Label {
                label: _("Eingang — Privat");

                styles [
                  "dimmed",
                ]
              }

              Label {
                label: _("Heute, 09:14");
                margin-start: 6;

                styles [
                  "numeric",
                  "dimmed",
                ]
              }
            }

            Label {
              label: _("Unterlagen für das Projekt Nordlicht");
              xalign: 0;
              wrap: true;
              selectable: true;

              layout {
                column: 1;
                row: 1;
              }

              styles [
                "title-4",
              ]
            }

            Box {
              spacing: 6;

              layout {
                column: 1;
                row: 2;
              }

              Label {
                label: _("An:");

                styles [
                  "dimmed",
                ]
              }

              Label {
                label: _("Lena Vogt");
                hexpand: true;
                xalign: 0;
                ellipsize: end;

                styles [
                  "dimmed",
                ]
              }

              Button {
                label: _("Details");
                tooltip-text: _("Alle Kopfzeilen anzeigen");
                valign: center;

                styles [
                  "flat",
                ]
              }
            }
          }

          Separator {}

          // Platzhalter für den Inhalt (WebKitGTK folgt in #354).
          Label {
            label: _("Hallo Lena,\n\nanbei die überarbeiteten Pläne für das Projekt Nordlicht und die aktuelle Kostenschätzung. Gegenüber dem letzten Stand haben sich vor allem die Positionen für die Fassade und die Außenanlagen geändert.\n\nKannst du bis Freitag einen Blick darauf werfen? Die Abstimmung mit dem Bauamt ist für nächste Woche angesetzt, und ich würde die Unterlagen gern vorher mit dir durchgehen.\n\nViele Grüße\nJana");
            xalign: 0;
            yalign: 0;
            wrap: true;
            selectable: true;
            margin-start: 18;
            margin-end: 18;
            margin-top: 18;
            margin-bottom: 18;
          }
        };
      };
    }

    // Ansichtsumschalter Mail/Kontakte/Kalender (Briefing 0, stamp-mail-view.blp:187-191).
    // #399 Punkt 2: schwebend (Abstand, Radius, Schatten, Kontur), Vorbild HIG „Overlaid Controls“.
    // Außen die Kontur im Akzent-Verlauf, innen eine fast deckende Fläche in der
    // Farbe der Seitenleiste (mail/style.css). Ohne .osd: das wäre auch im hellen
    // Modus ein dunkler Block (Sichtprüfung PM, #399).
    [switcher]
    Adw.Bin {
      valign: end;
      margin-start: 12;
      margin-end: 12;
      margin-top: 12;
      margin-bottom: 12;

      styles [
        "floating-switcher",
      ]

      child: Box {
        Adw.ViewSwitcher {
          policy: narrow;
          hexpand: true;
          margin-start: 6;
          margin-end: 6;
          margin-top: 9;
          margin-bottom: 6;
          stack: bind template.stack;
        }
      };
    }

    // Breit: Seitenleiste | Liste | Nachricht, Listenbreite ziehbar (stamp-mail-view.blp:57-96).
    // Schmal (≤ 1000 sp): dieselbe Ansicht, Seitenleiste eingeklappt als Überlagerung
    // (stamp-mail-view.blp:98-137), Werte per Breakpoint oben.
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 220;
        max-sidebar-width: 280;

        // #399: Umschalter unter der Ordnerliste statt darüber gelegt (Gtk.Overlay):
        // sonst scrollte die Tastatur (Pfeil/Ende) den markierten Ordner unter den
        // Umschalter (Review m-7). Flache untere Leiste ohne Hintergrund; „schwebend“
        // wirkt er über Abstand, Radius, Schatten und Kontur (mail/style.css).
        sidebar: Adw.ToolbarView {
          content: Adw.LayoutSlot {
            id: "sidebar";
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };

        content: Paned {
          position: 380;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Nachricht (stamp-mail-view.blp:139-185).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Mail");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.ToolbarView {
              content: Adw.LayoutSlot {
                id: "list";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "switcher";
              }
            };
          };
        }

        Adw.NavigationPage {
          title: _("Nachricht");
          tag: "message";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

menu filter_menu {
  section {
    item {
      label: _("Alle");
      action: "list.filter";
      target: "all";
    }

    item {
      label: _("Ungelesen");
      action: "list.filter";
      target: "unread";
    }

    item {
      label: _("Markiert");
      action: "list.filter";
      target: "starred";
    }

    item {
      label: _("Mit Anhang");
      action: "list.filter";
      target: "attachment";
    }
  }
}

menu move_menu {
  section {
    label: _("Privat");

    item {
      label: _("Archiv");
      action: "message.move";
      target: "privat/archiv";
    }

    item {
      label: _("Reisen");
      action: "message.move";
      target: "privat/reisen";
    }
  }
}

menu message_menu {
  section {
    item {
      label: _("Als ungelesen markieren");
      action: "message.mark-unread";
    }

    item {
      label: _("Drucken…");
      action: "message.print";
    }
  }
}

// #399 Punkt 3: Inhalt Platzhalter, Aktionen ohne Logik (mail-view.c).
menu primary_menu {
  section {
    item {
      label: _("_Einstellungen");
      action: "mail.preferences";
    }

    item {
      label: _("_Tastenkürzel");
      action: "mail.shortcuts";
    }

    item {
      label: _("_Info zu Revolution");
      action: "mail.about";
    }
  }
}
