                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }
                        }
                      }
                    }
                  };
                }

                // Firma: Name und Kollegen (Beispieldaten); Klick wählt den Kontakt in
                // der Liste (contacts-view.c, kein Dialog).
                Adw.ViewStackPage firm_page {
                  name: "firm";
                  title: _("Firma");

                  child: Box {
                    orientation: vertical;
                    spacing: 6;

                    Box {
                      spacing: 12;

                      styles [
                        "contact-card",
                        "contact-field",
                      ]

                      Image {
                        icon-name: "building-symbolic";
                        tooltip-text: _("Firma");

                        accessibility {
                          label: _("Firma");
                        }

                        styles [
                          "dimmed",
                        ]
                      }

                      Box {
                        orientation: vertical;
                        hexpand: true;

                        Label {
                          label: _("Geschäftsführerin");
                          xalign: 0;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Label firm_label {
                          label: _("Albrecht und Partner Architekten");
                          xalign: 0;
                          wrap: true;
                          selectable: true;
                        }
                      }
                    }

                    Label {
                      label: _("Kollegen");
                      xalign: 0;
                      margin-start: 12;
                      margin-top: 12;

                      styles [
                        "caption-heading",
                        "dimmed",
                      ]
                    }

                    // Zeilenname = Kontaktname, über den contacts-view.c den Eintrag wählt.
                    ListBox {
                      selection-mode: none;
                      row-activated => $on_colleague_activated() swapped;

                      accessibility {
                        label: _("Kollegen");
                      }

                      styles [
                        "contact-card",
                        "contact-colleagues",
                      ]

                      ListBoxRow {
                        name: "Anna Behrens";

                        child: Box {
                          spacing: 12;

                          Adw.Avatar {
                            size: 32;
                            show-initials: true;
                            accessible-role: presentation;
                            text: _("Anna Behrens");
                          }

                          Box {
                            orientation: vertical;
                            valign: center;
                            hexpand: true;

                            Label {
                              label: _("Anna Behrens");
                              xalign: 0;
                              ellipsize: end;
                            }

                            Label {
                              label: _("Projektleiterin");
                              xalign: 0;
                              ellipsize: end;

                              styles [
                                "caption",
                                "dimmed",
                              ]
                            }
                          }
                        };
                      }

                      ListBoxRow {
                        name: "Aylin Demir";

                        child: Box {
                          spacing: 12;

                          Adw.Avatar {
                            size: 32;
                            show-initials: true;
                            accessible-role: presentation;
                            text: _("Aylin Demir");
                          }

                          Box {
                            orientation: vertical;
                            valign: center;
                            hexpand: true;

                            Label {
                              label: _("Aylin Demir");
                              xalign: 0;
                              ellipsize: end;
                            }

                            Label {
                              label: _("Bauzeichnerin");
                              xalign: 0;
                              ellipsize: end;

                              styles [
                                "caption",
                                "dimmed",
                              ]
                            }
                          }
                        };
                      }
                    }
                  };
                }
              }
            };
          };
        }
      };
    }


    // Breit: Seitenleiste | Liste | Kontakt (stamp-contact-view.blp:57-96).
    // Schmal (≤ 1000 sp): Seitenleiste als Überlagerung, Werte per Breakpoint oben.
    // Klasse mail-split und schwebende Seitenleiste wie mail-view.blp (style.css).
    Adw.Layout {
      name: "desktop";

      content: Adw.OverlaySplitView split {
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 236;
        max-sidebar-width: 296;

        styles [
          "mail-split",
        ]

        sidebar: Adw.Bin {
          overflow: hidden;
          margin-start: 8;
          margin-end: 8;
          margin-top: 8;
          margin-bottom: 8;

          styles [
            "floating-sidebar",
          ]

          child: Adw.LayoutSlot {
            id: "sidebar";
          };
        };

        content: Paned {
          position: 320;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: Adw.LayoutSlot {
            id: "list";
          };

          end-child: Adw.LayoutSlot {
            id: "content";
          };
        };
      };
    }

    // Telefon: Liste → Kontakt (stamp-contact-view.blp:139-178).
    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView {
        Adw.NavigationPage {
          title: _("Kontakte");
          tag: "list";

          child: Adw.OverlaySplitView {
            collapsed: true;
            show-sidebar: bind split.show-sidebar bidirectional;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 260;
            max-sidebar-width: 320;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.LayoutSlot {
              id: "list";
            };
          };
        }

        Adw.NavigationPage {
          title: _("Kontakt");
          tag: "contact";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }
  };
}

// #402: Primärmenü wie mail-view.blp (Gruppen als Abschnitte, Kürzel rechts über
// das accel-Attribut). Erster Eintrag Neuer Kontakt statt Neue E-Mail, da Strg+N
// hier einen Kontakt anlegt (GNOME Contacts).
menu primary_menu {
  section {
    item {
      label: _("_Neuer Kontakt");
      action: "contact.new";
      accel: "<primary>n";
    }

    item {
      label: _("_Suchen");
      action: "contacts.search";
      accel: "<primary>f";
    }
  }

  // Ohne Haken wie mail-view.blp: zustandslose Aktion contacts.toggle-sidebar.
  section {
    item {
      label: _("Seiten_leiste ein-/ausblenden");
      action: "contacts.toggle-sidebar";
      accel: "F9";
    }
  }

  // Drei Themes (Arnd 22.10.2026, #340): Radio-Einträge der Aktion app.theme (main.c).
  section {
    label: _("Darstellung");

    item {
      label: _("_Hell");
      action: "app.theme";
      target: "hell";
    }

    item {
      label: _("Dunkel _mit hellem Inhalt");
      action: "app.theme";
      target: "dunkel-hell";
    }

    item {
      label: _("_Dunkel");
      action: "app.theme";
      target: "dunkel";
    }
  }

  section {
    item {
      label: _("_Einstellungen");
      action: "contacts.preferences";
      accel: "<primary>comma";
    }

    item {
      label: _("_Tastenkürzel");
      action: "contacts.shortcuts";
      accel: "<primary>question";
    }

    item {
      label: _("_Info zu Revolution");
      action: "contacts.about";
    }
  }
}

// #402 Punkt 6: Teilen (Platzhalter).
menu share_menu {
  section {
    item {
      label: _("Als _vCard teilen");
      action: "contact.share-vcard";
    }

    item {
      label: _("_QR-Code anzeigen");
      action: "contact.show-qr";
    }
  }
}
