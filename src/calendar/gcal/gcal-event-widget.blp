// Übernommen aus gnome-calendar 50.0 src/gui/gcal-event-widget.blp:1-80 (ff4d7f7d, GPL-3.0-or-later).
// Revolution #374 geändert: Titel in der Zeile (Monat, Ganztagsleiste) als Gtk.Label mit Ellipse statt
// GcalFadingLabel (Design kalender-monat-hell.png, PM 29.10.). #375: Woche/Tag ebenso (vertical_box).
using Gtk 4.0;
using Adw 1;

template $GcalEventWidget: Widget {
  focusable: true;
  overflow: hidden;
  receives-default: true;

  accessibility {
    has-popup: true;
  }

  DragSource drag_source {
    prepare => $on_drag_source_prepare_cb(template) not-swapped;
    begin => $on_drag_source_begin_cb(template) not-swapped;
  }

  GestureClick {
    pressed => $on_click_gesture_pressed_cb(template) not-swapped;
    released => $on_click_gesture_release_cb(template) not-swapped;
  }

  Adw.Bin edge {
    styles [
      "edge",
    ]
  }

  $GcalOverflowBin overflow_bin {
    hexpand: true;
    request-mode: width-for-height;

    styles [
      "content",
    ]

    // Revolution #375 (PM 29.10. aus Prüfung #374, Design kalender-woche-hell.png): Woche/Tag wie der Monat Titel
    // und Uhrzeit (dezent, rechts) in einer Zeile oben, Titel mit „…“ statt Uhrzeit über umbrochenem Titel
    // (Inscription, brach mitten im Wort um).
    Box vertical_box {
      orientation: vertical;

      Box {
        spacing: 4;

        Label {
          label: bind summary_label.label;
          xalign: 0.0;
          ellipsize: end;
        }

        Label {
          label: bind timestamp_label.label no-sync-create;
          visible: bind timestamp_label.visible;
          halign: end;
          hexpand: true;

          styles [
            "dimmed",
          ]
        }
      }
    }

    Box horizontal_box {
      spacing: 4;

      Label summary_label {
        xalign: 0.0;
        ellipsize: end;
      }

      Label timestamp_label {
        halign: end;
        hexpand: true;
        vexpand: true;

        styles [
          "dimmed",
        ]
      }
    }
  }
}
