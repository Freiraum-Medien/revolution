using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Revolution");
  default-width: 1200;
  default-height: 760;
  width-request: 360;
  height-request: 294;

  // Briefing 0: Strg+1/2/3 je Ansicht (Vorlage stamp-window.blp:11-25).
  // win.view: GPropertyAction auf app_stack.visible-child-name (main.c).
  ShortcutController {
    Shortcut {
      trigger: "<primary>1";
      action: "action(win.view)";
      arguments: "'mail'";
    }

    Shortcut {
      trigger: "<primary>2";
      action: "action(win.view)";
      arguments: "'contacts'";
    }

    Shortcut {
      trigger: "<primary>3";
      action: "action(win.view)";
      arguments: "'calendar'";
    }
  }

  // Briefing 0: AdwViewStack Mail/Kontakte/Kalender (stamp-window.blp:88-118).
  content: Adw.ViewStack app_stack {
    Adw.ViewStackPage {
      name: "mail";
      title: _("Mail");
      icon-name: "mail-unread-symbolic";

      child: $RevolutionMailView {
        stack: app_stack;
      };
    }

    // Kontakte: #338
    Adw.ViewStackPage {
      name: "contacts";
      title: _("Kontakte");
      icon-name: "system-users-symbolic";

      child: Adw.Bin {};
    }

    // Kalender: #339
    Adw.ViewStackPage {
      name: "calendar";
      title: _("Kalender");
      icon-name: "x-office-calendar-symbolic";

      child: Adw.Bin {};
    }
  };
}
