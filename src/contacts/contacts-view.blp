                          valign: start;
                          margin-top: 2;
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Re: Termin beim Bauamt");
                            xalign: 0;
                            ellipsize: end;
                          }

                          Label {
                            label: _("An Jana Albrecht · 16.10.26");
                            xalign: 0;
                            ellipsize: end;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }
                        }
                      }

                      Box {
                        spacing: 12;

                        Image {
                          icon-name: "mail-unread-symbolic";
                          valign: start;
                          margin-top: 2;
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
