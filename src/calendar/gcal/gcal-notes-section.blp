// Übernommen aus gnome-calendar 50.0 src/gui/event-editor/gcal-notes-section.blp:1-26 (ff4d7f7d, GPL-3.0-or-later). Revolution #375:
// Name für Barrierefreiheit „Notes“.
using Gtk 4.0;
using Adw 1;

template $GcalNotesSection: Adw.PreferencesRow {
  activatable: false;
  focusable: false;

  styles [
    "entry",
    "notes-section",
  ]

  Box {
    TextView notes_text {
      hexpand: true;
      top-margin: 6;
      bottom-margin: 6;
      left-margin: 6;
      right-margin: 6;
      sensitive: true;
      wrap-mode: word_char;
      accepts-tab: false;
      state-flags-changed => $on_notes_text_state_flags_changed_cb(template) not-swapped;

      accessibility {
        label: _("Notes");
      }
    }
  }
}
