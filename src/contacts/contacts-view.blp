                            xalign: 0;
                            ellipsize: end;
                          }

                          Label {
                            label: _("Von Jana Albrecht · 09.10.26");
                            xalign: 0;
                            ellipsize: end;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }
                        }
                      }
                    }

                    Label {
                      label: _("Gemeinsame Termine");
                      xalign: 0;
                      margin-start: 12;
                      margin-top: 12;

                      styles [
                        "caption-heading",
                        "dimmed",
                      ]
                    }

                    Box {
                      orientation: vertical;
                      spacing: 14;

                      styles [
                        "contact-card",
                        "contact-history",
                      ]

                      Box {
                        spacing: 12;

                        Image {
                          icon-name: "x-office-calendar-symbolic";
                          valign: start;
                          margin-top: 2;
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Review Fassadenpläne");
                            xalign: 0;
                            ellipsize: end;
                          }

                          Label {
                            label: _("Freitag, 23. Oktober, 16:00 – 17:30 · Videokonferenz");
                            xalign: 0;
                            ellipsize: end;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }
                        }
                      }

                      Box {
                        spacing: 12;

                        Image {
                          icon-name: "x-office-calendar-symbolic";
                          valign: start;
                          margin-top: 2;
                          accessible-role: presentation;

                          styles [
                            "dimmed",
                          ]
                        }

                        Box {
                          orientation: vertical;
                          hexpand: true;

                          Label {
                            label: _("Abstimmung Bauamt");
                            xalign: 0;
                            ellipsize: end;
                          }

                          Label {
                            label: _("Mittwoch, 21. Oktober, 09:00 – 10:30 · Bauamt Lindenau");
                            xalign: 0;
                            ellipsize: end;

                            styles [
                              "caption",
                              "dimmed",
                            ]
                          }
