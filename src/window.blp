using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Revolution");
  default-width: 1200;
  default-height: 760;
  width-request: 360;
  height-request: 294;

  // #401: Reihenfolge Mail | Kalender | Kontakte (Arnd, wie Outlook), Kürzel nach Position.
  // Briefing 0: Strg+1/2/3 je Ansicht (Vorlage stamp-window.blp:11-25).
  // win.view: GPropertyAction auf app_stack.visible-child-name (main.c).
  ShortcutController {
    Shortcut {
      trigger: "<primary>1";
      action: "action(win.view)";
      arguments: "'mail'";
    }

    Shortcut {
      trigger: "<primary>2";
      action: "action(win.view)";
      arguments: "'calendar'";
    }

    Shortcut {
      trigger: "<primary>3";
      action: "action(win.view)";
      arguments: "'contacts'";
    }
  }

  // #363: Undo-Hinweis (AdwToast) über allen Ansichten wie Stamp (stamp-mail-view.blp:28), mail-view.c
  // findet die Überlagerung über gtk_widget_get_ancestor (Muster stamp-message-list-item.c:466).
  content: Adw.ToastOverlay {
    // #345: Fehler-Banner jetzt im Inhaltsbereich der Mail-Ansicht (mail-view.blp).
    // Briefing 0: AdwViewStack Mail/Kontakte/Kalender (stamp-window.blp:88-118).
    child: Adw.ViewStack app_stack {
      Adw.ViewStackPage {
        name: "mail";
        title: _("Mail");
        icon-name: "mail-unread-symbolic";

        child: $RevolutionMailView mail_view {
          stack: app_stack;
        };
      }

      // Kalender: #339
      Adw.ViewStackPage {
        name: "calendar";
        title: _("Calendar");
        icon-name: "x-office-calendar-symbolic";

        child: $RevolutionCalendarView calendar_view {
          stack: app_stack;
        };
      }

      // Kontakte: #338
      Adw.ViewStackPage {
        name: "contacts";
        title: _("Contacts");
        icon-name: "system-users-symbolic";

        child: $RevolutionContactsView contacts_view {
          stack: app_stack;
        };
      }
    };
  };
}
